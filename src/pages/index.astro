---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import HomeDock from "../components/HomeDock.astro";
import BeliefNote from "../components/BeliefNote.astro";
import Folder from "../components/Folder.astro";
import GitHubContributions from "../components/GitHubContributions.astro";
import LocalTimeFooter from "../components/LocalTimeFooter.astro";
import MusicShowcase from "../components/MusicShowcase.astro";
import MemoryShowcase from "../components/MemoryShowcase.astro";
import ProjectsShowcase from "../components/ProjectsShowcase.astro";
import UsesGrid from "../components/UsesGrid.astro";
import WritingShowcase from "../components/WritingShowcase.astro";
import XBookmarksShowcase from "../components/XBookmarksShowcase.astro";
import { collections } from "../data/collections";
import { folderMusicTracks } from "../data/music";
---

<Layout surface="home">
  <Fragment slot="head">
    <script is:inline>
      let mode = "system";
      try {
        const saved = localStorage.getItem("home-theme");
        if (["system", "light", "dark"].includes(saved)) mode = saved;
      } catch {}
      document.documentElement.dataset.homeMode = mode;
      document.documentElement.dataset.homeTheme = mode === "system"
        ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
        : mode;
    </script>
    {
      folderMusicTracks.map(
        (track) =>
          track.previewUrl && (
            <link rel="preload" as="fetch" href={track.previewUrl} crossorigin="anonymous" />
          ),
      )
    }
  </Fragment>
  <main class="space-y-16 pt-20 pb-8">
    <About />
    <GitHubContributions />
    <div class="mx-auto grid w-[94%] grid-cols-2 gap-6">
      {collections.map((collection) => <Folder collection={collection} />)}
    </div>
    <BeliefNote />
    <LocalTimeFooter />
  </main>
  <HomeDock />
  <UsesGrid mode="overlay" />
  <ProjectsShowcase mode="overlay" />
  <MusicShowcase mode="overlay" />
  <MemoryShowcase mode="overlay" />
  <WritingShowcase mode="overlay" />
  <XBookmarksShowcase mode="overlay" />
</Layout>
