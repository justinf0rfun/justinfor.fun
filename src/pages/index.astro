---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import HomeDock from "../components/HomeDock.astro";
import HomeChat from "../components/HomeChat";
import HomeMoments from "../components/HomeMoments";
import HomeEmail from "../components/HomeEmail";
import HomeRideCoupon from "../components/HomeRideCoupon.astro";
import BeliefNote from "../components/BeliefNote.astro";
import Folder from "../components/Folder.astro";
import BooksFolder from "../components/BooksFolder.astro";
import BooksTransition from "../components/BooksTransition.astro";
import GitHubContributions from "../components/GitHubContributions.astro";
import EngineeringRadio from "../components/EngineeringRadio.astro";
import LocalTimeFooter from "../components/LocalTimeFooter.astro";
import MusicShowcase from "../components/MusicShowcase.astro";
import MemoryShowcase from "../components/MemoryShowcase.astro";
import ProjectsShowcase from "../components/ProjectsShowcase.astro";
import UsesGrid from "../components/UsesGrid.astro";
import WritingShowcase from "../components/WritingShowcase.astro";
import XBookmarksShowcase from "../components/XBookmarksShowcase.astro";
import { collections } from "../data/collections";
import { folderMusicTracks } from "../data/music";
---

<Layout surface="home">
  <Fragment slot="head">
    <BooksTransition target="home-books-cover" />
    <script is:inline>
      let mode = "system";
      try {
        const saved = localStorage.getItem("home-theme");
        if (["system", "light", "dark"].includes(saved)) mode = saved;
      } catch {}
      document.documentElement.dataset.homeMode = mode;
      document.documentElement.dataset.homeTheme = mode === "system"
        ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
        : mode;
    </script>
    {
      folderMusicTracks.map(
        (track) =>
          track.previewUrl && (
            <link rel="preload" as="fetch" href={track.previewUrl} crossorigin="anonymous" />
          ),
      )
    }
  </Fragment>
  <main class="home-content pt-20 pb-8">
    <div class="home-primary space-y-16">
      <About />
      <GitHubContributions />
      <div class="mx-auto grid w-[94%] grid-cols-2 gap-6">
        {collections.map((collection) => <Folder collection={collection} />)}
        <BooksFolder />
      </div>
    </div>
    <EngineeringRadio />
    <div class="home-tail space-y-16">
      <BeliefNote />
      <LocalTimeFooter showInspired />
    </div>
  </main>
  <HomeDock />
  <HomeChat client:load />
  <HomeMoments client:load />
  <HomeEmail client:load />
  <HomeRideCoupon />
  <UsesGrid mode="overlay" />
  <ProjectsShowcase mode="overlay" />
  <MusicShowcase mode="overlay" />
  <MemoryShowcase mode="overlay" />
  <WritingShowcase mode="overlay" />
  <XBookmarksShowcase mode="overlay" />
</Layout>

<style>
  .home-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem;
  }

  @media (width >= 75rem) {
    :global(body.home-surface) { max-width: 63rem; }
    .home-content {
      grid-template-columns: 36rem minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 4.5rem;
    }
    .home-primary { grid-area: 1 / 1; }
    .home-content > :global(.engineering-radio) {
      grid-area: 1 / 2 / 3;
      align-self: start;
      transition: opacity 180ms var(--ease-out), visibility 0s;
    }
    .home-tail { grid-area: 2 / 1; align-self: start; }
    :global(.home-surface:has(.home-chat[data-open="true"])) > .home-content { left: 0; }
    :global(.home-surface:has(.home-chat[data-open="true"])) > .home-content > :global(.engineering-radio) {
      opacity: 0;
      visibility: hidden;
      transition-delay: 0s, 180ms;
    }
    @media (prefers-reduced-motion: reduce) {
      .home-content > :global(.engineering-radio) { transition: none; }
    }
  }

  @media (75rem <= width < 87.5rem) {
    :global(.home-surface > .ride-coupon:not([data-expanded="true"])) {
      --ride-scale: .24;
      right: calc(8px - var(--ride-width) * (1 - var(--ride-scale)) / 2);
    }
  }
</style>
