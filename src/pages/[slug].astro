---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import MusicShowcase from "../components/MusicShowcase.astro";
import MemoryShowcase from "../components/MemoryShowcase.astro";
import ProjectsShowcase from "../components/ProjectsShowcase.astro";
import UsesGrid from "../components/UsesGrid.astro";
import XBookmarksShowcase from "../components/XBookmarksShowcase.astro";
import { collections } from "../data/collections";

export function getStaticPaths() {
  return collections.filter(({ slug }) => slug !== "writing").map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

const { collection } = Astro.props;
const isUses = collection.layout === "uses";
const isProjects = collection.layout === "projects";
const isMusic = collection.layout === "music";
const isMemory = collection.layout === "memory";
const isXBookmarks = collection.layout === "x-bookmarks";
---

<Layout title={`${collection.title} - Justin`} full surface={isProjects ? "projects" : undefined}>
  {
    isUses ? (
      <UsesGrid mode="standalone" />
    ) : isProjects ? (
      <ProjectsShowcase mode="standalone" />
    ) : isMusic ? (
      <MusicShowcase />
    ) : isMemory ? (
      <MemoryShowcase />
    ) : isXBookmarks ? (
      <XBookmarksShowcase mode="standalone" />
    ) : (
      <Carousel collection={collection} />
    )
  }
</Layout>
