---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import ProjectsShowcase from "../components/ProjectsShowcase.astro";
import UsesGrid from "../components/UsesGrid.astro";
import { collections } from "../data/collections";

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

const { collection } = Astro.props;
const isUses = collection.layout === "uses";
const isProjects = collection.layout === "projects";
---

<Layout title={`${collection.title} - Justin`} full surface={isProjects ? "projects" : undefined}>
  {
    isUses ? (
      <UsesGrid mode="standalone" />
    ) : isProjects ? (
      <ProjectsShowcase mode="standalone" />
    ) : (
      <Carousel collection={collection} />
    )
  }
</Layout>
