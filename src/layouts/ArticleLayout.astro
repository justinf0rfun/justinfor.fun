---
import { render, type CollectionEntry } from "astro:content";
import ParentLink from "../components/ParentLink.astro";
import ArticleActions from "../components/ArticleActions.astro";
import { articleMarkdown } from "../lib/article-sharing";
import ArticleToc from "../components/ArticleToc.astro";
import ArticleReadingCapsule from "../components/ArticleReadingCapsule.astro";
import LocalTimeFooter from "../components/LocalTimeFooter.astro";
import Layout from "./Layout.astro";

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const article = {
  title: post.data.title,
  description: post.data.description,
  url: new URL(`/thoughts/${post.id}`, Astro.site).href,
};
const markdown = articleMarkdown(article, post.body ?? "");
---

<Layout title={`${post.data.title} - Justin`} full>
  <Fragment slot="head">
    <link rel="canonical" href={article.url} />
    <meta property="og:url" content={article.url} />
    <meta property="og:title" content={article.title} />
    <meta property="og:description" content={article.description} />
    <meta name="description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
  </Fragment>

  <ParentLink class="article-parent" label="Thoughts" href="/thoughts" />

  <ArticleToc headings={headings} />
  <ArticleReadingCapsule headings={headings} />

  <main class="article-shell">
    <article class="article-prose">
      <header id="article-top">
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
      </header>
      <Content />
    </article>
    <ArticleActions article={article} markdown={markdown} />
    <LocalTimeFooter />
  </main>
</Layout>

<style is:global>
  html {
    scroll-behavior: smooth;
    scrollbar-gutter: stable;
  }

  html:has([data-article-share][open]) {
    overflow: hidden;
  }

  .article-parent { margin: 2.5rem 1rem 0; }

  .article-shell {
    width: min(100% - 3rem, 43.25rem);
    margin-inline: auto;
    padding-block: 4rem 8rem;
  }

  .article-prose {
    color: #424242;
    font-size: 1rem;
    line-height: 1.625;
  }

  .article-prose > header {
    margin-bottom: 2rem;
  }

  .article-prose > header h1 {
    color: #202020;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.333;
    letter-spacing: -0.02em;
  }

  .article-prose > header p {
    margin-top: 0.5rem;
    color: #646464;
  }

  .article-prose > p {
    margin-bottom: 1rem;
  }

  .article-prose > h2 {
    scroll-margin-top: 5rem;
    margin-top: 4rem;
    margin-bottom: 0.5rem;
    color: #202020;
    font-weight: 550;
  }

  .article-prose > h3 {
    scroll-margin-top: 5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    color: #202020;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .article-prose a {
    color: #202020;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: #d9d9d9;
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms ease-out;
  }

  .article-prose strong {
    color: #202020;
    font-weight: 600;
  }

  .article-prose code {
    padding: 0.12rem 0.3rem;
    border-radius: 0.3rem;
    color: #202020;
    background: #f0f0f0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875em;
  }

  .article-prose > .article-note {
    position: relative;
    margin-block: 1.5rem 1.75rem;
    padding-inline-start: 3rem;
    color: #717171;
    font-size: .9375rem;
    line-height: 1.62;
    overflow-wrap: anywhere;
  }

  .article-note::before {
    position: absolute;
    inset-block-start: -.36rem;
    inset-inline-start: -.3rem;
    width: 2.75rem;
    height: 2.75rem;
    background: url("/justin-avatar.png") center / 3.2rem no-repeat;
    content: "";
  }

  .article-note > * + * { margin-block-start: .55rem; }

  .article-prose .article-note :is(a, strong, code) { color: #5f5f5f; }

  .article-note > .article-note-label {
    color: #4c4c4c;
    font: 600 .72rem/1.35 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .article-note-label + p { margin-block-start: .36rem; }

  @media (hover: hover) and (pointer: fine) {

    .article-prose a:hover {
      text-decoration-color: #747474;
    }
  }

  @media (min-width: 80rem) {
    .article-parent {
      position: fixed;
      top: 4.5rem;
      left: 2rem;
      margin: 0;
    }

    .article-shell {
      padding-block: 6rem 10rem;
    }

    .article-prose:has(> .article-note) { display: flow-root; }

    .article-prose > .article-note {
      --note-width: 13.5rem;
      --note-gap: 2rem;
      float: right;
      clear: right;
      width: var(--note-width);
      margin-block: .15rem 1rem;
      margin-inline-end: calc(0px - var(--note-width) - var(--note-gap));
      padding-inline-start: 2.4rem;
      font-size: .875rem;
    }

    .article-note::before {
      width: 2.4rem;
      height: 2.4rem;
      background-size: 2.8rem;
    }
  }

  @media (max-width: 40rem) {
    .article-parent {
      margin-top: 1rem;
    }

    .article-shell {
      width: min(100% - 2rem, 43.25rem);
      padding-block: 3rem 6rem;
    }
  }
  @media (max-width: 47.999rem) {
    .article-shell { padding-top: 3rem; }
    .article-prose > header, .article-prose > h2, .article-prose > h3 { scroll-margin-top: calc(env(safe-area-inset-top) + 6rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
