---
import { render, type CollectionEntry } from "astro:content";
import ParentLink from "../components/ParentLink.astro";
import ArticleActions from "../components/ArticleActions.astro";
import { articleMarkdown } from "../lib/article-sharing";
import ArticleToc from "../components/ArticleToc.astro";
import LocalTimeFooter from "../components/LocalTimeFooter.astro";
import Layout from "./Layout.astro";

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const article = {
  title: post.data.title,
  description: post.data.description,
  url: new URL(`/thoughts/${post.id}`, Astro.site).href,
};
const markdown = articleMarkdown(article, post.body ?? "");
---

<Layout title={`${post.data.title} - Justin`} full>
  <Fragment slot="head">
    <link rel="canonical" href={article.url} />
    <meta property="og:url" content={article.url} />
    <meta property="og:title" content={article.title} />
    <meta property="og:description" content={article.description} />
    <meta name="description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
  </Fragment>

  <ParentLink class="article-parent" label="Thoughts" href="/thoughts" />

  <ArticleToc headings={headings} />

  <main class="article-shell">
    <article class="article-prose">
      <header>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
      </header>
      <Content />
    </article>
    <ArticleActions article={article} markdown={markdown} />
    <LocalTimeFooter />
  </main>
</Layout>

<style is:global>
  html {
    scroll-behavior: smooth;
    scrollbar-gutter: stable;
  }

  html:has([data-article-share][open]) {
    overflow: hidden;
  }

  .article-parent { margin: 2.5rem 1rem 0; }

  .article-shell {
    width: min(100% - 3rem, 43.25rem);
    margin-inline: auto;
    padding-block: 4rem 8rem;
  }

  .article-prose {
    color: #424242;
    font-size: 1rem;
    line-height: 1.625;
  }

  .article-prose > header {
    margin-bottom: 2rem;
  }

  .article-prose > header h1 {
    color: #202020;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.333;
    letter-spacing: -0.02em;
  }

  .article-prose > header p {
    margin-top: 0.5rem;
    color: #646464;
  }

  .article-prose > p {
    margin-bottom: 1rem;
  }

  .article-prose > h2 {
    scroll-margin-top: 5rem;
    margin-top: 4rem;
    margin-bottom: 0.5rem;
    color: #202020;
    font-weight: 550;
  }

  .article-prose > h3 {
    scroll-margin-top: 5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    color: #202020;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .article-prose a {
    color: #202020;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: #d9d9d9;
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms ease-out;
  }

  .article-prose strong {
    color: #202020;
    font-weight: 600;
  }

  .article-prose code {
    padding: 0.12rem 0.3rem;
    border-radius: 0.3rem;
    color: #202020;
    background: #f0f0f0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875em;
  }

  @media (hover: hover) and (pointer: fine) {

    .article-prose a:hover {
      text-decoration-color: #747474;
    }
  }

  @media (min-width: 80rem) {
    .article-parent {
      position: fixed;
      top: 4.5rem;
      left: 2rem;
      margin: 0;
    }

    .article-shell {
      padding-block: 6rem 10rem;
    }
  }

  @media (max-width: 40rem) {
    .article-parent {
      margin-top: 1rem;
    }

    .article-shell {
      width: min(100% - 2rem, 43.25rem);
      padding-block: 3rem 6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
