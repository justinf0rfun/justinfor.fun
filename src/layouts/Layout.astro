---
import "../styles/global.css";

interface Props {
  title?: string;
  /** Drops the column and chrome, for pages that own the whole viewport. */
  full?: boolean;
  surface?: "projects";
}

const { title = "Justin", full = false, surface } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/justin-avatar.png" />
    <meta property="og:site_name" content="Justin" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class:list={[!full && "max-w-xl mx-auto px-4 md:px-0", "bg-neutral-50"]}>
    {
      surface === "projects" && (
        <Fragment set:html={`<!-- THESIS: Real shipped interfaces lead; this surface refuses the centered carousel and utility-card grid. OWN-WORLD: Keep the incumbent neutral canvas, restrained type, and soft physical depth; project color lives inside official imagery and small status cues. STORY: Two shipped projects move from precise status to verified scope, then to the live product. FIRST VIEWPORT: Projects, 2 shipped projects, and the Huoban editorial row. FORM: User-locked alternating case-study-lite layout. Seed: projects-editorial-20260808. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->`} />
      )
    }
    <slot />
  </body>
</html>
