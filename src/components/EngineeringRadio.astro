---
import { engineeringSources } from "../lib/engineering-blogs.mjs";
const positions = ["All stations", ...engineeringSources.map(({ name }) => name)];
const wave = [4, 7, 5, 10, 14, 7, 12, 16, 9, 12, 6, 9, 4];
---

<dialog class="engineering-radio" id="engineering-blogs" data-engineering-radio data-view="guide" aria-labelledby="engineering-title">
  <div class="engineering-receiver">
    <div class="engineering-slot" aria-hidden="true"></div>
    <div class="engineering-face">
      <div class="engineering-display">
        <header class="engineering-header">
          <h2 id="engineering-title" tabindex="-1" autofocus>Engineering Radio</h2>
          <p class="engineering-status" role="status">
            <i aria-hidden="true"></i><span data-engineering-status>Tuning…</span><span class="engineering-seeking" aria-hidden="true">Tuning…</span>
          </p>
        </header>
        <div class="engineering-band" aria-hidden="true">
          <div class="engineering-frequency"><i></i></div>
          <div class="engineering-wave" data-engineering-wave>
            {wave.map((height, index) => (
              <i style={{ "--wave-height": `${height}px`, "--wave-delay": `${-index * 39}ms` }}></i>
            ))}
          </div>
        </div>
        <div class="engineering-station">
          <p class="engineering-readout" aria-live="polite" aria-atomic="true">
            <span class="engineering-readout-channel" data-engineering-channel hidden></span>
            <span data-engineering-readout>All stations</span>
          </p>
          <button type="button" class="engineering-reset" data-engineering-reset aria-label="All stations" title="All stations" hidden>
            <span aria-hidden="true">↶</span>
          </button>
        </div>
      </div>
      <div class="engineering-dial" data-engineering-dial role="slider" tabindex="0" aria-label="Radio channel"
        aria-describedby="engineering-dial-help" aria-valuemin="0" aria-valuemax={positions.length - 1}
        aria-valuenow="0" aria-valuetext="All stations">
        {positions.map((name, index) => (
          <span class="engineering-tick" data-engineering-tick={index} data-current={index === 0 ? "" : undefined}
            style={{ "--tick-angle": `${index * 270 / (positions.length - 1) - 135}deg` }} aria-hidden="true" title={name}></span>
        ))}
        <span class="engineering-knob" aria-hidden="true"><i></i></span>
      </div>
      <p class="sr-only" id="engineering-dial-help">Turn the dial or use arrow keys to tune. Press the center or Home to return to all stations.</p>
      <button type="button" class="engineering-close" data-engineering-close aria-label="Close Engineering Radio">
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>

  <div class="engineering-output" data-engineering-output inert>
    <div class="engineering-terminal">
      <div class="engineering-feed" data-engineering-scroll>
        <div class="engineering-paper" data-engineering-paper>
          <h3 class="engineering-paper-heading" tabindex="-1">
            <span class="engineering-prompt-sign" aria-hidden="true">radio&gt;</span>
            <span class="engineering-command-output" data-engineering-command-output aria-hidden="true">stations</span>
            <span class="sr-only" data-engineering-paper-channel hidden></span>
            <span class="engineering-terminal-context" data-engineering-paper-heading>Station guide</span>
          </h3>
          <ol id="engineering-articles" data-engineering-items>
            <li class="engineering-empty">Articles are temporarily unavailable.</li>
          </ol>
          <p class="engineering-empty" data-engineering-empty hidden></p>
          <button type="button" class="engineering-more" data-engineering-more aria-controls="engineering-articles" aria-expanded="false" hidden>More articles <span aria-hidden="true">↓</span></button>
        </div>
      </div>
      <form class="engineering-prompt" data-engineering-command-form>
        <p class="engineering-command-feedback" data-engineering-command-feedback role="status" hidden></p>
        <label class="engineering-prompt-sign" for="engineering-command"><span aria-hidden="true">radio&gt;</span><span class="sr-only">Radio command</span></label>
        <input id="engineering-command" data-engineering-command type="text" autocomplete="off"
          autocapitalize="off" spellcheck="false" enterkeyhint="go" maxlength="32" placeholder="tune 04" />
        <button class="engineering-command-run" type="submit" aria-label="Run command" title="Run command"><span aria-hidden="true">↵</span></button>
      </form>
    </div>
  </div>
</dialog>

<script>
  import { mountEngineeringRadio } from "../scripts/engineering-radio";
  const radio = document.querySelector<HTMLDialogElement>("[data-engineering-radio]");
  if (radio) mountEngineeringRadio(radio);
</script>

<style is:global>
  html:has(.engineering-radio[open]) { overflow: hidden; }
  .home-surface:has(.engineering-radio[open]) .home-news { visibility: hidden; }

  .engineering-radio {
    --radio-safe-top: max(1rem, env(safe-area-inset-top));
    --radio-bottom: calc(6.5rem + env(safe-area-inset-bottom));
    --radio-metal-light: #ecece8;
    --radio-metal: #b9b9b5;
    --radio-case-ink: #383935;
    --radio-screen: #151312;
    --radio-ink: #f0e8e2;
    --radio-muted: #a79c93;
    --radio-line: #3b302a;
    --radio-accent: #a63809;
    --radio-signal: #ff5800;
    --radio-signal-glow: color-mix(in srgb, var(--radio-signal) 45%, transparent);
    --radio-scale-tick: color-mix(in srgb, var(--radio-signal) 30%, transparent);
    --radio-ring: #90918d;
    --radio-knob: #c4c6c3;
    position: fixed;
    inset: auto 0 var(--radio-bottom);
    width: min(35rem, calc(100% - 1.5rem));
    height: max-content;
    max-width: none;
    max-height: calc(100dvh - var(--radio-safe-top) - var(--radio-bottom));
    margin: 0 auto;
    overflow: visible;
    padding: 0;
    background: transparent;
    color: var(--radio-ink);
    isolation: isolate;
  }

  @supports (color: color(display-p3 0 0 0)) {
    .engineering-radio { --radio-signal: color(display-p3 .99 .4 .02); }
  }

  html[data-home-theme="dark"] .engineering-radio {
    --radio-metal-light: #464744;
    --radio-metal: #2a2c2a;
    --radio-case-ink: #e2e2dc;
    --radio-accent: var(--radio-signal);
    --radio-ring: #686966;
    --radio-knob: #858784;
  }

  .engineering-radio[open] {
    display: flex;
    flex-direction: column;
    animation: engineering-wake 230ms var(--ease-out) both;
  }
  .engineering-radio:focus { outline: none; }
  .engineering-radio::backdrop { background: rgb(24 21 17 / .33); }
  .engineering-radio[open]::backdrop { animation: engineering-backdrop 190ms ease-out both; }
  html[data-home-theme="dark"] .engineering-radio::backdrop { background: rgb(0 0 0 / .58); }
  .engineering-radio [hidden] { display: none; }
  @keyframes engineering-wake {
    from { translate: 0 22px; scale: .97; opacity: 0; }
  }
  @keyframes engineering-backdrop { from { opacity: 0; } }

  .engineering-receiver {
    position: relative;
    z-index: 1;
    flex: none;
    padding: .57rem .98rem .67rem;
    border-radius: .95rem;
    background:
      repeating-linear-gradient(90deg, transparent 0 1px, rgb(31 32 31 / .021) 1px 2px),
      linear-gradient(119deg, rgb(255 255 255 / .2), transparent 57%),
      linear-gradient(170deg, var(--radio-metal-light), var(--radio-metal));
    color: var(--radio-case-ink);
    box-shadow: inset 0 1px rgb(255 255 255 / .5), inset 0 -1px rgb(27 31 30 / .34),
      0 12px 27px -10px rgb(20 23 22 / .58);
  }
  .engineering-receiver::before {
    position: absolute;
    inset: auto .55rem calc(100% - 1px) auto;
    width: 1.9rem;
    height: 2px;
    border-radius: 4px;
    background: linear-gradient(0deg, #6a6a65, #dedfd9 62%, #a0a09b);
    box-shadow: 0 1px 3px rgb(22 23 20 / .25);
    transform: rotate(76deg);
    transform-origin: right center;
    content: "";
  }
  .engineering-radio[open] .engineering-receiver::before { animation: engineering-aerial 300ms var(--ease-out) both; }
  @keyframes engineering-aerial { from { transform: rotate(33deg) scaleX(.6); } }
  .engineering-header {
    display: flex;
    align-items: center;
    gap: .3rem;
    justify-content: space-between;
  }
  .engineering-header h2 {
    margin: 0;
    color: var(--radio-ink);
    font-size: .8125rem;
    line-height: 1.25;
    font-weight: 620;
    letter-spacing: -.016em;
    white-space: nowrap;
  }
  .engineering-header h2:focus { outline: none; }
  .engineering-close {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: -.35rem;
    border-radius: 50%;
    color: inherit;
    font: 400 1.16rem/1 ui-sans-serif, system-ui, sans-serif;
    cursor: pointer;
  }
  .engineering-close:hover { background: rgb(100 88 64 / .1); }
  .engineering-close:active { scale: .95; }

  .engineering-face {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(.28rem, 2vw, .76rem);
  }
  .engineering-display {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1rem auto;
    align-items: center;
    min-width: 0;
    padding: .56rem .72rem .29rem;
    border-radius: .44rem;
    background: var(--radio-screen);
    color: var(--radio-ink);
    box-shadow: inset 0 1px 4px rgb(11 15 13 / .69), 0 1px rgb(255 255 255 / .35);
  }
  .engineering-status {
    position: relative;
    display: flex;
    align-items: center;
    gap: .37rem;
    margin: 0;
    color: var(--radio-muted);
    font: 520 .57rem/1.3 ui-monospace, SFMono-Regular, Consolas, monospace;
    letter-spacing: .038em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .engineering-status i {
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--radio-scale-tick);
  }
  .engineering-radio[data-has-signal][data-phase="tuned"]:not([data-searching]) .engineering-status { color: var(--radio-signal); }
  .engineering-radio[data-has-signal][data-phase="tuned"]:not([data-searching]) .engineering-status i {
    background: var(--radio-signal);
    box-shadow: 0 0 .44rem var(--radio-signal-glow);
  }
  .engineering-seeking { display: none; }
  .engineering-radio[data-searching] .engineering-seeking { display: inline; }
  .engineering-radio[data-searching] [data-engineering-status] { position: absolute; clip-path: inset(50%); }

  .engineering-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: .55rem;
  }
  .engineering-frequency {
    position: relative;
    height: .62rem;
    margin-inline: 1px;
    background: repeating-linear-gradient(to right, var(--radio-scale-tick) 0 1px, transparent 1px 12.5%) center bottom / 100% .24rem no-repeat;
    border-inline-end: 1px solid transparent;
  }
  .engineering-frequency::after {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 1px;
    height: .24rem;
    background: var(--radio-scale-tick);
    content: "";
  }
  .engineering-frequency i {
    position: absolute;
    z-index: 1;
    inset-block: 0;
    left: var(--radio-frequency, 0%);
    width: 1.5px;
    background: var(--radio-signal);
    box-shadow: 0 0 6px var(--radio-signal-glow);
    transition: left 205ms var(--ease-out);
  }
  .engineering-radio[data-searching] .engineering-frequency i { transition-duration: 72ms; }
  .engineering-wave { display: flex; align-items: center; gap: clamp(1.5px, .3vw, 2.75px); height: 1rem; color: var(--radio-signal); opacity: .62; }
  .engineering-wave i {
    width: clamp(1.5px, .16vw, 2px);
    height: var(--wave-height);
    border-radius: 1px;
    background: currentColor;
    transform: scaleY(.21);
    transition: transform 160ms var(--ease-out);
  }
  .engineering-radio:is([data-searching], [data-phase="connecting"]) .engineering-wave { opacity: .92; }
  .engineering-radio:is([data-searching], [data-phase="connecting"]) .engineering-wave i {
    animation: engineering-wave 305ms var(--wave-delay) ease-in-out infinite;
  }
  @keyframes engineering-wave {
    0%, 100% { transform: scaleY(.23); }
    30% { transform: scaleY(calc(.19 + var(--radio-wave-level, .75) * .79)); }
    60% { transform: scaleY(calc(.21 + var(--radio-wave-level, .75) * .27)); }
    80% { transform: scaleY(calc(.2 + var(--radio-wave-level, .75) * .52)); }
  }
  .engineering-radio[data-phase="connecting"] .engineering-frequency i {
    animation: engineering-sweep var(--radio-connect-time) cubic-bezier(.55,.1,.25,1) both;
  }
  .engineering-radio:is([data-searching], [data-phase="connecting"]) .engineering-status i {
    animation: engineering-search var(--radio-connect-time) alternate ease-out both;
  }
  @keyframes engineering-sweep {
    0% { left: 4%; opacity: .4; }
    40% { left: 92%; opacity: 1; }
    68% { left: 26%; }
    100% { left: var(--radio-frequency, 0%); opacity: 1; }
  }
  @keyframes engineering-search {
    36%, 75% { background: var(--radio-signal); box-shadow: 0 0 .45rem var(--radio-signal-glow); }
    58%, 85% { background: var(--radio-scale-tick); }
  }
  .engineering-station { display: flex; align-items: center; height: 1.65rem; }
  .engineering-readout {
    display: flex;
    align-items: baseline;
    gap: .45rem;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font: 610 .75rem/1.3 ui-monospace, SFMono-Regular, Consolas, monospace;
  }
  .engineering-readout > span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .engineering-readout > [data-engineering-readout] { min-width: 0; }
  .engineering-readout-channel { flex: none; color: var(--radio-signal); }
  .engineering-reset {
    flex: none;
    align-self: center;
    width: 1.75rem;
    height: 1.65rem;
    color: var(--radio-muted);
    border-radius: .25rem;
    font: 1.05rem/1 system-ui, sans-serif;
    cursor: pointer;
  }
  .engineering-reset:hover { background: color-mix(in srgb, var(--radio-signal) 9%, transparent); }
  .engineering-radio[data-phase="connecting"] :is(.engineering-readout, .engineering-reset) { opacity: .55; }

  .engineering-dial {
    --dial-angle: -135deg;
    --dial-size: clamp(3.625rem, 15vw, 4.125rem);
    position: relative;
    display: grid;
    place-items: center;
    width: var(--dial-size);
    aspect-ratio: 1;
    border-radius: 50%;
    touch-action: none;
    user-select: none;
    cursor: grab;
  }
  .engineering-dial[data-dragging] { cursor: grabbing; }
  .engineering-tick {
    position: absolute;
    top: calc(50% - 2px);
    left: calc(50% - .5px);
    width: 1px;
    height: 4px;
    border-radius: 1px;
    background: var(--radio-case-ink);
    opacity: .42;
    transform: rotate(var(--tick-angle)) translateY(calc(.19rem - var(--dial-size) * .5));
  }
  .engineering-tick[data-current] { background: var(--radio-accent); opacity: 1; }
  .engineering-knob {
    position: relative;
    width: calc(var(--dial-size) - .94rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(from 45deg, #fcfcf26b, #292c2a50 24%, #ecece541 49%, #25282548 74%, #fcfcf26b), var(--radio-ring);
    box-shadow: inset 0 1px rgb(255 255 255 / .75), inset 0 -1px rgb(26 28 27 / .39),
      0 2px 3px rgb(17 18 16 / .25), 0 6px 10px -4px rgb(17 18 16 / .37);
    transform: rotate(var(--dial-angle));
    transition: transform 240ms var(--ease-out), scale 150ms var(--ease-out);
  }
  .engineering-knob::before {
    position: absolute;
    inset: 6%;
    border-radius: inherit;
    background: linear-gradient(145deg, rgb(255 255 255 / .4), transparent 70%),
      repeating-linear-gradient(115deg, transparent 0 1px, rgb(30 32 30 / .035) 1px 2px), var(--radio-knob);
    box-shadow: inset 0 1px rgb(255 255 255 / .21), 0 0 0 .5px rgb(25 28 25 / .16);
    content: "";
  }
  .engineering-knob i {
    position: absolute;
    top: .3rem;
    left: calc(50% - 1px);
    width: 2px;
    height: 7px;
    border-radius: 2px;
    background: var(--radio-accent);
    box-shadow: inset 0 1px var(--radio-signal-glow);
  }
  .engineering-dial[data-dragging] .engineering-knob { scale: .96; transition-duration: 65ms; }

  .engineering-slot {
    height: .26rem;
    margin-block-end: .53rem;
    margin-inline: .5rem;
    border-radius: 2px;
    background: linear-gradient(#2d302d, #5f605a);
    box-shadow: inset 0 1px 2px #292b28, 0 1px rgb(255 255 255 / .42);
  }
  .engineering-output {
    order: -1;
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    min-height: 0;
    margin: 0 1.48rem -.84rem;
    border-radius: .55rem .55rem 0 0;
    opacity: 0;
    transform: translateY(10px);
    transition: grid-template-rows 330ms var(--ease-out), opacity 210ms var(--ease-out), transform 330ms var(--ease-out);
  }
  .engineering-radio[data-phase="tuned"] .engineering-output {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
    transform: translateY(0);
    box-shadow: 0 22px 48px -19px rgb(12 16 12 / .53);
  }
  .engineering-terminal {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
    overflow: hidden;
    border-radius: inherit;
    background: var(--radio-screen);
    color-scheme: dark;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }
  .engineering-feed {
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background:
      repeating-linear-gradient(transparent 0 3px, rgb(13 9 7 / .13) 3px 4px),
      linear-gradient(155deg, color-mix(in srgb, var(--radio-signal) 4.5%, transparent), transparent 48%),
      var(--radio-screen);
    box-shadow: inset 0 1px color-mix(in srgb, var(--radio-signal) 12%, transparent);
    scrollbar-width: thin;
    scrollbar-color: #64544a transparent;
  }
  .engineering-paper {
    padding: .8rem clamp(.8rem, 3vw, 1.25rem) .6rem;
  }
  .engineering-paper-heading {
    display: flex;
    align-items: baseline;
    gap: .55rem;
    margin: 0;
    padding-block-end: .65rem;
    border-block-end: 1px dashed var(--radio-line);
    font-size: .825rem;
    line-height: 1.45;
    font-weight: 600;
  }
  .engineering-paper-heading:focus { outline: none; }
  .engineering-prompt-sign {
    flex: none;
    color: var(--radio-signal);
    font-weight: 620;
  }
  .engineering-command-output { flex: none; }
  .engineering-terminal-context {
    min-width: 0;
    overflow: hidden;
    margin-inline-start: auto;
    color: var(--radio-muted);
    font-size: .72rem;
    font-weight: 400;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .engineering-radio:not([data-view="station"]) .engineering-terminal-context {
    position: absolute;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
  }
  .engineering-feed ol { margin: 0; padding: 0; list-style: none; }
  .engineering-article {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: .45rem;
    padding: .68rem 0 .25rem;
  }
  .engineering-channel {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    align-self: start;
    min-height: 2.75rem;
    padding-block-start: .07rem;
    gap: .05rem;
    color: var(--radio-muted);
    font-size: .77rem;
    line-height: 1.45;
    font-weight: 550;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .engineering-channel::before { content: "["; }
  .engineering-channel::after { content: "]"; }
  .engineering-channel:is(:hover, :focus-visible) { color: var(--radio-signal); text-decoration: underline; text-underline-offset: .22em; }
  .engineering-channel:active { opacity: .65; }
  .engineering-program { position: relative; display: grid; gap: .2rem; min-width: 0; }
  .engineering-byline {
    display: flex;
    align-items: baseline;
    column-gap: .58rem;
    min-width: 0;
    color: var(--radio-muted);
    font-size: .7rem;
    line-height: 1.45;
  }
  .engineering-source { min-width: 0; overflow-wrap: anywhere; }
  .engineering-byline time { flex: none; margin-inline-start: auto; white-space: nowrap; }
  .engineering-article-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: .65rem;
    color: inherit;
    font-size: .875rem;
    font-weight: 600;
    line-height: 1.44;
    text-decoration: none;
  }
  .engineering-article-link::after { position: absolute; inset: 0; content: ""; }
  .engineering-article-link > :first-child { overflow-wrap: anywhere; }
  .engineering-outbound { color: var(--radio-muted); transition: transform 150ms var(--ease-out); }
  .engineering-radio[data-view="station"] .engineering-article { grid-template-columns: minmax(0, 1fr); padding-block: .62rem; }
  .engineering-radio[data-view="station"] :is(.engineering-channel, .engineering-source) { display: none; }
  .engineering-radio[data-view="station"] [data-engineering-latest] { padding-block: .92rem 1.02rem; }
  .engineering-radio[data-view="station"] [data-engineering-latest] .engineering-article-link {
    font-size: .97rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .engineering-article-link:hover .engineering-outbound { color: var(--radio-signal); transform: translate(2px, -2px); }
  }
  .engineering-more {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 2.75rem;
    color: var(--radio-muted);
    font-size: .75rem;
    line-height: 1.35;
    cursor: pointer;
  }
  .engineering-more:hover { color: var(--radio-signal); }
  .engineering-more[aria-expanded="true"] > span { rotate: 180deg; }
  .engineering-empty { padding-block: .85rem; color: var(--radio-muted); font-size: .875rem; }
  .engineering-prompt {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: .55rem;
    padding-inline: clamp(.8rem, 3vw, 1.25rem) .3rem;
    padding-block-end: .84rem;
    border-block-start: 1px solid var(--radio-line);
    background: #100e0d;
    font-size: .825rem;
  }
  .engineering-prompt:focus-within { box-shadow: inset 2px 0 var(--radio-signal); }
  .engineering-prompt input {
    min-width: 0;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    outline: none;
    color: var(--radio-ink);
    background: none;
    caret-color: var(--radio-signal);
    font: inherit;
  }
  .engineering-prompt input::placeholder { color: var(--radio-muted); }
  .engineering-command-feedback {
    grid-column: 1 / -1;
