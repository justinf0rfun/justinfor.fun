---
import { inspirations } from "../data/inspirations";
---

<div id="inspired-credits" popover="manual" data-view="list" data-side="bottom">
  <button class="inspired-scrim" data-inspired-close aria-label="Close credits" tabindex="-1"></button>
  <svg class="inspired-thread" aria-hidden="true"><path pathLength="1" /><circle r="3" /></svg>
  <div class="inspired-outline" aria-hidden="true"></div>
  <section class="inspired-panel" role="dialog" aria-labelledby="inspired-title" tabindex="-1" lang="en">
    <header class="inspired-header">
      <div><h2 id="inspired-title"><span aria-hidden="true">※</span> Inspired & Credits</h2><p>Ideas borrowed, sources credited. Pick one to find its place here.</p></div>
      <button class="inspired-close" data-inspired-close aria-label="Close credits">×</button>
    </header>
    <div class="inspired-sources">
      {inspirations.map((source, index) => (
        <article class="inspired-source" data-source={source.id}>
          <button class="inspired-pick" data-inspired-pick={source.id} aria-expanded="false" aria-controls={`inspired-${source.id}`}>
            <span class="inspired-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span><strong>{source.name}</strong><span class="inspired-author">{source.author}</span></span>
            <span class="inspired-plus" aria-hidden="true">+</span>
          </button>
          <div id={`inspired-${source.id}`} class="inspired-detail" hidden>
            <span class="inspired-relation">{source.relation}</span>
            <p>{source.note}</p>
            <div class="inspired-features" aria-label="See it on this site">
              {source.features.map((feature, part) => (
                <a href={`${feature.page}?inspired=${source.id}&part=${part}`} data-inspired-feature data-selector={feature.selector} data-feature={part} data-label={feature.label} data-phone-only={"phoneOnly" in feature && feature.phoneOnly || undefined}>
                  <span aria-hidden="true">⌖</span> {feature.label}<span class="inspired-see">See it here</span>
                </a>
              ))}
            </div>
            <div class="inspired-links">
              <a href={source.url} target="_blank" rel="noopener noreferrer">Visit original ↗</a>
              {source.license && <a href={source.license.url} target="_blank" rel="noopener noreferrer">{source.license.label} ↗</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
    <footer class="inspired-footnote">With thanks to these makers. Adaptations and asset sources are noted above; supplied license notices are retained in the project.</footer>
  </section>
  <aside class="inspired-bar" role="region" aria-label="Design source in view" lang="en">
    <button class="inspired-back" data-inspired-list aria-label="Back to sources">←</button>
    <div><span class="inspired-bar-feature"></span><a class="inspired-bar-origin" target="_blank" rel="noopener noreferrer"></a></div>
    <button class="inspired-close" data-inspired-close aria-label="Close credits">×</button>
  </aside>
  <span class="sr-only" role="status" data-inspired-status></span>
</div>

<script>
  import { mountInspiredCredits } from "../scripts/inspired-credits";
  mountInspiredCredits();
</script>

<style>
  #inspired-credits { --credits-paper: #f6f6f4; --credits-ink: #202221; --credits-muted: #666864; --credits-line: rgb(0 0 0 / .08); --credits-accent: #1765d8; position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; overflow: visible; color: var(--credits-ink); background: transparent; pointer-events: none; }
  #inspired-credits::backdrop { display: none; }
  :global([data-home-theme=dark]) #inspired-credits { --credits-paper: #242522; --credits-ink: #f1f2ee; --credits-muted: #afb2aa; --credits-line: rgb(255 255 255 / .12); --credits-accent: #86b5ff; }
  #inspired-credits button, #inspired-credits a { -webkit-tap-highlight-color: transparent; }
  #inspired-credits button { color: inherit; font: inherit; border: 0; background: none; cursor: pointer; }
  #inspired-credits a { color: inherit; text-decoration: none; }
  #inspired-credits :is(button, a):focus-visible { outline: 2px solid var(--credits-accent); outline-offset: 3px; border-radius: 6px; }
  .inspired-panel, .inspired-bar { pointer-events: auto; background: color-mix(in srgb, var(--credits-paper) 94%, transparent); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); box-shadow: 0 8px 40px rgb(0 0 0 / .09), 0 0 0 1px var(--credits-line); }
  .inspired-panel { position: absolute; top: 24px; left: 24px; width: 330px; max-height: calc(100dvh - 48px); overflow-y: auto; overscroll-behavior: contain; border-radius: 24px; scrollbar-width: thin; }
  :global(html[data-thoughts]) .inspired-panel { left: auto; right: 24px; }
  .inspired-header { display: flex; align-items: flex-start; gap: 8px; padding: 22px 16px 12px 22px; }
  .inspired-header h2 { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; letter-spacing: -.025em; }
  .inspired-header h2 span { font-size: 23px; font-weight: 400; color: var(--credits-accent); }
  .inspired-header p { margin-top: 8px; font-size: 12px; line-height: 1.7; color: var(--credits-muted); }
  #inspired-credits .inspired-close { display: grid; place-items: center; flex: none; margin-left: auto; width: 44px; height: 44px; border-radius: 50%; font-size: 26px; font-weight: 300; line-height: 1; color: var(--credits-muted); }
  .inspired-sources { padding: 0 18px; }
  .inspired-source { border-bottom: 1px solid var(--credits-line); }
  .inspired-source:last-child { border: 0; }
  .inspired-pick { display: flex; align-items: center; width: 100%; gap: 14px; min-height: 68px; text-align: left; }
  .inspired-number { position: relative; font-size: 10px; font-variant-numeric: tabular-nums; color: var(--credits-muted); transition: color 180ms; }
  .inspired-number::before { content: ""; position: absolute; inset: 3px -6px; border-radius: 8px; background: var(--credits-accent); opacity: 0; scale: .3; transition: opacity 180ms, scale 260ms var(--ease-out); }
  .inspired-pick strong { display: block; font-size: 14px; font-weight: 500; }
  .inspired-author { display: block; margin-top: 2px; color: var(--credits-muted); font-size: 11px; }
  .inspired-plus { margin-left: auto; font-size: 20px; color: var(--credits-muted); transition: rotate 220ms var(--ease-out); }
  .inspired-pick[aria-expanded=true] .inspired-plus { rotate: 45deg; }
  .inspired-pick[aria-expanded=true] .inspired-number { color: transparent; }
  .inspired-pick[aria-expanded=true] .inspired-number::before { opacity: 1; scale: .45; }
  .inspired-detail { padding: 0 0 12px 27px; }
  .inspired-detail[hidden] { display: none; }
  .inspired-relation { font-size: 10px; letter-spacing: .025em; color: var(--credits-accent); }
  .inspired-detail p { margin: 8px 0; font-size: 12px; line-height: 1.8; color: var(--credits-muted); }
  .inspired-features { margin-top: 8px; }
  .inspired-features a { display: flex; align-items: center; gap: 6px; min-height: 44px; font-size: 12px; border-radius: 6px; }
  .inspired-features a[aria-current=true] { color: var(--credits-accent) !important; }
  .inspired-features a[aria-disabled=true] { color: var(--credits-muted) !important; cursor: default; }
  .inspired-see { margin-left: auto; font-size: 10px; color: var(--credits-muted); }
  .inspired-links { display: flex; flex-wrap: wrap; gap: 0 16px; }
  .inspired-links a { display: flex; align-items: center; min-height: 44px; font-size: 11px; }
  .inspired-footnote { padding: 14px 22px 22px; color: var(--credits-muted); font-size: 10px; line-height: 1.8; }
  .inspired-thread, .inspired-outline { position: absolute; pointer-events: none; color: var(--credits-accent); }
  .inspired-thread { inset: 0; width: 100%; height: 100%; overflow: visible; }
  .inspired-thread path { fill: none; stroke: currentColor; stroke-width: 1; opacity: .6; }
  .inspired-thread circle { fill: currentColor; }
  .inspired-outline { top: 0; left: 0; border: 1px solid currentColor; border-radius: 12px; box-shadow: 0 0 0 4px color-mix(in srgb, var(--credits-accent) 5%, transparent); opacity: .7; }
  .inspired-thread[hidden], .inspired-outline[hidden] { display: none; }
  .inspired-scrim, .inspired-bar { display: none; }
  #inspired-credits:popover-open .inspired-panel { animation: inspired-unfold 320ms var(--ease-out) both; transform-origin: left bottom; }
  @keyframes inspired-unfold { from { opacity: 0; transform: translateY(12px) scale(.97); } to { opacity: 1; transform: none; } }
  @media (hover: hover) and (pointer: fine) {
    #inspired-credits .inspired-close:hover { background: var(--credits-line); }
    .inspired-pick:hover strong, #inspired-credits a:hover { color: var(--credits-accent); }
  }
  @media (max-width: 1199px) {
    :global(html:has(#inspired-credits:popover-open[data-view=list])) { overflow: hidden; }
    .inspired-scrim { display: block; position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: auto; background: rgb(0 0 0 / .12) !important; }
    #inspired-credits .inspired-panel { top: auto; left: 12px; right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); width: auto; max-width: 480px; margin-inline: auto; max-height: calc(100dvh - max(24px, env(safe-area-inset-top)) - max(24px, env(safe-area-inset-bottom))); border-radius: 26px; transform-origin: center bottom; }
    #inspired-credits[data-view=preview] .inspired-panel, #inspired-credits[data-view=preview] .inspired-scrim { display: none; }
    #inspired-credits[data-view=preview] .inspired-bar { display: flex; }
    .inspired-bar { position: absolute; left: 12px; right: 12px; align-items: center; gap: 10px; min-height: 70px; max-width: 460px; margin-inline: auto; padding: 8px; border-radius: 22px; animation: inspired-unfold 220ms var(--ease-out) both; }
    #inspired-credits[data-side=top] .inspired-bar { top: calc(12px + env(safe-area-inset-top)); }
    #inspired-credits[data-side=bottom] .inspired-bar { bottom: calc(12px + env(safe-area-inset-bottom)); }
    #inspired-credits .inspired-back { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; font-size: 20px; }
    .inspired-bar-feature { display: block; font-size: 11px; color: var(--credits-muted); }
    .inspired-bar-origin { display: flex; align-items: center; min-height: 32px; font-size: 13px; font-weight: 500; }
    .inspired-bar .inspired-close { margin-left: auto; }
  }
  @media (prefers-reduced-motion: reduce) { #inspired-credits *, #inspired-credits *::before { animation: none !important; transition: none !important; } }
</style>
