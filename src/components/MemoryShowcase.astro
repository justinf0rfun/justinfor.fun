---
import ParentLink from "./ParentLink.astro";
import { folderMemoryPhotos, memoryMonths, memoryPhotos as memories } from "../data/memories";

interface Props {
  mode?: "overlay" | "standalone";
}

const { mode = "standalone" } = Astro.props;
const isOverlay = mode === "overlay";
const sheetColumns = 17;
const flightSlots = [57, 59, 61, 75, 77];
const sheet = Array.from({ length: sheetColumns * 11 }, (_, index) => {
  const column = index % sheetColumns;
  const row = Math.floor(index / sheetColumns);
  const target = flightSlots.indexOf(index);
  const photo = target >= 0 ? folderMemoryPhotos[target] : memories[(column + row * 3) % memories.length];
  return { photo, x: column - 8, y: row - 5, target };
});

---

<section
  class:list={["memory-page", isOverlay && "is-overlay", !isOverlay && "is-open"]}
  data-memory-stage={mode}
  aria-hidden={isOverlay ? "true" : undefined}
  inert={isOverlay ? true : undefined}
>
  <div class="memory-entry" data-memory-entry>
    <div class="memory-scene" data-memory-scene>
      <header class="memory-header" data-memory-reveal>
        <ParentLink label="Home" href={isOverlay ? undefined : "/"} {...(isOverlay ? { "data-memory-close": "" } : {})} />
        <div>
          <h1>Memory</h1>
          <p>{memories.length} photographs</p>
        </div>
      </header>

      <div class="memory-sheet" aria-hidden="true" data-memory-sheet>
        {sheet.map(({ photo, x, y, target }) => (
          <div class="memory-sheet-photo" data-memory-tile data-x={x} data-y={y}
            data-memory-visual-target={target >= 0 ? target : undefined}
            style={`--tile-x: ${x}; --tile-y: ${y}; --tile-ratio: ${photo.width / photo.height}`}>
            <img src={photo.src} alt="" width={photo.width} height={photo.height} decoding="async" draggable="false" />
          </div>
        ))}
      </div>

      <div class="memory-spacing-hud" data-memory-spacing-hud aria-hidden="true">
        <span class="memory-spacing-dot"></span>
        <span class="memory-spacing-readout">H <span data-memory-h>1.00</span> V <span data-memory-v>1.00</span></span>
      </div>

      <div class="memory-intro">
        <div class="memory-lens" aria-hidden="true" data-memory-lens style={`--memory-refraction: url(#memory-lens-${mode})`}>
          <div class="memory-lens-glass"></div>
        </div>
        <svg class="memory-lens-filter" width="0" height="0" aria-hidden="true">
          <filter id={`memory-lens-${mode}`} x="0" y="0" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
            <feImage x="0" y="0" preserveAspectRatio="none" result="map" />
            <feDisplacementMap in="SourceGraphic" in2="map" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </svg>
        <div class="memory-intro-copy">
          <h2>Photographs I want to remember.</h2>
          <p>Places, light, and small details I want to keep.</p>
          <a class="memory-browse" href={`#memory-archive-${mode}`} data-memory-browse>
            View photographs <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="memory-archive" id={`memory-archive-${mode}`} tabindex="-1">
    {memoryMonths.map((month, monthIndex) => (
      <section class="memory-month" aria-label={`${month.location}, ${month.label}`}>
        <header class="memory-month-header">
          <h3>{month.location}</h3>
          <time datetime={month.dateTime}>{month.label}</time>
        </header>
        <div class="memory-rolls">
          {month.rolls.map((roll, rollIndex) => (
            <ol class="memory-roll" role="list" aria-label={`Roll ${rollIndex + 1}`}
              data-memory-unfold={monthIndex === 0 && rollIndex < 2 ? "" : undefined}>
              {roll.map((photo) => (
                <li>
                  <a class="memory-photo" href={photo.src}
                    aria-label={`Enlarge ${photo.alt}`} data-memory-photo>
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      width={photo.width}
                      height={photo.height}
                      loading={photo.index < folderMemoryPhotos.length ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </section>
    ))}
  </div>

  <dialog class="memory-lightbox" data-memory-lightbox aria-label="Photo preview">
    <button class="memory-lightbox-close" data-memory-lightbox-close type="button" aria-label="Close photo preview" autofocus>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8"></path>
      </svg>
    </button>
    <img class="memory-lightbox-image" data-memory-lightbox-image alt="" />
  </dialog>
</section>

<style>
  .memory-page {
    --memory-surface: var(--home-background, var(--color-neutral-50));
    min-height: 100svh;
    overflow-x: clip;
    background: var(--memory-surface);
    color: var(--home-ink, var(--color-neutral-800));
  }

  .memory-page.is-overlay {
    position: fixed;
    inset: 0;
    z-index: 45;
    overflow: hidden auto;
    overscroll-behavior-y: contain;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms var(--ease-out);
  }

  .memory-page.is-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .memory-page.is-carrying [data-memory-visual-target] {
    visibility: hidden;
  }

  .memory-entry {
    height: 175svh;
  }

  .memory-scene {
    --tile-size: clamp(55px, 5vw, 80px);
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    touch-action: pan-y pinch-zoom;
    isolation: isolate;
  }

  .memory-sheet {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, color-mix(in srgb, currentColor 11%, transparent) .55px, transparent .8px) 0 0 / 14px 14px;
    opacity: var(--memory-sheet-opacity, 1);
    pointer-events: none;
    mask-image: radial-gradient(ellipse closest-side, black 66%, rgb(0 0 0 / .38) 112%);
  }

  .memory-sheet-photo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--tile-size);
    aspect-ratio: var(--tile-ratio);
    transform: translate(-50%, -50%)
      translate(calc(var(--tile-x) * (var(--tile-size) + 17px)), calc(var(--tile-y) * (var(--tile-size) + 17px)));
  }

  .memory-sheet-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .memory-header, .memory-archive {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .memory-header {
    position: absolute;
    z-index: 4;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
    text-align: right;
    pointer-events: none;
  }

  .memory-header :global([data-parent-navigation]) { pointer-events: auto; }

  .memory-header h1, .memory-month-header h3 {
    font-size: .875rem;
    font-weight: 550;
  }

  .memory-header p, .memory-month-header time {
    font-size: .75rem;
    color: var(--home-muted, var(--color-neutral-500));
  }

  .memory-header p { margin-top: .125rem; }

  .memory-intro {
    --lens-size: 420px;
    --lens-home-y: calc(100% - 85px);
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
  }

  .memory-lens {
    position: absolute;
    left: 50%;
    top: var(--memory-lens-center, var(--lens-home-y));
    width: var(--lens-size);
    aspect-ratio: 1;
    translate: -50% -50%;
    scale: var(--memory-lens-scale, 1);
    opacity: var(--memory-lens-opacity, 1);
  }

  .memory-lens-glass {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, var(--memory-surface) 76%,
        rgb(from var(--memory-surface) r g b / .99) 80%, rgb(from var(--memory-surface) r g b / .96) 84%,
        rgb(from var(--memory-surface) r g b / .9) 88%, rgb(from var(--memory-surface) r g b / .78) 92%,
        rgb(from var(--memory-surface) r g b / .6) 95%, rgb(from var(--memory-surface) r g b / .36) 97.5%,
        rgb(from var(--memory-surface) r g b / 0)),
      radial-gradient(closest-side, transparent 88%, rgb(255 255 255 / .13));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .35), 0 16px 48px rgb(0 0 0 / .075);
  }

  .memory-lens::before, .memory-lens::after {
    content: "";
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    --lens-tick: color-mix(in srgb, currentColor 23%, transparent);
    background: conic-gradient(color-mix(in srgb, currentColor 85%, transparent) var(--memory-lens-angle, 0deg), var(--lens-tick) 0);
    mask: repeating-conic-gradient(#000 0 .22deg, transparent .22deg 3deg),
      radial-gradient(closest-side, transparent calc(100% - 8px), #000 calc(100% - 7px) calc(100% - 1px), transparent);
    mask-composite: intersect;
  }

  .memory-lens::before {
    inset: -24px;
    --lens-tick: color-mix(in srgb, currentColor 42%, transparent);
    mask: repeating-conic-gradient(#000 0 .24deg, transparent .24deg 90deg),
      radial-gradient(closest-side, transparent calc(100% - 15px), #000 calc(100% - 14px) calc(100% - 1px), transparent);
    mask-composite: intersect;
  }

  .memory-lens-filter { position: absolute; }

  @media (min-width: 641px) and (pointer: fine) {
    .memory-lens-glass { backdrop-filter: blur(6px) saturate(1.3); }
    .memory-lens[data-refract] .memory-lens-glass {
      backdrop-filter: var(--memory-refraction) saturate(1.3) brightness(1.04);
    }
    .memory-scene[data-memory-at-start] .memory-lens {
      pointer-events: auto;
      transition: scale .85s linear(0, .035 2.4%, .227 7.1%, .481 11.8%, .818 19%, .993 68.2%, 1);
    }
    .memory-scene[data-memory-at-start] .memory-lens:hover,
    .memory-scene[data-memory-at-start] .memory-intro:focus-within .memory-lens { scale: 1.42; }
  }

  .memory-intro-copy {
    position: absolute;
    left: 50%;
    bottom: max(26px, env(safe-area-inset-bottom));
    width: min(304px, calc(100% - 48px));
    min-height: 183px;
    display: flex;
    flex-direction: column;
    align-items: center;
    translate: -50% var(--memory-copy-y, 0px);
    text-align: center;
    opacity: var(--memory-copy-opacity, 1);
  }

  .memory-intro h2 {
    max-width: 230px;
    margin-inline: auto;
    font-size: 20px;
    font-weight: 550;
    letter-spacing: -.025em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .memory-intro p {
    max-width: 240px;
    margin: 12px auto 0;
    color: var(--home-muted, var(--color-neutral-600));
    font-size: 12px;
    line-height: 1.4;
    text-wrap: balance;
  }

  .memory-browse {
    display: inline-flex;
    min-height: 44px;
    gap: 10px;
    align-items: center;
    margin-block-start: auto;
    padding-inline: 15px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 7%, transparent);
    color: inherit;
    font-weight: 550;
    font-size: 12px;
    text-decoration: none;
    pointer-events: auto;
  }

  .memory-browse:hover { background: color-mix(in srgb, currentColor 11%, transparent); }
  .memory-browse:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .memory-archive {
    padding-block: 3rem max(4rem, 14svh);
    outline: none;
  }

  .memory-month + .memory-month {
    margin-block-start: clamp(3.5rem, 9vw, 7rem);
  }

  .memory-month-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .memory-rolls {
    --memory-photo-gap: clamp(0.5rem, 1.4vw, 1.125rem);
    --memory-roll-gap: clamp(1rem, 2.4vw, 2rem);
    display: grid;
    gap: var(--memory-roll-gap);
  }

  .memory-roll {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--memory-photo-gap);
    list-style: none;
  }

  .memory-spacing-hud {
    --hairline: color-mix(in srgb, currentColor 18%, transparent);
    position: absolute;
    z-index: 2;
    inset: 0;
    opacity: 0;
    transition: opacity 250ms var(--ease-out);
    pointer-events: none;
  }

  .memory-scene[data-memory-spacing-active] .memory-spacing-hud { opacity: var(--memory-sheet-opacity, 1); }

  .memory-spacing-hud::before, .memory-spacing-hud::after {
    content: "";
    position: absolute;
    background: var(--hairline);
  }

  .memory-spacing-hud::before { inset: 0 auto 0 var(--hud-x); width: 1px; }
  .memory-spacing-hud::after { inset: var(--hud-y) 0 auto; height: 1px; }

  .memory-spacing-dot {
    position: absolute;
    top: var(--hud-y);
    left: var(--hud-x);
    width: 8px;
    height: 8px;
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 1px 4px rgb(0 0 0 / .36);
  }

  .memory-spacing-readout {
    position: absolute;
    left: min(calc(var(--hud-x) + 16px), calc(100% - 120px));
    top: min(calc(var(--hud-y) + 10px), calc(100% - 26px));
    padding: 4px 8px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--memory-surface) 67%, transparent);
    backdrop-filter: blur(16px);
    font: 500 12px / 16px ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
    white-space: pre;
  }

  @media (max-width: 640px) {
    .memory-intro {
      --lens-size: 128vw;
      --lens-home-y: calc(100% - 247px + var(--lens-size) / 2);
    }
    .memory-intro-copy { bottom: max(20px, env(safe-area-inset-bottom)); min-height: 173px; }
    .memory-intro h2 { font-size: 18px; }
    .memory-lens-glass { box-shadow: none; }
    .memory-spacing-readout { backdrop-filter: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .memory-page.is-open .memory-lens-glass { animation: memory-lens-in .9s var(--ease-out) both; }
    .memory-page.is-open .memory-intro-copy > * { animation: memory-copy-in .6s var(--ease-out) both; }
    .memory-page.is-open .memory-intro-copy > p { animation-delay: 70ms; }
    .memory-page.is-open .memory-intro-copy > a { animation-delay: 140ms; }
  }

  @keyframes memory-lens-in { from { opacity: 0; scale: .9; } }
  @keyframes memory-copy-in { from { opacity: 0; translate: 0 12px; } }

  .memory-photo {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-neutral-100);
    cursor: zoom-in;
  }

  .memory-photo:focus-visible,
  .memory-lightbox-close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .memory-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  :global(html:has(.memory-lightbox[open])),
  .memory-page.is-overlay:has(.memory-lightbox[open]) {
    overflow: hidden;
  }

  .memory-lightbox {
    --preview-top: max(3.75rem, calc(env(safe-area-inset-top) + 3rem));
    --preview-bottom: max(1.25rem, env(safe-area-inset-bottom));
    box-sizing: border-box;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--preview-top) clamp(1rem, 4vw, 3rem) var(--preview-bottom);
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .memory-lightbox[open] {
    display: grid;
    place-items: center;
  }

  .memory-lightbox::backdrop {
    background: rgb(13 13 14 / 0.93);
    transition: opacity 220ms var(--ease-out);
    animation: memory-backdrop-in 220ms var(--ease-out);
  }

  .memory-lightbox[data-closing]::backdrop {
    opacity: 0;
  }

  .memory-lightbox-image {
    display: block;
    width: min(100%, var(--preview-width), calc(var(--preview-ratio) * (100dvh - var(--preview-top) - var(--preview-bottom))));
    height: auto;
    aspect-ratio: var(--preview-ratio);
    border-radius: 0.375rem;
    object-fit: contain;
  }

  .memory-lightbox-close {
    position: fixed;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    color: white;
    background: rgb(255 255 255 / 0.1);
    cursor: pointer;
  }

  .memory-lightbox-close svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  @keyframes memory-backdrop-in {
    from { opacity: 0; }
  }

  @media (hover: hover) {
    .memory-lightbox-close:hover { background: rgb(255 255 255 / 0.2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .memory-page.is-overlay { transition-duration: 120ms; }
    .memory-lightbox::backdrop { animation: none; transition: none; }
    .memory-spacing-hud { transition: none; }
    .memory-entry { height: 100svh; }
    .memory-scene { position: relative; }
  }
</style>

<script>
  import { mountMemoryHero } from "../scripts/memory-hero";

  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (value: number) => Math.max(0, Math.min(1, value));
  const ease = (value: number) => value * value * (3 - 2 * value);

  document.querySelectorAll<HTMLElement>("[data-memory-stage]").forEach((stage) => {
    const lightbox = stage.querySelector<HTMLDialogElement>("[data-memory-lightbox]")!;
    const image = stage.querySelector<HTMLImageElement>("[data-memory-lightbox-image]")!;
    const close = stage.querySelector<HTMLButtonElement>("[data-memory-lightbox-close]")!;
    const isOverlay = stage.dataset.memoryStage === "overlay";
    const scrollRoot = isOverlay ? stage : document.documentElement;
    const rolls = [...stage.querySelectorAll<HTMLOListElement>("[data-memory-unfold]")];
    mountMemoryHero(stage, reduced);
    const archive = stage.querySelector<HTMLElement>(".memory-archive")!;
    const entry = stage.querySelector<HTMLElement>("[data-memory-entry]")!;
    let tiles: { photo: HTMLAnchorElement; x: number; y: number; angle: number; scale: number; delay: number }[] = [];
    let lastProgress = -1;
    let travel = 0;
    let frame = 0;
    let opener: HTMLAnchorElement | null = null;
    let previewScroll = 0;
    let flight: Animation | undefined;

    const paint = () => {
      frame = 0;
      if (isOverlay && !stage.classList.contains("is-open")) return;
      const y = isOverlay ? stage.scrollTop : window.scrollY;
      const animateIntro = !reduced.matches && travel >= 32;
      const progress = animateIntro ? clamp((y - entry.offsetHeight) / travel) : 0;
      if (progress === lastProgress) return;
      lastProgress = progress;

      for (const { photo, x, y, angle, scale, delay } of tiles) {
        const fold = animateIntro ? 1 - ease(clamp((progress - delay) / (1 - delay))) : 0;
        photo.style.transform = fold === 0 ? "" :
          `translate(${x * fold}%, ${y * fold}px) rotate(${angle * fold}deg) scale(${1 - scale * fold})`;
      }
    };

    const measure = () => {
      const depth = stage.clientWidth > 768 ? 1 : 0.65;
      tiles = rolls.flatMap((roll, rollIndex) => {
        return [...roll.querySelectorAll<HTMLAnchorElement>("[data-memory-photo]")].map((photo, i) => {
          const side = i % 2 === 0 ? -1 : 1;
          const row = Math.floor(i / 2);
          return {
            photo,
            x: side * -5 * depth,
            y: (side * 9 + row * 5) * depth,
            angle: side * 5 * depth,
            scale: 0.11 * depth,
            delay: Math.min(0.24, row * 0.075 + rollIndex * 0.13 + (side === 1 ? 0.035 : 0)),
          };
        });
      });
      travel = Math.round(Math.min(scrollRoot.clientHeight * 0.44, scrollRoot.scrollHeight - scrollRoot.clientHeight));
      lastProgress = -1;
      cancelAnimationFrame(frame);
      paint();
    };

    const requestPaint = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };

    const thumbnailPose = (photo: HTMLAnchorElement, preview: DOMRect) => {
      const rect = photo.getBoundingClientRect();
      const matrix = new DOMMatrix(getComputedStyle(photo).transform);
      const x = rect.left + rect.width / 2 - preview.left - preview.width / 2;
      const y = rect.top + rect.height / 2 - preview.top - preview.height / 2;
      const scale = Math.hypot(matrix.a, matrix.b) * photo.offsetWidth / preview.width;
      const angle = Math.atan2(matrix.b, matrix.a) * 180 / Math.PI;
      return `translate(${x}px, ${y}px) rotate(${angle}deg) scale(${scale})`;
    };

    const closePreview = () => {
      if (!lightbox.open || lightbox.hasAttribute("data-closing")) return;
      if (reduced.matches || !opener) {
        lightbox.close();
        return;
      }

      const current = getComputedStyle(image).transform;
      flight?.cancel();
      const target = thumbnailPose(opener, image.getBoundingClientRect());
      lightbox.setAttribute("data-closing", "");
      flight = image.animate([{ transform: current }, { transform: target }], {
        duration: 240, easing: "cubic-bezier(.4, 0, .25, 1)", fill: "forwards",
      });
      flight.onfinish = () => lightbox.close();
    };

    stage.querySelectorAll<HTMLAnchorElement>("[data-memory-photo]").forEach((photo) => {
      photo.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const thumbnail = photo.querySelector("img")!;
        opener = photo;
        previewScroll = isOverlay ? stage.scrollTop : window.scrollY;
        image.src = photo.href;
        image.alt = thumbnail.alt;
        const width = Number(thumbnail.getAttribute("width"));
        const height = Number(thumbnail.getAttribute("height"));
        image.style.setProperty("--preview-width", `${width}px`);
        image.style.setProperty("--preview-ratio", String(width / height));
        lightbox.showModal();
        if (!reduced.matches) {
          const from = thumbnailPose(photo, image.getBoundingClientRect());
          flight = image.animate([{ transform: from }, { transform: "none" }], {
            duration: 290, easing: "cubic-bezier(.2, .75, .25, 1)",
          });
        }
      });
    });

    close.addEventListener("click", closePreview);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closePreview();
    });
    lightbox.addEventListener("cancel", (event) => {
      event.preventDefault();
      closePreview();
    });
    lightbox.addEventListener("close", () => {
      flight?.cancel();
      lightbox.removeAttribute("data-closing");
      if (!stage.inert && opener) {
        opener.focus({ preventScroll: true });
        (isOverlay ? stage : window).scrollTo({ top: previewScroll, behavior: "instant" });
      }
      opener = null;
    });
    window.addEventListener("keydown", (event) => {
      if (!lightbox.open || event.key !== "Escape") return;
      event.preventDefault();
      event.stopImmediatePropagation();
      closePreview();
    }, { capture: true });

    (isOverlay ? stage : window).addEventListener("scroll", requestPaint, { passive: true });
    const resize = new ResizeObserver(measure);
    resize.observe(stage);
    resize.observe(archive);
    stage.addEventListener("memory-layout", measure);
    reduced.addEventListener("change", measure);
    window.addEventListener("pageshow", measure);
    measure();
  });
</script>
