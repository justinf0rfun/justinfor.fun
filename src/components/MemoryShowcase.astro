---
import ParentLink from "./ParentLink.astro";
import { folderMemoryPhotos, memoryMonths, memoryPhotos as memories } from "../data/memories";

interface Props {
  mode?: "overlay" | "standalone";
}

const { mode = "standalone" } = Astro.props;
const isOverlay = mode === "overlay";
---

<section
  class:list={["memory-page", isOverlay && "is-overlay", !isOverlay && "is-open"]}
  data-memory-stage={mode}
  aria-hidden={isOverlay ? "true" : undefined}
  inert={isOverlay ? true : undefined}
>
  <header class="memory-header" data-memory-reveal>
    <ParentLink label="Home" href={isOverlay ? undefined : "/"} {...(isOverlay ? { "data-memory-close": "" } : {})} />
    <div>
      <h1>Memory</h1>
      <p>{memories.length} photographs</p>
    </div>
  </header>

  <div class="memory-intro" data-memory-reveal>
    <h2>Photographs I want to remember.</h2>
    <p>Places, light, and small details I want to keep.</p>
  </div>

  <div class="memory-archive">
    {memoryMonths.map((month, monthIndex) => (
      <section class="memory-month" aria-label={`${month.location}, ${month.label}`}>
        <header class="memory-month-header" data-memory-reveal>
          <h3>{month.location}</h3>
          <time datetime={month.dateTime}>{month.label}</time>
        </header>
        <div class="memory-rolls">
          {month.rolls.map((roll, rollIndex) => (
            <ol
              class="memory-roll"
              role="list"
              aria-label={`Roll ${rollIndex + 1}`}
              data-memory-unfold={monthIndex === 0 && rollIndex < 2 ? "" : undefined}
            >
              {roll.map((photo) => (
                <li>
                  <a
                    class="memory-photo"
                    href={photo.src}
                    aria-label={`Enlarge ${photo.alt}`}
                    data-memory-photo
                    data-memory-visual-target={photo.index < folderMemoryPhotos.length ? photo.index : undefined}
                  >
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      width={photo.width}
                      height={photo.height}
                      loading={photo.index < folderMemoryPhotos.length ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </section>
    ))}
  </div>

  <dialog class="memory-lightbox" data-memory-lightbox aria-label="Photo preview">
    <button class="memory-lightbox-close" data-memory-lightbox-close type="button" aria-label="Close photo preview" autofocus>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8"></path>
      </svg>
    </button>
    <img class="memory-lightbox-image" data-memory-lightbox-image alt="" />
  </dialog>
</section>

<style>
  .memory-page {
    min-height: 100svh;
    overflow-x: clip;
    background: var(--home-background, var(--color-neutral-50));
    color: var(--home-ink, var(--color-neutral-800));
  }

  .memory-page.is-overlay {
    position: fixed;
    inset: 0;
    z-index: 45;
    overflow: hidden auto;
    overscroll-behavior-y: contain;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms var(--ease-out);
  }

  .memory-page.is-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .memory-page.is-carrying [data-memory-visual-target] {
    visibility: hidden;
  }

  .memory-header,
  .memory-intro,
  .memory-archive {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .memory-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
    text-align: right;
  }

  .memory-header h1,
  .memory-month-header h3 {
    font-size: 0.875rem;
    font-weight: 550;
  }

  .memory-header p,
  .memory-month-header time {
    font-size: 0.75rem;
    color: var(--home-muted, var(--color-neutral-500));
  }

  .memory-header p { margin-top: 0.125rem; }

  .memory-intro {
    margin-block-start: clamp(1.75rem, 6.5svh, 4.5rem);
  }

  .memory-intro h2 {
    max-width: 22ch;
    font-size: clamp(2.1rem, 5.3vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .memory-intro p {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--home-muted, var(--color-neutral-500));
  }

  .memory-archive {
    margin-block-start: clamp(2rem, 6.5svh, 4.75rem);
    padding-block-end: max(4rem, 14svh);
  }

  .memory-month + .memory-month {
    margin-block-start: clamp(3.5rem, 9vw, 7rem);
  }

  .memory-month-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .memory-rolls {
    display: grid;
    gap: clamp(1rem, 2.4vw, 2rem);
  }

  .memory-roll {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(0.5rem, 1.4vw, 1.125rem);
    list-style: none;
  }

  .memory-photo {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-neutral-100);
    cursor: zoom-in;
  }

  .memory-photo:focus-visible,
  .memory-lightbox-close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .memory-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  :global(html:has(.memory-lightbox[open])),
  .memory-page.is-overlay:has(.memory-lightbox[open]) {
    overflow: hidden;
  }

  .memory-lightbox {
    --preview-top: max(3.75rem, calc(env(safe-area-inset-top) + 3rem));
    --preview-bottom: max(1.25rem, env(safe-area-inset-bottom));
    box-sizing: border-box;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--preview-top) clamp(1rem, 4vw, 3rem) var(--preview-bottom);
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .memory-lightbox[open] {
    display: grid;
    place-items: center;
  }

  .memory-lightbox::backdrop {
    background: rgb(13 13 14 / 0.93);
    transition: opacity 220ms var(--ease-out);
    animation: memory-backdrop-in 220ms var(--ease-out);
  }

  .memory-lightbox[data-closing]::backdrop {
    opacity: 0;
  }

  .memory-lightbox-image {
    display: block;
    width: min(100%, var(--preview-width), calc(var(--preview-ratio) * (100dvh - var(--preview-top) - var(--preview-bottom))));
    height: auto;
    aspect-ratio: var(--preview-ratio);
    border-radius: 0.375rem;
    object-fit: contain;
  }

  .memory-lightbox-close {
    position: fixed;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    color: white;
    background: rgb(255 255 255 / 0.1);
    cursor: pointer;
  }

  .memory-lightbox-close svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  @keyframes memory-backdrop-in {
    from { opacity: 0; }
  }

  @media (hover: hover) {
    .memory-lightbox-close:hover { background: rgb(255 255 255 / 0.2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .memory-page.is-overlay { transition-duration: 120ms; }
    .memory-lightbox::backdrop { animation: none; transition: none; }
  }
</style>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (value: number) => Math.max(0, Math.min(1, value));
  const ease = (value: number) => value * value * (3 - 2 * value);

  document.querySelectorAll<HTMLElement>("[data-memory-stage]").forEach((stage) => {
    const lightbox = stage.querySelector<HTMLDialogElement>("[data-memory-lightbox]")!;
    const image = stage.querySelector<HTMLImageElement>("[data-memory-lightbox-image]")!;
    const close = stage.querySelector<HTMLButtonElement>("[data-memory-lightbox-close]")!;
    const isOverlay = stage.dataset.memoryStage === "overlay";
    const scrollRoot = isOverlay ? stage : document.documentElement;
    const rolls = [...stage.querySelectorAll<HTMLOListElement>("[data-memory-unfold]")];
    let tiles: { photo: HTMLAnchorElement; x: number; y: number; angle: number; scale: number; delay: number }[] = [];
    let lastProgress = -1;
    let travel = 0;
    let frame = 0;
    let opener: HTMLAnchorElement | null = null;
    let previewScroll = 0;
    let flight: Animation | undefined;

    const paint = () => {
      frame = 0;
      if (isOverlay && !stage.classList.contains("is-open")) return;
      const y = isOverlay ? stage.scrollTop : window.scrollY;
      const progress = reduced.matches || travel < 32 ? 1 : clamp(y / travel);
      if (progress === lastProgress) return;
      lastProgress = progress;

      for (const { photo, x, y, angle, scale, delay } of tiles) {
        const fold = 1 - ease(clamp((progress - delay) / (1 - delay)));
        photo.style.transform = fold === 0 ? "" :
          `translate(${x * fold}%, ${y * fold}px) rotate(${angle * fold}deg) scale(${1 - scale * fold})`;
      }
    };

    const measure = () => {
      const depth = stage.clientWidth > 768 ? 1 : 0.65;
      tiles = rolls.flatMap((roll, rollIndex) => {
        return [...roll.querySelectorAll<HTMLAnchorElement>("[data-memory-photo]")].map((photo, i) => {
          const side = i % 2 === 0 ? -1 : 1;
          const row = Math.floor(i / 2);
          return {
            photo,
            x: side * -5 * depth,
            y: (side * 9 + row * 5) * depth,
            angle: side * 5 * depth,
            scale: 0.11 * depth,
            delay: Math.min(0.24, row * 0.075 + rollIndex * 0.13 + (side === 1 ? 0.035 : 0)),
          };
        });
      });
      travel = Math.min(scrollRoot.clientHeight * 0.44, scrollRoot.scrollHeight - scrollRoot.clientHeight);
      lastProgress = -1;
      cancelAnimationFrame(frame);
      paint();
    };

    const requestPaint = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };

    const thumbnailPose = (photo: HTMLAnchorElement, preview: DOMRect) => {
      const rect = photo.getBoundingClientRect();
      const matrix = new DOMMatrix(getComputedStyle(photo).transform);
      const x = rect.left + rect.width / 2 - preview.left - preview.width / 2;
      const y = rect.top + rect.height / 2 - preview.top - preview.height / 2;
      const scale = Math.hypot(matrix.a, matrix.b) * photo.offsetWidth / preview.width;
      const angle = Math.atan2(matrix.b, matrix.a) * 180 / Math.PI;
      return `translate(${x}px, ${y}px) rotate(${angle}deg) scale(${scale})`;
    };

    const closePreview = () => {
      if (!lightbox.open || lightbox.hasAttribute("data-closing")) return;
      if (reduced.matches || !opener) {
        lightbox.close();
        return;
      }

      const current = getComputedStyle(image).transform;
      flight?.cancel();
      const target = thumbnailPose(opener, image.getBoundingClientRect());
      lightbox.setAttribute("data-closing", "");
      flight = image.animate([{ transform: current }, { transform: target }], {
        duration: 240, easing: "cubic-bezier(.4, 0, .25, 1)", fill: "forwards",
      });
      flight.onfinish = () => lightbox.close();
    };

    stage.querySelectorAll<HTMLAnchorElement>("[data-memory-photo]").forEach((photo) => {
      photo.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const thumbnail = photo.querySelector("img")!;
        opener = photo;
        previewScroll = isOverlay ? stage.scrollTop : window.scrollY;
        image.src = photo.href;
        image.alt = thumbnail.alt;
        const width = Number(thumbnail.getAttribute("width"));
        const height = Number(thumbnail.getAttribute("height"));
        image.style.setProperty("--preview-width", `${width}px`);
        image.style.setProperty("--preview-ratio", String(width / height));
        lightbox.showModal();
        if (!reduced.matches) {
          const from = thumbnailPose(photo, image.getBoundingClientRect());
          flight = image.animate([{ transform: from }, { transform: "none" }], {
            duration: 290, easing: "cubic-bezier(.2, .75, .25, 1)",
          });
        }
      });
    });

    close.addEventListener("click", closePreview);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closePreview();
    });
    lightbox.addEventListener("cancel", (event) => {
      event.preventDefault();
      closePreview();
    });
    lightbox.addEventListener("close", () => {
      flight?.cancel();
      lightbox.removeAttribute("data-closing");
      if (!stage.inert && opener) {
        opener.focus({ preventScroll: true });
        (isOverlay ? stage : window).scrollTo({ top: previewScroll, behavior: "instant" });
      }
      opener = null;
    });
    window.addEventListener("keydown", (event) => {
      if (!lightbox.open || event.key !== "Escape") return;
      event.preventDefault();
      event.stopImmediatePropagation();
      closePreview();
    }, { capture: true });

    (isOverlay ? stage : window).addEventListener("scroll", requestPaint, { passive: true });
    const resize = new ResizeObserver(measure);
    resize.observe(stage);
    resize.observe(stage.querySelector(".memory-archive")!);
    stage.addEventListener("memory-layout", measure);
    reduced.addEventListener("change", measure);
    window.addEventListener("pageshow", measure);
    measure();
  });
</script>
