---
import ParentLink from "./ParentLink.astro";
import { folderMemoryPhotos, memoryMonths, memoryPhotos as memories } from "../data/memories";

interface Props {
  mode?: "overlay" | "standalone";
}

const { mode = "standalone" } = Astro.props;
const isOverlay = mode === "overlay";
---

<section
  class:list={["memory-page", isOverlay && "is-overlay", !isOverlay && "is-open"]}
  data-memory-stage={mode}
  aria-hidden={isOverlay ? "true" : undefined}
  inert={isOverlay ? true : undefined}
>
  <header class="memory-header" data-memory-reveal>
    <ParentLink label="Home" href={isOverlay ? undefined : "/"} {...(isOverlay ? { "data-memory-close": "" } : {})} />
    <div>
      <h1>Memory</h1>
      <p>{memories.length} photographs</p>
    </div>
  </header>

  <div class="memory-intro" data-memory-reveal>
    <div class="memory-lens" aria-hidden="true" data-memory-lens style={`--memory-refraction: url(#memory-lens-${mode})`}>
      <div class="memory-lens-glass"></div>
    </div>
    <svg class="memory-lens-filter" width="0" height="0" aria-hidden="true">
      <filter id={`memory-lens-${mode}`} x="0" y="0" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
        <feImage x="0" y="0" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <div class="memory-intro-copy">
      <h2>Photographs I want to remember.</h2>
      <p>Places, light, and small details I want to keep.</p>
    </div>
  </div>

  <div class="memory-archive">
    {memoryMonths.map((month, monthIndex) => (
      <section class="memory-month" aria-label={`${month.location}, ${month.label}`} data-memory-spacing={monthIndex === 0 ? "" : undefined}>
        <header class="memory-month-header" data-memory-reveal>
          <h3>{month.location}</h3>
          <div class="memory-month-details">
            <time datetime={month.dateTime}>{month.label}</time>
            {monthIndex === 0 && (
              <button type="button" class="memory-spacing-pad" data-memory-spacing-pad hidden
                aria-label="Adjust photo spacing" aria-describedby={`memory-spacing-help-${mode}`}
                title="Drag to adjust photo spacing">
                <span aria-hidden="true"></span>
              </button>
            )}
            {monthIndex === 0 && <span class="sr-only" id={`memory-spacing-help-${mode}`}>Drag or use the arrow keys to adjust spacing. Release, or press Escape, to reset.</span>}
          </div>
        </header>
        <div class="memory-rolls">
          {month.rolls.map((roll, rollIndex) => (
            <ol
              class="memory-roll"
              role="list"
              aria-label={`Roll ${rollIndex + 1}`}
              data-memory-unfold={monthIndex === 0 && rollIndex < 2 ? "" : undefined}
            >
              {roll.map((photo, i) => (
                <li style={monthIndex === 0 && rollIndex < 2 ?
                  `--memory-column: ${i % 2 - 0.5}; --memory-row: ${Math.floor(i / 2) + (rollIndex ? Math.ceil(month.rolls[0].length / 2) - 1 : 0)}` : undefined}>
                  <a
                    class="memory-photo"
                    href={photo.src}
                    aria-label={`Enlarge ${photo.alt}`}
                    data-memory-photo
                    data-memory-visual-target={photo.index < folderMemoryPhotos.length ? photo.index : undefined}
                  >
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      width={photo.width}
                      height={photo.height}
                      loading={photo.index < folderMemoryPhotos.length ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ol>
          ))}
        </div>
        {monthIndex === 0 && (
          <div class="memory-spacing-hud" data-memory-spacing-hud aria-hidden="true">
            <span class="memory-spacing-dot"></span>
            <span class="memory-spacing-readout">H <span data-memory-h>1.00</span> V <span data-memory-v>1.00</span></span>
          </div>
        )}
      </section>
    ))}
  </div>

  <dialog class="memory-lightbox" data-memory-lightbox aria-label="Photo preview">
    <button class="memory-lightbox-close" data-memory-lightbox-close type="button" aria-label="Close photo preview" autofocus>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8"></path>
      </svg>
    </button>
    <img class="memory-lightbox-image" data-memory-lightbox-image alt="" />
  </dialog>
</section>

<style>
  .memory-page {
    --memory-surface: var(--home-background, var(--color-neutral-50));
    min-height: 100svh;
    overflow-x: clip;
    background: var(--memory-surface);
    color: var(--home-ink, var(--color-neutral-800));
  }

  .memory-page.is-overlay {
    position: fixed;
    inset: 0;
    z-index: 45;
    overflow: hidden auto;
    overscroll-behavior-y: contain;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms var(--ease-out);
  }

  .memory-page.is-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .memory-page.is-carrying [data-memory-visual-target] {
    visibility: hidden;
  }

  .memory-header,
  .memory-intro,
  .memory-archive {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .memory-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
    text-align: right;
  }

  .memory-header h1,
  .memory-month-header h3 {
    font-size: 0.875rem;
    font-weight: 550;
  }

  .memory-header p,
  .memory-month-header time {
    font-size: 0.75rem;
    color: var(--home-muted, var(--color-neutral-500));
  }

  .memory-header p { margin-top: 0.125rem; }

  .memory-intro {
    --lens-size: clamp(20rem, 43vw, 28rem);
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    margin-block-start: clamp(1.35rem, 4.5svh, 3rem);
    padding-block: clamp(3.5rem, 6vw, 4.75rem) .8rem;
    text-align: center;
    pointer-events: none;
  }

  .memory-lens {
    --lens-mask: linear-gradient(#000 48%, rgb(0 0 0 / 0.88) 58%, transparent 86%);
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    width: var(--lens-size);
    aspect-ratio: 1;
    translate: -50% var(--memory-lens-y, 0px);
  }

  .memory-lens-glass {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    mask-image: var(--lens-mask);
    opacity: var(--memory-lens-opacity, 1);
    background:
      radial-gradient(closest-side, transparent 96.5%, rgb(127 127 127 / .045) 98.4%,
        rgb(127 127 127 / .2) calc(100% - 1px), rgb(255 255 255 / .42) calc(100% - .45px), transparent),
      radial-gradient(closest-side, var(--memory-surface) 70%,
        color-mix(in srgb, var(--memory-surface) 93%, transparent) 80%,
        color-mix(in srgb, var(--memory-surface) 62%, transparent) 94%, transparent);
  }

  .memory-lens::before {
    content: "";
    position: absolute;
    inset: -0.875rem;
    border-radius: 50%;
    background: conic-gradient(from -78deg, currentColor var(--memory-lens-angle, 0deg), rgb(127 127 127 / .3) 0);
    opacity: calc(.64 * var(--memory-lens-opacity, 1));
    mask: repeating-conic-gradient(#000 0 .2deg, transparent .2deg 3.75deg),
      radial-gradient(closest-side, transparent calc(100% - 7px), #000 calc(100% - 6px) calc(100% - 1px), transparent),
      var(--lens-mask);
    mask-composite: intersect;
  }

  .memory-lens-filter {
    position: absolute;
  }

  @media (min-width: 48rem) and (pointer: fine) {
    .memory-lens-glass { backdrop-filter: blur(5px) saturate(1.13); }
    .memory-lens[data-refract] .memory-lens-glass {
      backdrop-filter: var(--memory-refraction) saturate(1.13);
    }
  }

  .memory-intro-copy {
    position: relative;
  }

  .memory-intro h2 {
    max-width: 14ch;
    margin-inline: auto;
    font-size: clamp(2rem, 4.25vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .memory-intro p {
    max-width: 32ch;
    margin-inline: auto;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--home-muted, var(--color-neutral-500));
  }

  .memory-archive {
    margin-block-start: .625rem;
    padding-block-end: max(4rem, 14svh);
  }

  .memory-month + .memory-month {
    margin-block-start: clamp(3.5rem, 9vw, 7rem);
  }

  .memory-month-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    margin-block-end: 0.35rem;
    align-items: center;
  }

  .memory-month-details {
    display: flex;
    align-items: center;
    gap: .5rem;
  }

  .memory-month[data-memory-spacing] { position: relative; }

  .memory-rolls {
    --memory-photo-gap: clamp(0.5rem, 1.4vw, 1.125rem);
    --memory-roll-gap: clamp(1rem, 2.4vw, 2rem);
    display: grid;
    gap: var(--memory-roll-gap);
  }

  .memory-roll {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--memory-photo-gap);
    list-style: none;
  }

  .memory-month[data-memory-spacing-active] > .memory-rolls { cursor: crosshair; }

  .memory-roll[data-memory-unfold] > li {
    translate:
      calc((var(--memory-h, 1) - 1) * var(--memory-photo-gap) * var(--memory-column))
      calc((var(--memory-v, 1) - 1) * var(--memory-photo-gap) * var(--memory-row));
  }

  .memory-roll[data-memory-unfold]:nth-child(2) {
    translate: 0 calc((var(--memory-v, 1) - 1) * var(--memory-roll-gap));
  }

  .memory-spacing-pad {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline-end: -10px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--home-muted, var(--color-neutral-500));
    cursor: grab;
    touch-action: none;
  }

  .memory-spacing-pad[hidden] { display: none; }
  .memory-spacing-pad:focus-visible { outline: 2px solid currentColor; outline-offset: -3px; }
  .memory-spacing-pad:active { cursor: grabbing; }

  .memory-spacing-pad span {
    display: block;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: radial-gradient(circle, currentColor 0 2px, transparent 2.5px),
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat,
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat;
  }

  .memory-spacing-hud {
    --hairline: color-mix(in srgb, currentColor 22%, transparent);
    position: absolute;
    z-index: 3;
    inset: 0;
    overflow: clip;
    opacity: 0;
    transition: opacity 160ms var(--ease-out);
    pointer-events: none;
  }

  [data-memory-spacing-active] .memory-spacing-hud { opacity: 1; }

  .memory-spacing-hud::before,
  .memory-spacing-hud::after {
    content: "";
    position: absolute;
    background: var(--hairline);
  }

  .memory-spacing-hud::before { inset: 0 auto 0 var(--hud-x); width: 1px; }
  .memory-spacing-hud::after { inset: var(--hud-y) 0 auto; height: 1px; }

  .memory-spacing-dot {
    position: absolute;
    top: var(--hud-y);
    left: var(--hud-x);
    width: 7px;
    height: 7px;
    z-index: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px var(--hairline);
  }

  .memory-spacing-readout {
    position: absolute;
    z-index: 1;
    left: clamp(0px, calc(var(--hud-x) + 14px), calc(100% - 7.5rem));
    top: clamp(0px, calc(var(--hud-y) + 10px), calc(100% - 1.75rem));
    padding: .2rem .45rem;
    border-radius: .3rem;
    background: var(--memory-surface);
    font: 500 .7rem / 1.4 ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
    white-space: pre;
  }

  @media (max-width: 48rem) {
    .memory-intro {
      --lens-size: clamp(18rem, 88vw, 25rem);
      padding-block-start: 3.8rem;
    }
    .memory-lens { --lens-mask: linear-gradient(#000 55%, rgb(0 0 0 / 0.86) 63%, transparent 84%); }
    .memory-lens-glass {
      background-image: radial-gradient(closest-side, var(--memory-surface) 76%,
        rgb(from var(--memory-surface) r g b / .85) 88%, rgb(from var(--memory-surface) r g b / 0));
    }
  }

  .memory-photo {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-neutral-100);
    cursor: zoom-in;
  }

  .memory-photo:focus-visible,
  .memory-lightbox-close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .memory-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  :global(html:has(.memory-lightbox[open])),
  .memory-page.is-overlay:has(.memory-lightbox[open]) {
    overflow: hidden;
  }

  .memory-lightbox {
    --preview-top: max(3.75rem, calc(env(safe-area-inset-top) + 3rem));
    --preview-bottom: max(1.25rem, env(safe-area-inset-bottom));
    box-sizing: border-box;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--preview-top) clamp(1rem, 4vw, 3rem) var(--preview-bottom);
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .memory-lightbox[open] {
    display: grid;
    place-items: center;
  }

  .memory-lightbox::backdrop {
    background: rgb(13 13 14 / 0.93);
    transition: opacity 220ms var(--ease-out);
    animation: memory-backdrop-in 220ms var(--ease-out);
  }

  .memory-lightbox[data-closing]::backdrop {
    opacity: 0;
  }

  .memory-lightbox-image {
    display: block;
    width: min(100%, var(--preview-width), calc(var(--preview-ratio) * (100dvh - var(--preview-top) - var(--preview-bottom))));
    height: auto;
    aspect-ratio: var(--preview-ratio);
    border-radius: 0.375rem;
    object-fit: contain;
  }

  .memory-lightbox-close {
    position: fixed;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    color: white;
    background: rgb(255 255 255 / 0.1);
    cursor: pointer;
  }

  .memory-lightbox-close svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  @keyframes memory-backdrop-in {
    from { opacity: 0; }
  }

  @media (hover: hover) {
    .memory-lightbox-close:hover { background: rgb(255 255 255 / 0.2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .memory-page.is-overlay { transition-duration: 120ms; }
    .memory-lightbox::backdrop { animation: none; transition: none; }
    .memory-spacing-hud { transition: none; }
  }
</style>

<script>
  import { mountMemorySpacing } from "../scripts/memory-spacing";

  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const desktopGlass = matchMedia("(min-width: 48rem) and (pointer: fine)");
  const clamp = (value: number) => Math.max(0, Math.min(1, value));
  const ease = (value: number) => value * value * (3 - 2 * value);

  const refractionMap = () => {
    const canvas = document.createElement("canvas");
    const size = 160;
    canvas.width = canvas.height = size;
    const context = canvas.getContext("2d");
    if (!context) return "";
    const image = context.createImageData(size, size);
    for (let y = 0; y < size; y++) {
      for (let x = 0; x < size; x++) {
        const dx = 2 * (x + 0.5) / size - 1;
        const dy = 2 * (y + 0.5) / size - 1;
        const radius = Math.hypot(dx, dy);
        const edge = radius < 1 ? clamp((radius - 0.84) / 0.16) ** 2 : 0;
        const i = (y * size + x) * 4;
        image.data[i] = Math.round(128 - dx * edge * 127);
        image.data[i + 1] = Math.round(128 - dy * edge * 127);
        image.data[i + 2] = 128;
        image.data[i + 3] = 255;
      }
    }
    context.putImageData(image, 0, 0);
    return canvas.toDataURL();
  };

  document.querySelectorAll<HTMLElement>("[data-memory-stage]").forEach((stage) => {
    const lightbox = stage.querySelector<HTMLDialogElement>("[data-memory-lightbox]")!;
    const image = stage.querySelector<HTMLImageElement>("[data-memory-lightbox-image]")!;
    const close = stage.querySelector<HTMLButtonElement>("[data-memory-lightbox-close]")!;
    const isOverlay = stage.dataset.memoryStage === "overlay";
    const scrollRoot = isOverlay ? stage : document.documentElement;
    const rolls = [...stage.querySelectorAll<HTMLOListElement>("[data-memory-unfold]")];
    const spacing = stage.querySelector<HTMLElement>("[data-memory-spacing]");
    if (spacing) mountMemorySpacing(spacing, stage, reduced);
    const lens = stage.querySelector<HTMLElement>("[data-memory-lens]")!;
    const filter = stage.querySelector<SVGFilterElement>(".memory-lens-filter filter")!;
    const map = filter.querySelector<SVGFEImageElement>("feImage")!;
    const displacement = filter.querySelector<SVGFEDisplacementMapElement>("feDisplacementMap")!;
    let diameter = 0;
    let tiles: { photo: HTMLAnchorElement; x: number; y: number; angle: number; scale: number; delay: number }[] = [];
    let lastProgress = -1;
    let travel = 0;
    let frame = 0;
    let opener: HTMLAnchorElement | null = null;
    let previewScroll = 0;
    let flight: Animation | undefined;

    const paint = () => {
      frame = 0;
      if (isOverlay && !stage.classList.contains("is-open")) return;
      const y = isOverlay ? stage.scrollTop : window.scrollY;
      const animateIntro = !reduced.matches && travel >= 32;
      const progress = animateIntro ? clamp(y / travel) : 0;
      if (progress === lastProgress) return;
      lastProgress = progress;

      lens.style.setProperty("--memory-lens-angle", `${156 * progress}deg`);
      lens.style.setProperty("--memory-lens-y", `${-12 * progress}px`);
      lens.style.setProperty("--memory-lens-opacity", String(1 - ease(clamp((progress - 0.18) / 0.82))));

      for (const { photo, x, y, angle, scale, delay } of tiles) {
        const fold = animateIntro ? 1 - ease(clamp((progress - delay) / (1 - delay))) : 0;
        photo.style.transform = fold === 0 ? "" :
          `translate(${x * fold}%, ${y * fold}px) rotate(${angle * fold}deg) scale(${1 - scale * fold})`;
      }
    };

    const measure = () => {
      if (desktopGlass.matches && navigator.userAgent.includes("Chrome/")) {
        const width = lens.offsetWidth;
        if (width && width !== diameter) {
          if (!map.getAttribute("href")) {
            const data = refractionMap();
            if (data) map.setAttribute("href", data);
          }
          if (map.getAttribute("href")) {
            diameter = width;
            for (const node of [filter, map]) {
              node.setAttribute("width", String(width));
              node.setAttribute("height", String(width));
            }
            displacement.setAttribute("scale", String(width * 0.082));
            lens.setAttribute("data-refract", "");
          }
        }
      }
      const depth = stage.clientWidth > 768 ? 1 : 0.65;
      tiles = rolls.flatMap((roll, rollIndex) => {
        return [...roll.querySelectorAll<HTMLAnchorElement>("[data-memory-photo]")].map((photo, i) => {
          const side = i % 2 === 0 ? -1 : 1;
          const row = Math.floor(i / 2);
          return {
            photo,
            x: side * -5 * depth,
            y: (side * 9 + row * 5) * depth,
            angle: side * 5 * depth,
            scale: 0.11 * depth,
            delay: Math.min(0.24, row * 0.075 + rollIndex * 0.13 + (side === 1 ? 0.035 : 0)),
          };
        });
      });
      travel = Math.round(Math.min(scrollRoot.clientHeight * 0.44, scrollRoot.scrollHeight - scrollRoot.clientHeight));
      lastProgress = -1;
      cancelAnimationFrame(frame);
      paint();
    };

    const requestPaint = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };

    const thumbnailPose = (photo: HTMLAnchorElement, preview: DOMRect) => {
      const rect = photo.getBoundingClientRect();
      const matrix = new DOMMatrix(getComputedStyle(photo).transform);
      const x = rect.left + rect.width / 2 - preview.left - preview.width / 2;
      const y = rect.top + rect.height / 2 - preview.top - preview.height / 2;
      const scale = Math.hypot(matrix.a, matrix.b) * photo.offsetWidth / preview.width;
      const angle = Math.atan2(matrix.b, matrix.a) * 180 / Math.PI;
      return `translate(${x}px, ${y}px) rotate(${angle}deg) scale(${scale})`;
    };

    const closePreview = () => {
      if (!lightbox.open || lightbox.hasAttribute("data-closing")) return;
      if (reduced.matches || !opener) {
        lightbox.close();
        return;
      }

      const current = getComputedStyle(image).transform;
      flight?.cancel();
      const target = thumbnailPose(opener, image.getBoundingClientRect());
      lightbox.setAttribute("data-closing", "");
      flight = image.animate([{ transform: current }, { transform: target }], {
        duration: 240, easing: "cubic-bezier(.4, 0, .25, 1)", fill: "forwards",
      });
      flight.onfinish = () => lightbox.close();
    };

    stage.querySelectorAll<HTMLAnchorElement>("[data-memory-photo]").forEach((photo) => {
      photo.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const thumbnail = photo.querySelector("img")!;
        opener = photo;
        previewScroll = isOverlay ? stage.scrollTop : window.scrollY;
        image.src = photo.href;
        image.alt = thumbnail.alt;
        const width = Number(thumbnail.getAttribute("width"));
        const height = Number(thumbnail.getAttribute("height"));
        image.style.setProperty("--preview-width", `${width}px`);
        image.style.setProperty("--preview-ratio", String(width / height));
        lightbox.showModal();
        if (!reduced.matches) {
          const from = thumbnailPose(photo, image.getBoundingClientRect());
          flight = image.animate([{ transform: from }, { transform: "none" }], {
            duration: 290, easing: "cubic-bezier(.2, .75, .25, 1)",
          });
        }
      });
    });

    close.addEventListener("click", closePreview);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closePreview();
    });
    lightbox.addEventListener("cancel", (event) => {
      event.preventDefault();
      closePreview();
    });
    lightbox.addEventListener("close", () => {
      flight?.cancel();
      lightbox.removeAttribute("data-closing");
      if (!stage.inert && opener) {
        opener.focus({ preventScroll: true });
        (isOverlay ? stage : window).scrollTo({ top: previewScroll, behavior: "instant" });
      }
      opener = null;
    });
    window.addEventListener("keydown", (event) => {
      if (!lightbox.open || event.key !== "Escape") return;
      event.preventDefault();
      event.stopImmediatePropagation();
      closePreview();
    }, { capture: true });

    (isOverlay ? stage : window).addEventListener("scroll", requestPaint, { passive: true });
    const resize = new ResizeObserver(measure);
    resize.observe(stage);
    resize.observe(stage.querySelector(".memory-archive")!);
    stage.addEventListener("memory-layout", measure);
    desktopGlass.addEventListener("change", measure);
    reduced.addEventListener("change", measure);
    window.addEventListener("pageshow", measure);
    measure();
  });
</script>
