<div class="theme-control">
  <button class="theme-dial" type="button" data-theme-dial aria-label="Theme: System. Switch to Light">
    <svg class="theme-orbit" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
      <defs>
        <mask id="theme-eclipse" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32">
          <rect width="32" height="32" fill="white" />
          <circle class="theme-shadow" cx="26" cy="6" r="9.5" fill="black" />
        </mask>
      </defs>
      <g class="theme-rays" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M16 2.5v3M16 26.5v3M2.5 16h3M26.5 16h3M6.45 6.45l2.12 2.12M23.43 23.43l2.12 2.12M6.45 25.55l2.12-2.12M23.43 8.57l2.12-2.12" />
      </g>
      <g mask="url(#theme-eclipse)">
        <circle cx="16" cy="16" r="9.5" fill="currentColor" />
        <path class="theme-half" d="M16 6.5a9.5 9.5 0 0 0 0 19Z" fill="#000" />
        <circle class="theme-system-ring" cx="16" cy="16" r="9.5" fill="none" stroke="currentColor" stroke-width="1.2" />
      </g>
      <text class="theme-auto" x="26" y="28" text-anchor="middle" fill="currentColor">A</text>
    </svg>
    <span class="theme-label" data-theme-label aria-hidden="true">System</span>
  </button>
  <span class="sr-only" data-theme-status role="status" aria-live="polite"></span>
</div>

<style>
  .theme-control { position: relative; flex: none; width: 44px; height: 44px; }
  .theme-dial { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; color: #fff; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .theme-dial:focus-visible { outline: 2px solid white; outline-offset: 2px; background: rgb(255 255 255 / .08); }
  .theme-orbit { overflow: visible; transition: transform 200ms var(--ease-out); }
  .theme-dial:active .theme-orbit { transform: translateY(1px) scale(.88) rotate(12deg); }
  .theme-rays { opacity: 0; transform: scale(.65) rotate(40deg); transform-origin: 16px 16px; transition: opacity 160ms ease, transform 350ms var(--ease-out); }
  .theme-shadow { transform: translate(16px, -16px); transition: transform 350ms cubic-bezier(.65,0,.35,1); }
  .theme-half, .theme-system-ring, .theme-auto { opacity: 1; transition: opacity 180ms ease; }
  .theme-auto { font-family: inherit; font-size: 7px; font-weight: 600; }
  :global(html[data-home-mode="light"]) .theme-rays { opacity: 1; transform: scale(1) rotate(0deg); }
  :global(html[data-home-mode="dark"]) .theme-shadow { transform: translate(-4.5px, 4.5px); }
  :global(html:not([data-home-mode="system"])) :is(.theme-half, .theme-system-ring, .theme-auto) { opacity: 0; }
  .theme-label { position: absolute; right: -4px; bottom: calc(100% + 10px); padding: 6px 10px; border: 1px solid rgb(255 255 255 / .12); border-radius: 10px; color: #fff; background: #191919; font-size: 11px; line-height: 16px; white-space: nowrap; pointer-events: none; opacity: 0; transform: translateY(4px); transition: opacity 120ms ease, transform 160ms var(--ease-out); }
  .theme-dial:is([data-hint], :focus-visible) .theme-label { opacity: 1; transform: none; }
  @media (hover: hover) and (pointer: fine) {
    .theme-dial:hover .theme-orbit { transform: rotate(-8deg) scale(1.08); }
    .theme-dial:hover .theme-label { opacity: 1; transform: none; }
    .theme-dial:active .theme-orbit { transform: translateY(1px) scale(.88) rotate(12deg); }
  }
  .theme-dial[data-instant] * { transition: none; }
  @media (prefers-reduced-motion: reduce) { .theme-dial * { transition: none; } }
</style>

<style is:global>
  html[data-theme-transition] .home-dock-wrap { view-transition-name: theme-dock; }
  html[data-theme-transition]::view-transition-group(root),
  html[data-theme-transition]::view-transition-group(theme-dock) { animation: none; }
  html[data-theme-transition]::view-transition-old(root),
  html[data-theme-transition]::view-transition-new(root),
  html[data-theme-transition]::view-transition-new(theme-dock) { animation: none; mix-blend-mode: normal; }
  html[data-theme-transition]::view-transition-new(root) { z-index: 1; }
  html[data-theme-transition]::view-transition-group(theme-dock) { z-index: 2; }
  html[data-theme-transition]::view-transition-old(theme-dock) { display: none; }
  html[data-theme-transition]::view-transition { pointer-events: none; }
</style>

<script>
  import { mountThemeDial } from "../scripts/theme-dial";
  mountThemeDial();
</script>
