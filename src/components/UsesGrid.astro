---
import { folderPreviewUses, hardwareUses, useSections } from "../data/uses";

interface Props {
  mode: "overlay" | "standalone";
}

const { mode } = Astro.props;
const isOverlay = mode === "overlay";
---

<div
  class:list={["uses-stage", !isOverlay && "is-open"]}
  data-uses-stage={isOverlay ? "overlay" : "standalone"}
  aria-hidden={isOverlay ? "true" : undefined}
>
  <header class="uses-bar">
    <div>
      <h1 class="text-sm font-medium text-neutral-800">What I Use</h1>
      <p class="mt-0.5 text-xs text-neutral-500">Tools I use every day</p>
    </div>
    {
      isOverlay ? (
        <button class="uses-close" data-uses-close type="button" aria-label="Close">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round" />
          </svg>
        </button>
      ) : (
        <a class="uses-close" href="/" aria-label="Back">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round" />
          </svg>
        </a>
      )
    }
  </header>

  <main class="uses-content">
    {
      useSections.map((section, sectionIndex) => (
        <section
          class:list={[sectionIndex > 0 && "uses-section"]}
          aria-labelledby={`${section.title.toLowerCase()}-${mode}`}
        >
          <h2 id={`${section.title.toLowerCase()}-${mode}`} class="uses-heading">
            {section.title}
          </h2>
          {section.groups.map((group, groupIndex) => (
            <div class:list={["uses-group", groupIndex > 0 && "uses-group-spaced"]}>
              {group.title && <h3 class="uses-subheading">{group.title}</h3>}
              <div class="uses-row">
                {
                  group.items.map((item) => {
                    const previewIndex = folderPreviewUses.indexOf(item);
                    const isPreview = previewIndex >= 0;

                    return (
                      <a
                        class:list={[
                          "uses-card software-card",
                          item.visualTreatment === "banner" && "banner-card",
                        ]}
                        data-use-reveal={!isPreview ? "" : undefined}
                        href={item.href}
                        target="_blank"
                        rel="noreferrer"
                      >
                        <span
                          class:list={[
                            "software-logo-wrap",
                            item.visualTreatment === "banner" && "is-banner",
                          ]}
                          data-use-logo-target={isPreview ? String(previewIndex) : undefined}
                        >
                          <img
                            data-use-preview-logo={isPreview ? "" : undefined}
                            src={item.logo}
                            alt=""
                            loading={isPreview ? "eager" : "lazy"}
                          />
                        </span>
                        <span class="software-details">
                          <span class="software-copy">
                            <span class="software-title-row">
                              <span class="software-name">{item.name}</span>
                              {item.badge && <span class="software-badge">{item.badge}</span>}
                            </span>
                            <span class="software-slogan">{item.slogan}</span>
                          </span>
                          <svg
                            viewBox="0 0 16 16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            aria-hidden="true"
                          >
                            <path
                              d="M5 11 11 5M6 5h5v5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                      </a>
                    );
                  })
                }
              </div>
            </div>
          ))}
        </section>
      ))
    }

    <section class="hardware-section" data-use-reveal aria-labelledby={`hardware-${mode}`}>
      <h2 id={`hardware-${mode}`} class="uses-heading">Hardware</h2>
      <div class="uses-row">
        {
          hardwareUses.map((item) => (
            <article class="uses-card hardware-card">
              <div class="hardware-visual">
                <img
                  src={item.image}
                  alt=""
                  class={item.visualTreatment}
                  loading="lazy"
                />
              </div>
              <p class="card-label"><span>{item.name}</span></p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</div>

<style>
  .uses-stage {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow-y: auto;
    background: rgb(250 250 250);
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms var(--ease-out);
  }

  .uses-stage.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .uses-bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: start;
    justify-content: space-between;
    padding: 1.5rem 1.5rem 2rem;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(250 250 250) 0%,
      rgb(250 250 250 / 0.96) 68%,
      transparent 100%
    );
  }

  .uses-bar > * {
    pointer-events: auto;
  }

  .uses-close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-neutral-500);
    background: rgb(255 255 255 / 0.78);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.05);
    transition:
      color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .uses-close svg {
    width: 1rem;
    height: 1rem;
  }

  .uses-close:active {
    transform: scale(0.94);
  }

  .uses-content {
    --uses-gutter: clamp(1rem, 5vw, 6rem);

    width: 100%;
    padding: 6.5rem 0 5rem var(--uses-gutter);
  }

  .uses-heading {
    margin-bottom: 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-neutral-500);
  }

  .uses-section {
    margin-top: 2.75rem;
  }

  .uses-group-spaced {
    margin-top: 1.5rem;
  }

  .uses-subheading {
    margin-bottom: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-neutral-400);
  }

  .uses-row {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    margin-block: -0.25rem;
    padding: 0.25rem var(--uses-gutter) 0.25rem 0;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: 0.25rem;
    scroll-snap-type: inline proximity;
    scrollbar-width: none;
  }

  .uses-row::-webkit-scrollbar {
    display: none;
  }

  .uses-row > .uses-card {
    flex: 0 0 clamp(10.75rem, 28vw, 16rem);
    scroll-snap-align: start;
  }

  .hardware-section {
    margin-top: 2.75rem;
  }

  .uses-card {
    min-width: 0;
    overflow: hidden;
    border-radius: 1.125rem;
    background: rgb(255 255 255 / 0.82);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.045),
      0 2px 4px rgb(0 0 0 / 0.035),
      0 10px 22px rgb(0 0 0 / 0.05);
  }

  .software-card {
    position: relative;
    display: flex;
    min-height: 7.25rem;
    flex-direction: column;
    justify-content: flex-start;
    padding: 0.875rem;
    outline: none;
    transition:
      transform 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }

  .software-logo-wrap {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    align-items: flex-start;
    justify-content: flex-start;
    margin-bottom: 0.625rem;
    border-radius: 0.8rem;
  }

  .software-logo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.1));
  }

  .banner-card {
    padding: 0.5rem 0.75rem 0.75rem;
  }

  .software-logo-wrap.is-banner {
    width: 100%;
    height: auto;
    aspect-ratio: 512 / 269;
    margin-bottom: 0.75rem;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .software-logo-wrap.is-banner img {
    object-fit: cover;
    filter: none;
  }

  .banner-card .software-details svg {
    right: 0.75rem;
    bottom: 0.75rem;
  }

  .banner-card .software-title-row {
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .banner-card .software-name {
    order: 2;
    flex-basis: 100%;
  }

  .banner-card .software-badge {
    order: 1;
  }

  .uses-stage.is-carrying [data-use-preview-logo] {
    opacity: 0;
  }

  .software-details {
    min-width: 0;
  }

  .software-copy {
    display: grid;
    min-width: 0;
    gap: 0.125rem;
    padding-right: 1.5rem;
  }

  .software-name {
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-neutral-800);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .software-title-row {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.375rem;
  }

  .software-badge {
    flex: none;
    padding: 0.125rem 0.375rem;
    border-radius: 999px;
    font-size: 0.5rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: #6b4f00;
    background: #ffe28a;
  }

  .software-slogan {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.6875rem;
    line-height: 1.25;
    color: var(--color-neutral-500);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .software-details svg {
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    width: 1rem;
    height: 1rem;
    color: var(--color-neutral-400);
  }

  .card-label {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-neutral-800);
  }

  .card-label span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-label svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--color-neutral-400);
  }

  .hardware-card {
    padding: 0.5rem 0.5rem 0.875rem;
  }

  .hardware-visual {
    position: relative;
    display: grid;
    aspect-ratio: 3 / 2;
    place-items: center;
    overflow: hidden;
    border-radius: 0.8rem;
    background: #f7f7f7;
  }

  .hardware-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hardware-visual .zoomed {
    transform: scale(1.65);
  }

  .hardware-card .card-label {
    padding: 0.75rem 0.375rem 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .uses-close:hover {
      color: var(--color-neutral-800);
    }

    .software-card:hover,
    .software-card:focus-visible {
      transform: translateY(-2px);
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.05),
        0 4px 9px rgb(0 0 0 / 0.05),
        0 20px 38px rgb(0 0 0 / 0.08);
    }
  }

  @media (max-width: 480px) {
    .uses-content {
      padding-top: 5.75rem;
    }

    .uses-card {
      border-radius: 1rem;
    }

    .software-card {
      min-height: 6.75rem;
      padding: 0.75rem;
    }

    .software-logo-wrap {
      width: 2.25rem;
      height: 2.25rem;
      margin-bottom: 0.5rem;
      border-radius: 0.7rem;
    }

    .software-details svg {
      right: 0.75rem;
      bottom: 0.75rem;
    }

    .card-label {
      font-size: 0.8125rem;
    }

    .software-name {
      font-size: 0.8125rem;
    }

    .software-slogan {
      font-size: 0.625rem;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-uses-stage="standalone"]')
    .forEach((standalone) => {
      addEventListener("keydown", (event) => {
        if (event.key === "Escape") location.assign("/");
      });
    });
</script>
