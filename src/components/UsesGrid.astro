---
import ParentLink from "./ParentLink.astro";
import GrokBotMark from "./GrokBotMark.astro";
import UsesShelf from "./UsesShelf";

interface Props { mode: "overlay" | "standalone"; }
const { mode } = Astro.props;
const isOverlay = mode === "overlay";
---

{!isOverlay && <script is:inline>
  let usesMode = "system";
  try {
    const saved = localStorage.getItem("home-theme");
    if (["system", "light", "dark"].includes(saved)) usesMode = saved;
  } catch {}
  document.documentElement.dataset.homeMode = usesMode;
  document.documentElement.dataset.homeTheme = usesMode === "system"
    ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : usesMode;
</script>}

<div class:list={["uses-stage", !isOverlay && "is-open"]} data-uses-stage={mode} aria-hidden={isOverlay ? "true" : undefined} inert={isOverlay ? true : undefined}>
  <header class="uses-bar">
    <ParentLink label="Home" href={isOverlay ? undefined : "/"} {...(isOverlay ? {"data-uses-close": ""} : {})} />
    <div><h1>What I Use</h1><p>Tools I use every day</p></div>
  </header>
  <main class="uses-content"><UsesShelf mode={mode} client:load /></main>
  <div hidden data-uses-grok-storage><GrokBotMark /></div>
</div>

<style>
  .uses-stage {
    --uses-paper: #f7f7f8; --uses-ink: #202221; --uses-muted: #747474; --uses-accent: #316ff0;
    --uses-shade-soft: oklch(.3 .03 66 / .2); --uses-shade-hard: oklch(.22 .03 66 / .5);
    position: fixed; inset: 0; z-index: 40; overflow-y: auto; overflow-x: clip;
    background: var(--uses-paper); color: var(--uses-ink); opacity: 0; pointer-events: none;
    transition: opacity 240ms var(--ease-out); overscroll-behavior: contain; scrollbar-width: thin;
  }
  .uses-stage.is-open { opacity: 1; pointer-events: auto; }
  :global(html[data-home-theme="dark"]) .uses-stage {
    --uses-paper: #171719; --uses-ink: #f3f3f5; --uses-muted: #a1a1aa; --uses-accent: #8ab4ff;
    --uses-shade-soft: oklch(0 0 0 / .5); --uses-shade-hard: oklch(0 0 0 / .8);
    color-scheme: dark;
  }
  .uses-bar {
    position: fixed; inset: 0 0 auto; z-index: 10; display: flex; align-items: center; justify-content: space-between;
    padding: 24px 24px 28px; pointer-events: none; text-align: right;
    background: linear-gradient(var(--uses-paper) 0%,color-mix(in srgb,var(--uses-paper) 96%,transparent) 68%,transparent 100%);
  }
  .uses-bar > * { pointer-events: auto; }
  .uses-bar h1 { font-size: 14px; font-weight: 500; }
  .uses-bar p { margin-top: 2px; color: var(--uses-muted); font-size: 12px; }
  .uses-bar :global(.parent-link) { color: var(--uses-muted); }
  .uses-bar :global(.parent-link:hover),.uses-bar :global(.parent-link-arrow) { color: var(--uses-ink); }
  .uses-content { width: 100%; max-width: 1180px; margin: 0 auto; padding: 124px 28px 72px; }
  @media(max-width:560px) {
    .uses-bar { padding: 20px 14px 24px; }
    .uses-content { padding: 116px 18px 48px; }
  }
  @media(prefers-reduced-motion:reduce) { .uses-stage { transition:none; } }
</style>

<script>
  const standalone = document.querySelector<HTMLElement>('[data-uses-stage="standalone"]');
  if (standalone) {
    addEventListener("keydown", event => { if (event.key === "Escape") location.assign("/"); });
    const system = matchMedia("(prefers-color-scheme: dark)");
    system.addEventListener("change", () => {
      if (document.documentElement.dataset.homeMode === "system") document.documentElement.dataset.homeTheme = system.matches ? "dark" : "light";
    });
  }
</script>
