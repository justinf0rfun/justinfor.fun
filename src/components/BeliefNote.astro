---
import BeliefSticker from "./BeliefSticker";
---

<section class="belief-notes" aria-label="Things I believe">
  <figure class="belief-note belief-note--ideas">
    <div class="note-paper">
      <BeliefSticker
        src="/home/acu-note.png"
        alt="Everyone has ideas. Few have the discipline to turn them into reality."
        width={792}
        height={856}
        backColor="#e7dfca"
        client:visible
      />
    </div>
    <figcaption>
      via <a href="https://acu.sh/" target="_blank" rel="noopener noreferrer">Acu</a>
    </figcaption>
  </figure>

  <figure class="belief-note belief-note--iterate">
    <div class="note-paper note-paper--taped">
      <BeliefSticker
        src="/home/first-do-it.jpg"
        alt="First do it, then do it right, then do it better. Five colorful Dots characters sit beneath the words."
        width={1280}
        height={720}
        backColor="#18210f"
        client:visible
      />
    </div>
    <figcaption>
      via <a href="https://addyo.substack.com/p/first-do-it-then-do-it-right-then" target="_blank" rel="noopener noreferrer">Addy Osmani</a>
    </figcaption>
  </figure>

  <figure class="belief-note belief-note--value">
    <div class="note-paper note-paper--taped">
      <BeliefSticker
        src="/home/yc-make-something-people-want.jpg"
        alt="Make something people want. Y Combinator's motto in orange-red letters on warm white paper."
        width={960}
        height={1280}
        backColor="#eee7d8"
        client:visible
      />
    </div>
    <figcaption>
      via <a href="https://medium.com/@rudyadler/make-something-people-want-the-yc-watsi-poster-55b35d0e8a89" target="_blank" rel="noopener noreferrer">Rudy Adler</a>
    </figcaption>
  </figure>

  <figure class="belief-note belief-note--attention">
    <div class="note-paper note-paper--taped">
      <BeliefSticker
        src="/home/attention-is-all-you-need.jpg"
        alt="Attention Is All You Need. The Transformer paper above a mountain concert landscape."
        width={1025}
        height={1280}
        backColor="#dce3f3"
        client:visible
      />
    </div>
    <figcaption>
      via <a href="https://arxiv.org/abs/1706.03762" target="_blank" rel="noopener noreferrer">Vaswani et al.</a>
    </figcaption>
  </figure>

  <figure class="belief-note belief-note--bitter">
    <div class="note-paper note-paper--taped">
      <BeliefSticker
        src="/home/the-bitter-lesson.svg"
        alt="The Bitter Lesson. A typeset excerpt on general methods and computation, by Rich Sutton, 2019."
        width={720}
        height={960}
        backColor="#e5ddce"
        client:visible
      />
    </div>
    <figcaption>
      via <a href="https://www.cs.utexas.edu/~eunsol/courses/data/bitter_lesson.pdf" target="_blank" rel="noopener noreferrer">Rich Sutton</a>
    </figcaption>
  </figure>
</section>

<style>
  .belief-notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
    isolation: isolate;
    padding: 1.5rem 0.5rem 1rem;
    overflow: clip;
    overflow-clip-margin: 0.5rem;
  }

  .belief-note {
    position: relative;
    z-index: var(--note-layer);
    min-width: 0;
    margin: 0;
    transition: z-index 0s linear 600ms;
  }

  .belief-note:has(:focus-visible),
  .belief-note:has([data-peeling="true"]) {
    z-index: 10;
    transition-delay: 0s;
  }

  .belief-note--ideas {
    width: min(11rem, 64%);
    justify-self: start;
    margin-left: 0.75rem;
    --note-angle: -4deg;
    --note-layer: 3;
  }

  .belief-note--iterate {
    width: min(18rem, 90%);
    justify-self: end;
    margin-right: 0.5rem;
    --note-angle: 3deg;
    --note-layer: 2;
    --tape-wash: rgb(200 228 151 / 78%);
    --tape-angle: -5deg;
  }

  .belief-note--value {
    width: min(10.4rem, 58%);
    justify-self: end;
    margin: -0.5rem 1.25rem 0 0;
    --note-angle: 4deg;
    --note-layer: 4;
    --tape-wash: rgb(238 170 118 / 78%);
    --tape-angle: 4deg;
  }

  .belief-note--attention {
    width: min(12rem, 64%);
    justify-self: start;
    margin: 2rem 0 0 0.5rem;
    --note-angle: -4deg;
    --note-layer: 1;
    --tape-wash: rgb(170 188 226 / 78%);
    --tape-angle: -4deg;
  }

  .belief-note--bitter {
    width: min(11.6rem, 64%);
    justify-self: end;
    margin: -5rem 0.5rem 0 0;
    --note-angle: 4deg;
    --note-layer: 5;
    --tape-wash: rgb(210 194 165 / 78%);
    --tape-angle: 5deg;
  }

  .note-paper {
    position: relative;
    transform: translateY(var(--paper-lift, 0px)) rotate(var(--note-angle));
    transform-origin: 50% 9%;
    transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .note-paper--taped :global(.belief-sticker-static) {
    display: block;
    box-shadow: 0 2px 3px rgb(0 0 0 / 10%), 0 12px 20px -14px rgb(0 0 0 / 30%);
  }

  .note-paper--taped::before {
    position: absolute;
    top: -1rem;
    left: 41%;
    z-index: 1;
    width: 3.6rem;
    height: 1.4rem;
    content: "";
    pointer-events: none;
    background-image: linear-gradient(var(--tape-wash), var(--tape-wash)), url("/home/acu-note.png");
    /* Reuse the existing note's tape grain, tinted to the print beneath it. */
    background-size: 100% 100%, 260% auto;
    background-position: center, 45% top;
    background-repeat: no-repeat;
    clip-path: polygon(1% 7%, 16% 4%, 35% 7%, 55% 2%, 74% 5%, 98% 0, 100% 90%, 82% 96%, 60% 93%, 39% 100%, 20% 96%, 0 100%);
    box-shadow: inset 0 -1px rgb(0 0 0 / 8%);
    transform: translateX(-50%) rotate(var(--tape-angle));
    transition: opacity 180ms ease-out 500ms;
  }

  .note-paper--taped:has([data-peeling="true"])::before {
    opacity: 0;
    transition-delay: 0s;
  }

  .belief-note figcaption {
    margin-top: 0.75rem;
    color: color-mix(in srgb, var(--home-ink, #202221) 65%, transparent);
    font-size: 0.75rem;
    text-align: right;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms ease-out, visibility 0s linear 160ms;
  }

  .belief-note:has(:focus-visible) figcaption {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .belief-note figcaption a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.18em;
  }

  .belief-note figcaption a:hover {
    color: var(--home-ink, #202221);
  }

  @media (min-width: 40rem) {
    .belief-notes {
      gap: 0;
    }

    .belief-note {
      grid-area: 1 / 1;
    }

    .belief-note--ideas {
      width: 33%;
      margin: 2% 0 0 3%;
    }

    .belief-note--iterate {
      width: 56%;
      margin: 20% 12% 0 0;
      --note-angle: -3deg;
    }

    .belief-note--value {
      width: 29%;
      margin: 54% 7% 0 0;
    }

    .belief-note--attention {
      width: 37%;
      margin: 56% 0 0 4%;
    }

    .belief-note--bitter {
      width: 33%;
      justify-self: start;
      margin: 94% 0 0 32%;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .belief-note:hover {
      z-index: 10;
      transition-delay: 0s;
      --paper-lift: -0.35rem;
    }

    .belief-note:hover figcaption {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }
  }

  @media (min-width: 48rem) {
    .belief-notes {
      overflow-clip-margin: 4rem;
    }
  }

  @media (min-width: 64rem) {
    .belief-notes {
      overflow-clip-margin: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-paper,
    .belief-note figcaption {
      transition: none;
    }

    .belief-note,
    .belief-note:hover {
      --paper-lift: 0px;
    }
  }
</style>
