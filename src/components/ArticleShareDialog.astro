---
import { Icon } from "astro-icon/components";
import { articleShareTargets, type ArticleInfo } from "../lib/article-sharing";

interface Props { article: ArticleInfo }
const { article } = Astro.props;
---

<dialog class="article-share-dialog" data-article-share aria-labelledby="article-share-title">
  <div class="article-share-card" data-share-card data-copy-surface>
    <header>
      <h2 id="article-share-title">Share article</h2>
      <button class="article-share-close" type="button" data-share-close aria-label="Close share dialog" autofocus>
        <Icon name="ph:x" />
      </button>
    </header>

    <div class="article-share-papers" data-share-papers aria-hidden="true">
      <div class="article-share-sheet article-share-sheet--back" data-share-sheet />
      <div class="article-share-sheet article-share-sheet--middle" data-share-sheet />
      <div class="article-share-sheet article-share-sheet--front">
        <div class="article-share-print" data-share-print>
          <p class="article-share-paper-title">{article.title}</p>
          <p class="article-share-paper-description">{article.description}</p>
        </div>
      </div>
    </div>

    <div class="article-share-targets" aria-label="Share destinations">
      {articleShareTargets(article).map(({ label, icon, href }) => (
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`Share via ${label}`}>
          <Icon name={icon} />
        </a>
      ))}
    </div>

    <div class="article-share-link">
      <span>{article.url.replace(/^https?:\/\//, "")}</span>
      <button type="button" data-article-copy="link" aria-label="Copy link">
        <span class="article-copy-icon"><Icon name="ph:copy" /></span>
        <span class="article-copy-check"><Icon name="ph:check" /></span>
      </button>
    </div>
    <p class="article-share-status sr-only" data-copy-status role="status" aria-live="polite" aria-atomic="true" />
  </div>
</dialog>

<style>
  .article-share-dialog {
    width: min(28rem, calc(100% - 3rem));
    max-height: calc(100svh - 3rem);
    margin: auto;
    padding: 0.25rem;
    overflow-y: auto;
    border: 0;
    border-radius: 1rem;
    color: #202020;
    background: #fafafa;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 6%), 0 2px 4px rgb(0 0 0 / 4%), 0 16px 48px rgb(0 0 0 / 9%);
  }

  .article-share-dialog::backdrop {
    background: rgb(255 255 255 / 75%);
    backdrop-filter: blur(12px);
    opacity: 1;
    transition: opacity 200ms ease-out;
  }

  @starting-style {
    .article-share-dialog[open]::backdrop { opacity: 0; }
  }

  .article-share-dialog[data-closing]::backdrop { opacity: 0; }

  .article-share-card {
    padding: 1.25rem;
    border: 1px solid #e8e8e8;
    border-radius: 0.75rem;
    background: white;
  }

  header { display: flex; align-items: center; justify-content: space-between; }
  h2 { font-size: 1rem; font-weight: 500; }

  .article-share-close {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: -0.375rem;
    place-items: center;
    border-radius: 50%;
    color: #747474;
    cursor: pointer;
  }

  .article-share-papers {
    position: relative;
    width: min(15rem, 100% - 1rem);
    aspect-ratio: 15 / 16;
    margin: 1.5rem auto 2rem;
  }

  .article-share-sheet {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid #e8e8e8;
    border-radius: 0.75rem;
    background: white;
    box-shadow: 0 1px 3px -1px rgb(0 0 0 / 4%), 0 8px 24px -6px rgb(0 0 0 / 7%);
  }

  .article-share-sheet--front { padding: 1.75rem 1.5rem 0; }
  .article-share-sheet--back { transform: translate(6px, -5px) rotate(2deg); }
  .article-share-sheet--middle { transform: translate(-8px, 3px) rotate(-2.5deg); }
  .article-share-print { height: 100%; mask-image: linear-gradient(#000 45%, transparent 90%); }
  .article-share-paper-title { font-family: Georgia, serif; font-size: 1.125rem; line-height: 1.13; text-wrap: balance; }
  .article-share-paper-description { margin-top: 0.75rem; color: #646464; font-size: 0.6875rem; line-height: 1.625; }

  .article-share-targets { display: flex; justify-content: center; gap: 0.75rem; }
  .article-share-targets a {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 50%;
    background: #f0f0f0;
    transition: background-color 160ms ease-out, transform 120ms var(--ease-out);
  }

  .article-share-link {
    display: flex;
    height: 2.5rem;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0 0.25rem 0 1rem;
    border-radius: 999px;
    background: #f0f0f0;
  }

  .article-share-link > span {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: #747474;
    font-size: 0.6875rem;
    white-space: nowrap;
    mask-image: linear-gradient(to right, #000 70%, transparent);
  }

  .article-share-link button {
    position: relative;
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: none;
    place-items: center;
    border-radius: 50%;
    color: #646464;
    cursor: pointer;
    transition: background-color 160ms ease-out, transform 120ms var(--ease-out);
  }

  :global(.article-share-dialog svg) { width: 1rem; height: 1rem; }
  a:active, button:active { transform: scale(0.97); }
  a:focus-visible, button:focus-visible { outline: 2px solid #747474; outline-offset: 3px; }

  .article-share-status { margin-top: 0.5rem; color: #646464; font-size: 0.75rem; text-align: center; }
  .article-share-status:empty { display: none; }

  @media (hover: hover) and (pointer: fine) {
    a:hover, button:hover { color: #202020; background: #e8e8e8; }
  }

  @media (max-width: 40rem) {
    .article-share-close { width: 2.75rem; height: 2.75rem; margin-right: -0.875rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-share-dialog::backdrop, a, button { transition: none; }
  }
</style>
