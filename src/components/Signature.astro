<style>
  .signature {
    display: block;
    width: 13.5rem;
    max-width: 100%;
    height: auto;
    margin-top: 1.5rem;
    color: var(--home-muted, rgb(32 34 33 / 50%));
  }
</style>

<script>
  import { gsap } from "gsap";
  import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";

  gsap.registerPlugin(DrawSVGPlugin);

  document.querySelectorAll<SVGSVGElement>("[data-signature]").forEach((signature) => {
    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      const strokes = [...signature.querySelectorAll<SVGPathElement>("path")];
      const totalLength = strokes.reduce((sum, stroke) => sum + stroke.getTotalLength(), 0);
      const writing = gsap.timeline({ paused: true, defaults: { ease: "none" } });
      gsap.set(strokes, { drawSVG: "0% 0%" });
      strokes.forEach((stroke) => {
        writing.to(stroke, {
          drawSVG: "0% 100%",
          duration: (stroke.getTotalLength() / totalLength) * 2.6,
        });
      });

      const observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        writing.play();
        observer.disconnect();
      }, { threshold: 0.7 });
      observer.observe(signature);
      return () => observer.disconnect();
    }, signature);
  });
</script>
