---
interface Props { target: string }
const { target } = Astro.props;
---

<style is:inline>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
  }
</style>

<script is:inline define:vars={{ target }}>
  (() => {
    let keyboard = false;
    let clearFlight;
    let turning;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const path = (url) => url ? new URL(url).pathname.replace(/\/$/, "") : null;
    const isPair = (from, to) => (from === "" && to === "/books") || (from === "/books" && to === "");

    // A history restore can reach its first paint while the home tile is still being parsed.
    const from = path(window.navigation?.activation?.from?.url ?? document.referrer);
    if ("onpagereveal" in window && !reduced.matches && isPair(from, path(location.href))) {
      const expect = document.createElement("link");
      expect.rel = "expect";
      expect.href = `#${target}`;
      expect.setAttribute("blocking", "render");
      document.head.append(expect);
    }

    // Sample the projected corners so the flat snapshot begins at the book's current angle.
    const coverTransform = (cover, width, height, bounds) => {
      const corners = [[0, 0], [width, 0], [0, height]].map(([left, top]) => {
        const point = document.createElement("span");
        point.style.cssText = `position:absolute;left:${left}px;top:${top}px;width:0;height:0;pointer-events:none`;
        cover.append(point);
        return point;
      });
      const [origin, right, bottom] = corners.map(point => point.getBoundingClientRect());
      corners.forEach(point => point.remove());
      // Fit the affine approximation to the full projected bounds, including the far corner.
      const across = { x: right.x - origin.x, y: right.y - origin.y };
      const down = { x: bottom.x - origin.x, y: bottom.y - origin.y };
      const scaleX = bounds.width / (Math.abs(across.x) + Math.abs(down.x));
      const scaleY = bounds.height / (Math.abs(across.y) + Math.abs(down.y));
      const x = bounds.left - scaleX * (Math.min(0, across.x) + Math.min(0, down.x));
      const y = bounds.top - scaleY * (Math.min(0, across.y) + Math.min(0, down.y));
      const matrix = [
        across.x * scaleX / width, across.y * scaleY / width,
        down.x * scaleX / height, down.y * scaleY / height,
        x, y,
      ];
      return `matrix(${matrix.join(", ")})`;
    };

    const currentCover = (home) => document.querySelector(home
      ? "[data-books-home-cover]"
      : '[data-side="cover"] [data-book-cover]');

    const clearTurn = () => {
      if (!turning) return;
      const { book, source, animations } = turning;
      turning = undefined;
      animations.forEach(animation => animation.cancel());
      book.remove();
      source.removeAttribute("data-books-carried");
    };

    document.addEventListener("click", (event) => {
      const link = event.target?.closest?.("a[data-books-entry], a[data-books-home]");
      if (!link) {
        if (turning && !turning.finished) clearTurn();
        return;
      }
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      keyboard = event.detail === 0;
      if (event.defaultPrevented || keyboard || reduced.matches) return;
      if (turning) { event.preventDefault(); return; }

      const opening = link.hasAttribute("data-books-entry");
      const cover = currentCover(opening);
      const image = cover?.querySelector("img");
      if (!image?.complete || !image.naturalWidth) return;

      const { offsetWidth: width, offsetHeight: height } = cover;
      const bounds = cover.getBoundingClientRect();
      if (!width || !height || !bounds.width || !bounds.height || bounds.bottom < 0 || bounds.top > innerHeight) return;

      const source = cover.closest(".books-case-feature, [data-books-slot]") ?? cover;
      const details = opening ? cover.dataset : source.dataset;
      const art = image.currentSrc;
      const book = document.createElement("div");
      book.className = "books-hinge";
      book.dataset.booksTurn = opening ? "open" : "close";
      book.setAttribute("aria-hidden", "true");
      Object.assign(book.style, { width: `${width}px`, height: `${height}px` });
      book.style.setProperty("--hinge-type", `${width * .111}px`);
      book.innerHTML = '<div class="books-hinge-page"><strong></strong><small hidden></small><span></span></div><div class="books-hinge-lid"><div class="books-hinge-front"><img alt="" draggable="false"></div><div class="books-hinge-endpaper"></div></div>';
      const [title, ...subtitle] = (details.title ?? "").split(": ");
      book.querySelector("strong").textContent = title;
      const subtitleLine = book.querySelector("small");
      subtitleLine.textContent = subtitle.join(": ");
      subtitleLine.hidden = !subtitle.length;
      book.querySelector(".books-hinge-page span").textContent = details.author ?? "";
      const front = book.querySelector(".books-hinge-front");
      front.querySelector("img").src = art;
      const lid = book.querySelector(".books-hinge-lid");
      const endpaper = book.querySelector(".books-hinge-endpaper");
      const from = coverTransform(cover, width, height, bounds);
      const scale = Math.min((innerWidth - 44) / (2 * width), innerHeight * .49 / height, 224 / width);
      const spread = `matrix(${scale}, 0, 0, ${scale}, ${innerWidth / 2}, ${(innerHeight - height * scale) / 2})`;

      event.preventDefault();
      source.setAttribute("data-books-carried", "");
      document.body.append(book);
      const lift = book.animate([{ transform: from }, { transform: spread }], {
        duration: opening ? 200 : 170, easing: "cubic-bezier(.22,.82,.24,1)", fill: "both",
      });
      const shut = "rotateY(0deg)", opened = "rotateY(-152deg)";
      const timing = { duration: opening ? 275 : 250, delay: opening ? 75 : 30, easing: "cubic-bezier(.32,.15,.24,1)", fill: "both" };
      const turn = lid.animate(
        opening ? [{ transform: shut }, { transform: opened }] : [{ transform: opened }, { transform: shut }],
        timing,
      );
      // Flip the painted face at edge-on instead of relying on WebKit's backface compositing.
      const edge = (opening ? 90 : 62) / 152;
      const faces = [[front, opening], [endpaper, !opening]].map(([face, startsVisible]) => {
        const first = Number(startsVisible), last = 1 - first;
        return face.animate([
          { opacity: first }, { opacity: first, offset: edge },
          { opacity: last, offset: edge }, { opacity: last },
        ], timing);
      });
      const current = { book, front, source, art, animations: [lift, turn, ...faces], opening, finished: false };
      turning = current;
      Promise.all(current.animations.map(animation => animation.finished)).then(() => {
        if (turning !== current) return;
        current.finished = true;
        window.location.assign(link.href);
      }, () => {});
    }, true);

    addEventListener("keydown", (event) => {
      if (event.key === "Escape" && turning && !turning.finished) clearTurn();
    });
    addEventListener("pageshow", (event) => {
      if (event.persisted) clearTurn();
    });

    const carry = (transition, leaving, activation) => {
      const instant = keyboard || reduced.matches;
      keyboard = false;
      clearFlight?.();
      if (!transition) return;
      void transition.ready.catch(() => {});
      void transition.updateCallbackDone?.catch(() => {});
      void transition.finished.catch(() => {});

      const from = path(activation?.from?.url);
      const to = path(activation?.entry?.url);
      if (instant || (from !== null && to !== null && !isPair(from, to))) {
        transition.skipTransition();
        return;
      }

      const home = document.querySelector("[data-books-entry]");
      const root = document.documentElement;
      const toShelf = home ? leaving : !leaving;
      if (toShelf) {
        root.dataset.booksFlight = "reveal";
        if (!leaving) root.classList.remove("m-enter");
        const clear = () => {
          if (clearFlight !== clear) return;
          delete root.dataset.booksFlight;
          if (leaving) clearTurn();
          clearFlight = undefined;
        };
        clearFlight = clear;
        transition.finished.then(clear, clear);
        return;
      }

      const closed = leaving && turning?.finished && !turning.opening ? turning : null;
      const cover = closed?.front ?? currentCover(home);
      if (!cover) {
        transition.skipTransition();
        return;
      }
      const image = cover.querySelector("img");
      if (leaving && (!image?.complete || !image.naturalWidth)) {
        transition.skipTransition();
        return;
      }

      if (home && !leaving) {
        const rect = home.getBoundingClientRect();
        if (rect.top < 0 || rect.bottom > innerHeight) home.scrollIntoView({ block: "center", behavior: "instant" });
      }
      root.dataset.booksFlight = home ? "land" : "return";
      const { offsetWidth: width, offsetHeight: height } = cover;
      const bounds = cover.getBoundingClientRect();
      const art = closed?.art ?? home?.dataset.booksFirstCover ?? cover.querySelector("[data-jacket-image]")?.dataset.jacketImage;
      if (!art || !width || !height || !bounds.width || !bounds.height) {
        delete root.dataset.booksFlight;
        transition.skipTransition();
        return;
      }

      // WebKit can omit transformed book faces from snapshots. Capture a flat cover instead.
      const poster = document.createElement("div");
      poster.className = "books-flight-cover";
      poster.setAttribute("aria-hidden", "true");
      const artwork = `url(${JSON.stringify(art)})`;
      Object.assign(poster.style, {
        width: `${width}px`, height: `${height}px`, transform: coverTransform(cover, width, height, bounds),
        backgroundImage: artwork, viewTransitionName: "books-flight",
      });
      const source = closed?.book ?? cover;
      source.setAttribute("data-books-carried", "");
      document.body.append(poster);
      const clear = () => {
        if (clearFlight !== clear) return;
        if (home && !leaving && home.matches(":hover")) {
          home.dataset.booksHoverPaused = "";
          home.addEventListener("pointerleave", () => delete home.dataset.booksHoverPaused, { once: true });
        }
        poster.remove();
        source.removeAttribute("data-books-carried");
        delete root.dataset.booksFlight;
        if (closed) clearTurn();
        clearFlight = undefined;
      };
      clearFlight = clear;
      transition.finished.then(clear, clear);
    };

    addEventListener("pageswap", (event) => carry(event.viewTransition, true, event.activation));
    addEventListener("pagereveal", (event) => carry(event.viewTransition, false, window.navigation?.activation));
  })();
</script>

<style is:global>
  [data-books-carried] { opacity: 0; }
  .books-hinge {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 110;
    pointer-events: none;
    transform-origin: top left;
    perspective: 900px;
  }
  .books-hinge-page, .books-hinge-lid, .books-hinge-front, .books-hinge-endpaper {
    position: absolute;
    inset: 0;
    border-radius: 2px;
  }
  .books-hinge-page {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .6em;
    padding: 14% 13%;
    overflow: hidden;
    background: linear-gradient(90deg, #d7cbb4, #f8f2e4 13%, #fcf8ee 88%, #eee4d2);
    color: #32281b;
    font: var(--hinge-type) / 1.08 Georgia, serif;
    box-shadow: 0 16px 28px -17px #28201684, inset -2px 0 #dcd1bf;
  }
  .books-hinge-page strong { font-weight: 600; text-wrap: balance; overflow-wrap: anywhere; }
  .books-hinge-page small { font-size: .67em; color: #5f5344; }
  .books-hinge-page span { font-size: .52em; color: #70624d; }
  .books-hinge-lid { transform-origin: left center; }
  .books-hinge-front { overflow: hidden; background: #e6dfcd; }
  .books-hinge-front img { display: block; width: 100%; height: 100%; }
  .books-hinge-endpaper {
    background: linear-gradient(90deg, #e9e1ca 2%, #f4ebd4 14%, #f8f0dc 81%, #cfbea4);
    box-shadow: 0 9px 18px -8px #28201662, inset -1px 0 #ad9f82;
  }
  .books-flight-cover {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 110;
    border-radius: 2px;
    background-color: #e6dfcd;
    background-size: 100% 100%;
    box-shadow: 0 16px 26px -17px #2820165e;
    pointer-events: none;
    transform-origin: top left;
  }
  html[data-books-flight]::view-transition { pointer-events: none; }
  html[data-books-flight]::view-transition-group(root) { animation: none; }
  html[data-books-flight]::view-transition-old(root) {
    z-index: 1;
    mix-blend-mode: normal;
    animation: books-page-release 120ms var(--ease-out) 20ms both;
  }
  html[data-books-flight]::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
  html[data-books-flight="reveal"]::view-transition-old(root) { animation-duration: 210ms; }
  html[data-books-flight]::view-transition-group(books-flight) {
    z-index: 1;
    animation-duration: 380ms;
    animation-timing-function: cubic-bezier(.3,.12,.24,1);
  }
  html[data-books-flight]::view-transition-new(books-flight) {
    display: none;
  }
  html[data-books-flight="land"]::view-transition-old(books-flight) {
    mix-blend-mode: normal;
    animation: books-cover-seat 380ms linear both;
  }
  @keyframes books-page-release { to { opacity: 0; } }
  @keyframes books-cover-seat {
    0%, 82% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
