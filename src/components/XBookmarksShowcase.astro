---
import { Icon } from "astro-icon/components";
import { xBookmarks } from "../data/x-bookmarks";

interface Props {
  mode: "overlay" | "standalone";
}

const { mode } = Astro.props;
const isOverlay = mode === "overlay";
const formatSavedAt = (value: string) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "Asia/Shanghai",
  }).format(new Date(value));
const formatPublishedAt = (value: string) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${value}T00:00:00Z`));
---

<main
  class:list={["x-bookmarks-stage", isOverlay && "is-overlay", !isOverlay && "is-open"]}
  data-x-bookmarks-stage={mode}
  data-x-bookmarks-state={isOverlay ? "closed" : "open"}
  aria-hidden={isOverlay ? "true" : undefined}
  inert={isOverlay ? true : undefined}
>
  <div class="x-bookmarks-index">
    <header class="x-bookmarks-header">
      <div data-x-bookmark-reveal>
        <h1>X Threads</h1>
        <p>{xBookmarks.length} saved posts</p>
      </div>
      {
        isOverlay ? (
          <button class="x-bookmarks-close" data-x-bookmarks-close type="button" aria-label="Close">
            <Icon name="ph:x" />
          </button>
        ) : (
          <a class="x-bookmarks-close" href="/" aria-label="Back to home">
            <Icon name="ph:x" />
          </a>
        )
      }
    </header>

    <section class="x-bookmarks-intro" data-x-bookmark-reveal>
      <h2>Saved on X.</h2>
      <p>Posts I want to return to, with my thoughts when I have them.</p>
    </section>

    <ol class="x-bookmarks-feed" aria-label="Saved posts from X">
      {
        xBookmarks.map((bookmark, index) => (
          <li
            class="x-bookmark-entry"
            data-x-bookmark-reveal
            data-x-bookmark-paper-target={index === 0 ? "" : undefined}
          >
            {bookmark.thought && (
              <section class="x-bookmark-thought" aria-label="Justin's take">
                <p>My take</p>
                <blockquote>{bookmark.thought}</blockquote>
              </section>
            )}

            <article class="x-post">
              <header class="x-post-author">
                <Icon class="x-post-mark" name="simple-icons:x" />
                <a href={bookmark.snapshot.authorUrl} target="_blank" rel="noreferrer">
                  <strong>{bookmark.snapshot.authorName}</strong>
                  <span>@{bookmark.snapshot.authorHandle}</span>
                </a>
                <time datetime={bookmark.snapshot.publishedAt}>
                  {formatPublishedAt(bookmark.snapshot.publishedAt)}
                </time>
              </header>

              <p class:list={["x-post-text", bookmark.snapshot.text.startsWith("https://t.co/") && "is-media"]}>
                {bookmark.snapshot.text.startsWith("https://t.co/")
                  ? "Media post on X"
                  : bookmark.snapshot.text}
              </p>

            </article>

            <footer class="x-bookmark-meta">
              <time datetime={bookmark.savedAt}>Saved {formatSavedAt(bookmark.savedAt)}</time>
              <a href={bookmark.url} target="_blank" rel="noreferrer">
                Open on X
                <Icon name="ph:arrow-up-right" />
              </a>
            </footer>
          </li>
        ))
      }
    </ol>
  </div>
</main>

<style>
  .x-bookmarks-stage {
    min-height: 100vh;
    color: var(--color-neutral-800);
    background: var(--color-neutral-50);
  }

  .x-bookmarks-stage.is-overlay {
    position: fixed;
    inset: 0;
    z-index: 45;
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease-out), visibility 0s linear 220ms;
  }

  .x-bookmarks-stage.is-overlay.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .x-bookmarks-index {
    width: min(100% - 3rem, 43.25rem);
    min-height: 100vh;
    margin-inline: auto;
    padding-block: 6rem;
  }

  .x-bookmarks-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .x-bookmarks-header h1 {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .x-bookmarks-header p {
    margin-top: 0.125rem;
    color: var(--color-neutral-500);
    font-size: 0.75rem;
  }

  .x-bookmarks-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--color-neutral-500);
    background: rgb(255 255 255 / 0.7);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.05);
    transition: color 160ms var(--ease-out), transform 160ms var(--ease-out);
  }

  .x-bookmarks-close :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .x-bookmarks-close:active {
    transform: scale(0.94);
  }

  .x-bookmarks-close:focus-visible,
  .x-bookmark-meta a:focus-visible,
  .x-post-author > a:focus-visible {
    outline: 2px solid var(--color-neutral-800);
    outline-offset: 3px;
  }

  .x-bookmarks-intro {
    margin: 4.5rem 0 3rem;
  }

  .x-bookmarks-intro h2 {
    color: var(--color-neutral-900);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .x-bookmarks-intro p {
    max-width: 34rem;
    margin-top: 0.75rem;
    color: var(--color-neutral-500);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .x-bookmarks-feed {
    list-style: none;
  }

  .x-bookmark-entry {
    padding-block: 2rem;
    border-top: 1px solid var(--color-neutral-200);
  }

  .x-bookmark-entry:last-child {
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .x-bookmark-thought {
    max-width: 38rem;
    margin: 0 auto 1.5rem;
  }

  .x-bookmark-thought > p {
    margin-bottom: 0.375rem;
    color: var(--color-neutral-400);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .x-bookmark-thought blockquote {
    color: var(--color-neutral-800);
    font-size: 1rem;
    line-height: 1.55;
  }

  .x-post {
    max-width: 38rem;
    margin-inline: auto;
  }

  .x-post-author {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.625rem;
  }

  .x-post-mark {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
    color: var(--color-neutral-800);
  }

  .x-post-author > a {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.375rem;
  }

  .x-post-author strong {
    color: var(--color-neutral-800);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .x-post-author span,
  .x-post-author time {
    color: var(--color-neutral-400);
    font-size: 0.75rem;
  }

  .x-post-author span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .x-post-author time {
    flex: none;
    margin-left: auto;
  }

  .x-post-text {
    margin-top: 1rem;
    color: var(--color-neutral-800);
    font-size: 1rem;
    line-height: 1.6;
    white-space: pre-line;
  }

  .x-post-text.is-media {
    color: var(--color-neutral-500);
    font-style: italic;
  }

  .x-bookmark-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 550px;
    margin: 0.75rem auto 0;
    color: var(--color-neutral-400);
    font-size: 0.75rem;
  }

  .x-bookmark-meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-neutral-500);
    font-weight: 500;
  }

  .x-bookmark-meta a :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .x-bookmarks-close:hover,
    .x-bookmark-meta a:hover,
    .x-post-author > a:hover strong {
      color: var(--color-neutral-800);
    }
  }

  @media (max-width: 40rem) {
    .x-bookmarks-index {
      width: min(100% - 2rem, 43.25rem);
      padding-block: 1.5rem 4rem;
    }

    .x-bookmarks-intro {
      margin-block: 3.5rem 2rem;
    }

    .x-bookmark-entry {
      padding-block: 1.5rem;
    }

    .x-post-author > a {
      display: grid;
      gap: 0;
    }

    .x-post-text {
      font-size: 1rem;
    }
  }
</style>
