---
import ParentLink from "./ParentLink.astro";
import FindsCabinet from "./FindsCabinet";
import { finds } from "../data/finds";
interface Props { mode: "overlay" | "standalone"; }
const { mode } = Astro.props;
const isOverlay = mode === "overlay";
---
<main class:list={["x-bookmarks-stage", isOverlay && "is-overlay", !isOverlay && "is-open"]}
  data-x-bookmarks-stage={mode} data-x-bookmarks-state={isOverlay ? "closed" : "open"}
  aria-hidden={isOverlay ? "true" : undefined} inert={isOverlay ? true : undefined}>
  <div class="x-bookmarks-index">
    <header class="x-bookmarks-header">
      <ParentLink label="Home" href={isOverlay ? undefined : "/"} {...(isOverlay ? { "data-x-bookmarks-close": "" } : {})} />
      <div><h1>Finds</h1><p>{finds.length} cards, a few connections.</p></div>
    </header>
    <div class="x-bookmarks-intro"><h2>One thing leads to another.</h2><p>A small card index of things worth coming back to.</p></div>
    <FindsCabinet client:load />
  </div>
</main>
<style>
 .x-bookmarks-stage{min-height:100svh;color:var(--color-neutral-800);background:var(--color-neutral-50)}
 .x-bookmarks-stage.is-overlay{position:fixed;inset:0;z-index:45;overflow-y:auto;overscroll-behavior:contain;visibility:hidden;opacity:0;pointer-events:none}
 .x-bookmarks-stage.is-overlay.is-open{visibility:visible;opacity:1;pointer-events:auto}
 .x-bookmarks-index{width:min(100% - 80px,1040px);min-height:100svh;margin-inline:auto;padding-block:40px 64px}
 .x-bookmarks-header{display:flex;align-items:center;justify-content:space-between;text-align:right}
 .x-bookmarks-header h1{font-size:14px;font-weight:500}
 .x-bookmarks-header p{font-size:11px;margin-top:3px;color:var(--color-neutral-500)}
 .x-bookmarks-intro{margin:56px 0 16px}.x-bookmarks-intro h2{font-size:clamp(25px,3.6vw,40px);letter-spacing:-.04em;font-weight:550;line-height:1.1}
 .x-bookmarks-intro p{font-size:13px;color:var(--color-neutral-500);margin-top:10px;line-height:1.5}
 @media(max-width:700px){.x-bookmarks-index{width:calc(100% - 32px);padding-block:22px 40px}.x-bookmarks-header{position:sticky;top:0;z-index:40;background:var(--color-neutral-50)}.x-bookmarks-intro{margin:24px 4px 22px}.x-bookmarks-intro h2{font-size:25px;max-width:300px}.x-bookmarks-intro p{max-width:300px;font-size:12px}}
</style>
