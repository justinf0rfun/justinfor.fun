---
import AgentTools from "./AgentTools";
---

<div class="agent-tools-slot">
  <AgentTools client:visible />
</div>

<style>
  :global(.about:has(.agent-tools-slot)) {
    margin-bottom: 1rem;
  }
  .agent-tools-slot {
    margin-top: 0.75rem;
    --agent-tool-surface: #fff;
  }
  :global([data-home-theme="dark"]) .agent-tools-slot {
    --agent-tool-surface: #252525;
  }
  .agent-tools-slot :global(.agent-tools) {
    position: relative;
  }
  .agent-tools-slot :global(.agent-tools-stage) {
    height: 7rem;
  }
  .agent-tools-slot :global([data-tw-item] img) {
    object-fit: contain !important;
    background: #fff;
  }
  .agent-tools-slot :global(img[src$="/tern.svg"]) {
    padding: 6px;
  }
  .agent-tools-slot :global([data-tw-title^="Devin Bot"]),
  .agent-tools-slot :global([data-tw-title^="Devin Bot"] > span:first-child) {
    background: none !important;
    box-shadow: none !important;
  }
  .agent-tools-slot :global([data-tw-title^="Devin Bot"] [aria-hidden="true"]) {
    display: none;
  }
  .agent-tools-slot :global([data-tw-title^="Devin Bot"] img) {
    background: transparent;
    filter: drop-shadow(0 1px 2px #0002);
  }
</style>
