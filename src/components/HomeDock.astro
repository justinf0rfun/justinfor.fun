---
import ThemeDial from "./ThemeDial.astro";
import DockBubbles from "./DockBubbles";
const email = "hello@jiaq.ing";
---
<div class="home-dock-wrap">
  <div class="home-dock" role="group" aria-label="Contact and appearance">
    <div class="dock-controls">
    <button class="dock-chat" type="button" data-home-chat-trigger aria-controls="home-chat" aria-expanded="false" disabled>
      <img src="/justin-avatar.png" alt="" width="26" height="30" />
      <span>Say hi</span>
    </button>
    <span class="dock-divider dock-chat-divider" aria-hidden="true"></span>
    <button class="dock-moments" type="button" data-home-moments-trigger aria-controls="home-moments" aria-expanded="false" aria-label="打开碎碎念" disabled>
      <span class="moments-entry-art" data-home-moments-slot aria-hidden="true"><img src="/moments-reference/alfred.webp" alt="" width="26" height="26" /><svg class="moments-entry-close" viewBox="0 0 20 20" width="18" height="18"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></span>
      <span class="moments-entry-label">Moments</span>
    </button>
    <button class="dock-email" type="button" aria-label="Email me" aria-haspopup="dialog" aria-controls="home-email" aria-expanded="false" data-home-email-trigger data-email-address={email} disabled>
      <span class="email-label">Email me</span>
      <span class="email-icons" aria-hidden="true">
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <g class="home-email-draft-paper"><path d="M4 1V-2.3Q4-3.2 4.9-3.2H13.1Q14-3.2 14-2.3V1" fill="#fff" /><path d="M6-.8H12" stroke="#888" stroke-width=".8" /></g>
          <rect x="0.7" y="0.7" width="16.6" height="12.6" rx="2.6" />
          <path d="M1.6 2.2L9 7.6L16.4 2.2" />
          <path d="M1.6 2.2L9 7.6L16.4 2.2" class="home-email-mail-flap" />
          <g transform="translate(9 7.7)"><path d="M0 1.9C-1.9 0.5-2.4-0.3-2.4-0.9C-2.4-1.6-1.9-2-1.3-2C-0.8-2-0.3-1.7 0-1.2C0.3-1.7 0.8-2 1.3-2C1.9-2 2.4-1.6 2.4-0.9C2.4-0.3 1.9 0.5 0 1.9Z" fill="currentColor" stroke="var(--email-icon-paper, #000)" stroke-width="1.2" paint-order="stroke" class="home-email-mail-heart" /></g>
        </svg>
      </span>
    </button>
    <span class="dock-divider" aria-hidden="true"></span>
    <ThemeDial />
    </div>
  </div>
</div>

<DockBubbles client:load />

<span class="chat-guide-hand" data-chat-guide-hand aria-hidden="true"><img src="/guide/pointing-hand.png" width="56" height="56" alt="" draggable="false" /></span>
<span class="chat-guide-ring" data-chat-guide-ring aria-hidden="true"></span>
<span class="sr-only" data-chat-guide-status role="status"></span>

<style>
  .chat-guide-hand, .chat-guide-ring { position: fixed; left: 0; top: 0; z-index: 36; pointer-events: none; opacity: 0; visibility: hidden; }
  .chat-guide-hand { width: 56px; height: 56px; filter: drop-shadow(0 3px 3px rgb(0 0 0 / .22)); }
  .chat-guide-hand img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .chat-guide-ring { width: 24px; height: 24px; border: 2px solid white; border-radius: 50%; }
  .home-dock-wrap {
    --dock-gap: max(38px, env(safe-area-inset-bottom));
    position: fixed;
    z-index: 35;
    bottom: var(--dock-gap);
    left: 50%;
    transform: translateX(-50%);
  }
  .home-dock {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 13px 20px 13px 24px;
    border-radius: 39px;
    background: #000;
    box-shadow: 0 .602px .602px -1.25px rgb(0 0 0 / .281),
      0 2.289px 2.289px -2.5px rgb(0 0 0 / .248),
      0 10px 10px -3.75px rgb(0 0 0 / .098);
    outline: 1.5px solid var(--home-dock-border, #000);
    outline-offset: -1.5px;
  }
  .home-dock-wrap::before {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
    bottom: -38px;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 130px;
    backdrop-filter: blur(6px);
    mask-image: linear-gradient(transparent, #000 75%);
  }
  button { border: 0; padding: 0; background: none; cursor: pointer; }
  button:focus-visible { outline: 2px solid white; outline-offset: 4px; }
  .dock-controls { display: flex; align-items: center; gap: inherit; }
  .dock-moments { display: flex; align-items: center; gap: 7px; min-height: 35px; color: rgb(255 255 255 / .65); white-space: nowrap; border-radius: 7px; font-size: 16px; transition: color 160ms; }
  .dock-moments:disabled { cursor: wait; }
  .dock-moments:is(:hover, :focus-visible) { color: #fff; }
  .moments-entry-art { position: relative; display: grid; place-items: center; width: 28px; height: 30px; flex: none; }
  .moments-entry-art > img { width: 26px; height: 26px; object-fit: contain; }
  .moments-entry-close { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%); opacity: 0; transition: opacity 150ms; }
    .dock-chat { display: flex; align-items: center; gap: 7px; white-space: nowrap; color: rgb(255 255 255 / .65); border-radius: 7px; font-size: 16px; transition: color 160ms; }
    .dock-chat:disabled { cursor: wait; }
    .dock-chat-divider { display: block; }
    .dock-chat:is(:hover, :focus-visible, [aria-expanded="true"]) { color: #fff; }
    .dock-chat img { object-fit: contain; flex: none; }
  .dock-email { display: flex; align-items: center; gap: 16px; color: rgb(255 255 255 / .5); border-radius: 7px; }
  .dock-email:disabled { cursor: wait; }
  .email-label { width: 70px; white-space: nowrap; font-size: 16px; line-height: 1.8; letter-spacing: .01em; }
  .email-icons { display: grid; place-items: center; width: 20px; height: 20px; }
  .email-icons :global(svg) { width: 20px; height: 16px; overflow: visible; }
  .dock-divider { flex: none; width: 4px; height: 28px; background: linear-gradient(rgb(255 255 255 / .39),rgb(255 255 255 / .39)) center / 1px 24px no-repeat; }
  @media (max-width: 400px) {
    .home-dock-wrap { --dock-gap: max(20px, env(safe-area-inset-bottom)); }
    .home-dock { gap: 10px; padding-inline: 16px; }
    .dock-email { gap: 10px; }
  }
  @media (max-width: 1023px) {
    .home-dock { gap: 10px; padding-inline: 14px; }
    .dock-chat { gap: 5px; font-size: 14px; min-height: 44px; }
    .dock-email .email-label { display: none; }
    .dock-email { min-height: 44px; width: 32px; justify-content: center; }
    .dock-moments { width: 32px; min-height: 44px; justify-content: center; }
    .moments-entry-label { display: none; }
  }
  @media (max-width: 360px) {
    .home-dock { gap: 6px; padding-inline: 10px; }
    .dock-chat { font-size: 13px; }
    .dock-email { width: 28px; }
  }
  @media (hover: none) and (pointer: coarse) {
    @supports (height: 100svh) {
      .home-dock-wrap {
        top: var(--dock-anchor-top, calc(100svh - var(--dock-gap)));
        bottom: auto;
        transform: translate(-50%, -100%);
      }
    }
  }
</style>

<style is:global>
  body.home-surface { --home-background: #f7f7f8; --home-ink: #202221; --home-muted: rgb(32 34 33 / .5); }
  html[data-home-theme="dark"] body.home-surface {
    --home-background: #000;
    --home-ink: #f7f7f8;
    --home-muted: rgb(255 255 255 / .5);
    --home-dock-border: #232323;
  }
  .home-surface > main { padding-bottom: 9rem; }
  html[data-home-theme="dark"] .home-surface > main .folder .back stop:first-child { stop-color: #303030; }
  html[data-home-theme="dark"] .home-surface > main .folder .back stop:last-child { stop-color: #181818; }
  html[data-home-theme="dark"] .home-surface > main .folder .back path[stroke] { stroke: #555; stroke-opacity: .5; }
  html[data-home-theme="dark"] .home-surface > main .folder .flap { background-image: linear-gradient(rgb(30 30 30 / .65),rgb(20 20 20 / .7)); --tw-inset-ring-color: rgb(255 255 255 / .12); }
  html[data-home-theme="dark"] .home-surface > main .folder .flap .text-neutral-800 { color: var(--home-ink); }
  html[data-home-theme="dark"] .home-surface > main .folder .flap .text-neutral-500 { color: var(--home-muted); }
  .home-surface:has(.uses-stage.is-open, .projects-page.is-open, .music-page.is-open, .memory-page.is-open, .writing-page.is-open, .x-bookmarks-page.is-open, .fstage.is-open) :is(.home-dock-wrap, .home-chat, .home-moments-scene, .home-moments-traveler, .home-email-layer) { visibility: hidden; pointer-events: none; }
</style>

<script>
  import { mountDockScroll } from "../scripts/dock-scroll";

  const dock = document.querySelector<HTMLElement>(".home-dock");
  if (dock) mountDockScroll(dock);

</script>
