---
import ThemeDial from "./ThemeDial.astro";
import DockBubbles from "./DockBubbles";
import "./x-tap-hand.css";
const email = "hello@jiaq.ing";
---
<div class="home-dock-wrap">
  <div class="home-dock" role="group" aria-label="Site controls">
    <div class="dock-glass-surface" aria-hidden="true"></div>
    <div class="dock-controls">
    <button class="dock-chat" type="button" data-home-chat-trigger aria-controls="home-chat" aria-expanded="false" disabled>
      <img src="/justin-avatar.png" alt="" width="26" height="30" />
      <span>Say hi</span>
    </button>
    <span class="dock-divider dock-chat-divider" aria-hidden="true"></span>
    <button class="dock-moments" type="button" data-home-moments-trigger aria-controls="home-moments" aria-expanded="false" aria-label="打开碎碎念" disabled>
      <span class="moments-entry-art" data-home-moments-slot aria-hidden="true"><img src="/moments-reference/alfred.webp" alt="" width="26" height="26" /><svg class="moments-entry-close" viewBox="0 0 20 20" width="18" height="18"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></span>
      <span class="moments-entry-label">Moments</span>
    </button>
    <button class="dock-email" type="button" aria-label="Email me" aria-haspopup="dialog" aria-controls="home-email" aria-expanded="false" data-home-email-trigger data-email-address={email} disabled>
      <span class="email-icons" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <defs>
            <linearGradient id="dock-mail-paper" x1="4" y1="9" x2="23" y2="22" gradientUnits="userSpaceOnUse"><stop stop-color="#fffefa" /><stop offset=".5" stop-color="#e9e5da" /><stop offset="1" stop-color="#d5cfc1" /></linearGradient>
            <linearGradient id="dock-mail-front" x1="14" y1="15" x2="14" y2="23" gradientUnits="userSpaceOnUse"><stop stop-color="#f6f3eb" /><stop offset=".8" stop-color="#eee9de" /><stop offset="1" stop-color="#d8d2c5" /></linearGradient>
            <linearGradient id="dock-mail-fold" x1="14" y1="8.5" x2="14" y2="16" gradientUnits="userSpaceOnUse"><stop stop-color="#fffefa" /><stop offset=".72" stop-color="#f5f1e7" /><stop offset="1" stop-color="#e2dbce" /></linearGradient>
            <linearGradient id="dock-mail-letter" x1="14" y1="7" x2="14" y2="19" gradientUnits="userSpaceOnUse"><stop stop-color="#fffefa" /><stop offset="1" stop-color="#eee8db" /></linearGradient>
            <radialGradient id="dock-mail-wax" cx=".3" cy=".22" r=".85"><stop stop-color="#ffc16b" /><stop offset=".48" stop-color="#ed8628" /><stop offset="1" stop-color="#b84c16" /></radialGradient>
            <linearGradient id="dock-mail-wax-rim" x1="13" y1="14.5" x2="15" y2="18" gradientUnits="userSpaceOnUse"><stop stop-color="#9c4319" /><stop offset=".45" stop-color="#c2611d" /><stop offset="1" stop-color="#ffd087" /></linearGradient>
            <clipPath id="dock-mail-pocket"><path d="M5 0H23V8.5H5Z" /></clipPath>
          </defs>
          <rect x="2.75" y="7.75" width="22.5" height="15.5" rx="2.5" fill="url(#dock-mail-paper)" stroke="var(--mail-edge)" stroke-width=".5" />
          <path d="M3.6 21.2L12 14.9Q14 13.5 16 14.9L24.4 21.2Q24.2 22.5 22.8 22.5H5.2Q3.8 22.5 3.6 21.2Z" fill="url(#dock-mail-front)" stroke="var(--mail-fold)" stroke-width=".4" />
          <path d="M5.2 22.3H22.8" stroke="#fffefa" stroke-width=".5" opacity=".75" />
          <g class="home-email-mail-flap">
            <path d="M3.5 8.85H24.5L15.6 15.75Q14 16.95 12.4 15.75Z" fill="#746553" opacity=".19" />
            <path d="M3.5 8.35H24.5L15.6 15.15Q14 16.35 12.4 15.15Z" fill="url(#dock-mail-fold)" stroke="var(--mail-fold)" stroke-width=".4" />
            <path d="M4.2 8.6L12.7 15Q14 16 15.3 15L23.8 8.6" stroke="#fffefa" stroke-width=".4" opacity=".8" />
          </g>
          <g class="home-email-wax-seal">
            <path d="M13.9 13.9C14.8 13.55 15 14.15 15.7 14.4C16.5 14.65 16.35 15.35 16.65 16C17 16.8 16.3 17.15 16.05 17.85C15.75 18.55 14.95 18.35 14.3 18.55C13.5 18.8 13.05 18.25 12.35 18.05C11.65 17.8 11.85 17.05 11.55 16.45C11.2 15.65 11.85 15.25 12.05 14.6C12.3 13.9 13.15 14.15 13.9 13.9Z" fill="#72543a" opacity=".25" />
            <path d="M13.9 13.45C14.8 13.1 15 13.7 15.7 13.95C16.5 14.2 16.35 14.9 16.65 15.55C17 16.35 16.3 16.7 16.05 17.4C15.75 18.1 14.95 17.9 14.3 18.1C13.5 18.35 13.05 17.8 12.35 17.6C11.65 17.35 11.85 16.6 11.55 16C11.2 15.2 11.85 14.8 12.05 14.15C12.3 13.45 13.15 13.7 13.9 13.45Z" fill="url(#dock-mail-wax)" />
            <circle cx="14.1" cy="15.8" r="1.6" stroke="url(#dock-mail-wax-rim)" stroke-width=".55" />
            <path d="M12.2 14.7Q12.65 13.95 13.45 14.05" stroke="#ffe2aa" stroke-width=".4" opacity=".8" />
          </g>
          <g clip-path="url(#dock-mail-pocket)"><g class="home-email-draft-paper"><rect x="7" y="7" width="14" height="13" rx="1" fill="url(#dock-mail-letter)" stroke="#c7bfaf" stroke-width=".5" /><path d="M9.5 10H18.5" stroke="#bcb3a2" stroke-width=".65" /></g></g>
        </svg>
      </span>
      <span class="email-label">Email me</span>
    </button>
    <button class="dock-radio" type="button" data-engineering-open aria-controls="engineering-blogs" aria-expanded="false" aria-haspopup="dialog" aria-label="Engineering Blogs" title="Engineering Blogs" disabled>
      <span class="radio-entry-art" aria-hidden="true">
        <span class="radio-entry-antenna"></span>
        <span class="radio-entry-case">
          <span class="radio-entry-scale"></span>
          <span class="radio-entry-speaker"></span>
          <span class="radio-entry-knob"></span>
        </span>
      </span>
    </button>
    <span class="dock-divider" aria-hidden="true"></span>
    <ThemeDial />
    </div>
  </div>
</div>

<DockBubbles client:load />

<span class="chat-guide-hand" data-chat-guide-hand aria-hidden="true">
  <span class="tap-hand-fill"></span>
  <span class="tap-hand-ring"></span>
  <span class="tap-hand-sprite"><img src="/guide/tap-hand.png" width="256" height="256" alt="" draggable="false" /></span>
</span>
<span class="sr-only" data-chat-guide-status role="status"></span>

<style>
  .chat-guide-hand { display: none; position: fixed; inset: 0 auto auto 0; z-index: 36; width: 102px; height: 90px; overflow: hidden; pointer-events: none; }
  .home-dock-wrap {
    --dock-gap: max(38px, env(safe-area-inset-bottom));
    position: fixed;
    z-index: 35;
    bottom: var(--dock-gap);
    left: 50%;
    transform: translateX(-50%);
  }
  .home-dock {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 13px 20px 13px 24px;
    border-radius: 39px;
  }
  /* Xiangyi's Dock glass material; see bubble-navbar/SOURCE.md. */
  .dock-glass-surface {
    z-index: -1;
    background-color: color-mix(in srgb, var(--dock-glass) 12%, transparent);
    -webkit-backdrop-filter: blur(8px) saturate(var(--dock-saturation));
    backdrop-filter: blur(8px) saturate(var(--dock-saturation));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--dock-light) calc(var(--dock-reflex-light) * 10%), transparent),
      inset 1.8px 3px 0px -2px color-mix(in srgb, var(--dock-light) calc(var(--dock-reflex-light) * 90%), transparent),
      inset -2px -2px 0px -2px color-mix(in srgb, var(--dock-light) calc(var(--dock-reflex-light) * 80%), transparent),
      inset -3px -8px 1px -6px color-mix(in srgb, var(--dock-light) calc(var(--dock-reflex-light) * 60%), transparent),
      inset -0.3px -1px 4px 0px color-mix(in srgb, var(--dock-dark) calc(var(--dock-reflex-dark) * 12%), transparent),
      inset -1.5px 2.5px 0px -2px color-mix(in srgb, var(--dock-dark) calc(var(--dock-reflex-dark) * 20%), transparent),
      inset 0px 3px 4px -2px color-mix(in srgb, var(--dock-dark) calc(var(--dock-reflex-dark) * 20%), transparent),
      inset 2px -6.5px 1px -4px color-mix(in srgb, var(--dock-dark) calc(var(--dock-reflex-dark) * 10%), transparent),
      0px 1px 5px 0px color-mix(in srgb, var(--dock-dark) calc(var(--dock-reflex-dark) * 10%), transparent),
      0px 6px 16px 0px color-mix(in srgb, var(--dock-dark) calc(var(--dock-reflex-dark) * 8%), transparent);
    border-radius: inherit;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  button { border: 0; padding: 0; background: none; cursor: pointer; }
  button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .dock-controls { display: flex; align-items: center; gap: inherit; }
  .dock-moments { display: flex; align-items: center; gap: 7px; min-height: 35px; color: var(--dock-muted); white-space: nowrap; border-radius: 7px; font-size: 16px; transition: color 160ms; }
  .dock-moments:disabled { cursor: wait; }
  .dock-moments:is(:hover, :focus-visible) { color: var(--dock-ink); }
  .moments-entry-art { position: relative; display: grid; place-items: center; width: 28px; height: 30px; flex: none; }
  .moments-entry-art > img { width: 26px; height: 26px; object-fit: contain; }
  .moments-entry-close { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%); opacity: 0; transition: opacity 150ms; }
    .dock-chat { display: flex; align-items: center; gap: 7px; white-space: nowrap; color: var(--dock-muted); border-radius: 7px; font-size: 16px; transition: color 160ms; }
    .dock-chat:disabled { cursor: wait; }
    .dock-chat-divider { display: block; }
    .dock-chat:is(:hover, :focus-visible, [aria-expanded="true"]) { color: var(--dock-ink); }
    .dock-chat img { object-fit: contain; flex: none; }
  .dock-email { --mail-edge: #c3beb3; --mail-fold: #b9b1a4; display: flex; align-items: center; gap: 8px; color: var(--dock-muted); border-radius: 7px; }
  .dock-email:disabled { cursor: wait; }
  .email-label { width: 70px; white-space: nowrap; font-size: 16px; line-height: 1.8; letter-spacing: .01em; }
  .email-icons { display: grid; place-items: center; flex: none; width: 28px; height: 28px; }
  .email-icons :global(svg) { width: 28px; height: 28px; overflow: visible; filter: drop-shadow(0 .75px .75px rgb(0 0 0 / .25)); }
  .dock-radio { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 7px; color: var(--dock-ink); -webkit-tap-highlight-color: transparent; }
  .dock-radio:disabled { cursor: wait; }
  .radio-entry-art { position: relative; width: 32px; height: 30px; transition: transform 200ms var(--ease-out); }
  .radio-entry-antenna {
    position: absolute; top: 2px; right: 8px; width: 2px; height: 11px;
    border-radius: 2px; background: linear-gradient(90deg, #676b67, #f7f8f4 50%, #929790);
    box-shadow: 0 1px 2px #20242040; transform: rotate(30deg); transform-origin: center bottom;
    transition: transform 280ms var(--ease-out);
  }
  .radio-entry-case {
    position: absolute; inset: 10px 2px 2px; border-radius: 4px;
    background: repeating-linear-gradient(0deg, #fff2 0 .4px, transparent .4px 1.25px),
      linear-gradient(158deg, #eff0ec, #c5c7c2 58%, #9b9e98);
    box-shadow: inset 0 .6px #f8f9f5, inset 0 -1px #60645ca0, 0 1px 2px #1f241e48;
  }
  .radio-entry-scale {
    position: absolute; inset: 3px 11px auto 3px; height: 4px; overflow: hidden; border-radius: 1px;
    background: repeating-linear-gradient(90deg, #bdbdb24d 0 1px, transparent 1px 3px) center bottom / 100% 2px no-repeat, #2c302b;
    box-shadow: inset 0 1px 1px #151713, 0 .5px #f7f8f3;
  }
  .radio-entry-scale::after {
    content: ""; position: absolute; inset: 0 auto 0 4px; width: 1.5px; background: #e4a366;
    box-shadow: 0 0 2px #ffb36a70; transition: transform 260ms var(--ease-out), background 180ms;
  }
  .radio-entry-speaker {
    position: absolute; inset: 9px 11px 4px 3px; border-radius: .5px;
    background: repeating-linear-gradient(#525650 0 1px, transparent 1px 2px);
  }
  .radio-entry-knob {
    position: absolute; right: 3px; bottom: 4px; width: 6px; height: 6px; border-radius: 50%;
    background: linear-gradient(140deg, #a3a8a1, #464b45 62%, #242722);
    box-shadow: inset 0 .5px #e3e5df, 0 .5px 1px #2a2d288c;
  }
  .dock-radio[aria-expanded="true"] .radio-entry-antenna { transform: rotate(5deg); }
  .dock-radio[aria-expanded="true"] .radio-entry-scale::after { transform: translateX(5px); background: #ffc17b; }
  @media (hover: hover) and (pointer: fine) {
    .dock-radio:hover .radio-entry-art { transform: translateY(-2px) rotate(-5deg); }
    .dock-radio:hover .radio-entry-antenna { transform: rotate(5deg); }
  }
  .dock-radio:active .radio-entry-art { transform: translateY(1px) scale(.91); }
  @media (prefers-reduced-motion: reduce) {
    .dock-radio .radio-entry-art, .dock-radio .radio-entry-antenna, .dock-radio .radio-entry-scale::after { transition: none; }
  }
  .dock-divider { flex: none; width: 4px; height: 28px; background: linear-gradient(var(--dock-divider),var(--dock-divider)) center / 1px 24px no-repeat; }
  @media (max-width: 400px) {
    .home-dock-wrap { --dock-gap: max(20px, env(safe-area-inset-bottom)); }
    .home-dock { gap: 10px; padding-inline: 16px; }
    .dock-email { gap: 10px; }
  }
  @media (max-width: 1023px) {
    .home-dock { gap: 10px; padding-inline: 14px; }
    .dock-chat { gap: 5px; font-size: 14px; min-height: 44px; }
    .dock-email .email-label { display: none; }
    .dock-email { min-height: 44px; width: 32px; justify-content: center; }
    .dock-moments { width: 32px; min-height: 44px; justify-content: center; }
    .moments-entry-label { display: none; }
  }
  @media (max-width: 360px) {
    .home-dock { gap: 6px; padding-inline: 10px; }
    .dock-chat { font-size: 13px; }
    .dock-email { width: 28px; }
  }
  @media (hover: none) and (pointer: coarse) {
    @supports (height: 100svh) {
      .home-dock-wrap {
        top: var(--dock-anchor-top, calc(100svh - var(--dock-gap)));
        bottom: auto;
        transform: translate(-50%, -100%);
      }
    }
  }
</style>

<style is:global>
  body.home-surface {
    --home-background: #f7f7f8; --home-ink: #202221; --home-muted: rgb(32 34 33 / .5);
    --dock-glass: #bbbbbc;
    --dock-light: #ffffff;
    --dock-dark: #000000;
    --dock-reflex-light: 1;
    --dock-reflex-dark: 1;
    --dock-saturation: 150%;
    --dock-ink: #202221;
    --dock-muted: rgb(32 34 33 / .68);
    --dock-divider: rgb(32 34 33 / .2);
    --dock-hover: rgb(32 34 33 / .06);
  }
  html[data-home-theme="dark"] body.home-surface {
    --home-background: #000;
    --home-ink: #f7f7f8;
    --home-muted: rgb(255 255 255 / .5);
    --dock-reflex-light: .3;
    --dock-reflex-dark: 2;
    --dock-ink: #fff;
    --dock-muted: rgb(255 255 255 / .65);
    --dock-divider: rgb(255 255 255 / .39);
    --dock-hover: rgb(255 255 255 / .1);
  }
  .home-surface > main { padding-bottom: 9rem; }
  html[data-home-theme="dark"] .home-surface > main .folder .back stop:first-child { stop-color: #303030; }
  html[data-home-theme="dark"] .home-surface > main .folder .back stop:last-child { stop-color: #181818; }
  html[data-home-theme="dark"] .home-surface > main .folder .back path[stroke] { stroke: #555; stroke-opacity: .5; }
  html[data-home-theme="dark"] .home-surface > main .folder .flap { background-image: linear-gradient(rgb(30 30 30 / .65),rgb(20 20 20 / .7)); --tw-inset-ring-color: rgb(255 255 255 / .12); }
  html[data-home-theme="dark"] .home-surface > main .folder .flap .text-neutral-800 { color: var(--home-ink); }
  html[data-home-theme="dark"] .home-surface > main .folder .flap .text-neutral-500 { color: var(--home-muted); }
  .home-surface:has(.uses-stage.is-open, .projects-page.is-open, .music-page.is-open, .memory-page.is-open, .writing-page.is-open, .x-bookmarks-page.is-open, .fstage.is-open) :is(.home-dock-wrap, .home-chat, .home-moments-scene, .home-moments-traveler, .home-email-layer) { visibility: hidden; pointer-events: none; }
</style>

<script>
  import { mountDockScroll } from "../scripts/dock-scroll";

  const dock = document.querySelector<HTMLElement>(".home-dock");
  if (dock) mountDockScroll(dock);

</script>
