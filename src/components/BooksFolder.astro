---
import BookSpine from "./BookSpine.astro";
import { books } from "../data/books";
const preview = [books[5], books[0], books[6]];
---

<a id="books" class="books-folder" href="/books" data-folder="books" data-books-entry
  data-books-first-cover={books[0].cover ?? undefined} aria-label={`Open Books, ${books.length} books`}>
  <div class="books-case">
    <div class="books-case-bed" aria-hidden="true"></div>
    <div class="books-case-bookend" aria-hidden="true"></div>
    <div class="books-case-volumes" aria-hidden="true">
      {preview.map((book, index) => (
        <span class:list={["books-case-volume", { "books-case-feature": index === 1 }]}
          style={{ "--book-height": [85, 99, 91][index] + "%" }}>
          {index === 1 ? (
            <span class="books-case-turn">
              <BookSpine {book} compact />
              <span id="home-books-cover" class="books-case-cover" data-books-home-cover
                style={{ "--book-aspect": book.aspect, "--cover-back": book.spinePalette.body }}>
                <img alt="" draggable="false" fetchpriority="low" />
              </span>
            </span>
          ) : <BookSpine {book} compact />}
        </span>
      ))}
    </div>
    <div class="books-case-base">
      <span class="books-case-label"><span>Books</span><span>{books.length}</span></span>
    </div>
  </div>
</a>

<script>
  const entry = document.querySelector<HTMLAnchorElement>("[data-books-first-cover]");
  const cover = entry?.dataset.booksFirstCover;
  const image = entry?.querySelector<HTMLImageElement>("[data-books-home-cover] img");
  if (entry && cover && image) {
    const observer = new IntersectionObserver(([change]) => {
      if (!change.isIntersecting) return;
      observer.disconnect();
      image.src = cover;
    }, { rootMargin: "200px 0px" });
    observer.observe(entry);
  }
</script>

<style>
  .books-folder {
    display: block;
    -webkit-tap-highlight-color: transparent;
    text-decoration: none;
  }

  .books-case {
    --aluminum-top: #f1f0ea;
    --aluminum-face: #d9d9d3;
    --aluminum-edge: #b5b6b1;
    --aluminum-ink: #30332f;
    position: relative;
    isolation: isolate;
    aspect-ratio: 20 / 17;
  }

  .books-case-bed {
    position: absolute;
    inset: 76% 4% 12%;
    clip-path: polygon(8% 0, 88% 0, 100% 77%, 100% 100%, 0 100%, 0 77%);
    background:
      radial-gradient(ellipse at 48% 62%, #1519143d, transparent 64%),
      linear-gradient(167deg, var(--aluminum-face), var(--aluminum-top) 80%);
  }

  .books-case-bookend {
    position: absolute;
    z-index: 1;
    inset: 45% 13% 13.8% auto;
    width: 11%;
    border-radius: 3px 6px 3px 2px;
    clip-path: polygon(0 13%, 75% 0, 100% 5%, 100% 100%, 0 100%);
    background:
      linear-gradient(180deg, #ffe2c626, transparent 31%, #3d0f1424),
      linear-gradient(90deg, #a84835, #d27254 74%, #ef9773 75%, #a44633 79%, #9a3d2e);
    box-shadow: inset 0 1px #ffd3b07a;
  }

  .books-case-volumes {
    position: absolute;
    z-index: 2;
    inset: 8% 21% 13%;
    display: grid;
    grid-template-columns: .94fr 1fr .86fr;
    grid-template-rows: minmax(0, 1fr);
    align-items: end;
    gap: 2.8%;
    perspective: 680px;
  }

  .books-case-volume {
    position: relative;
    min-width: 0;
    height: var(--book-height);
    border-radius: 2px 2px 1px 1px;
    box-shadow: 1px 2px 4px #1d221d38;
  }
  .books-case-feature {
    --book-turn: -8deg;
    z-index: 1;
    transform: translateY(var(--book-rise, 0px));
    transform-style: preserve-3d;
    transition: transform 295ms cubic-bezier(.32,.04,.31,1) 35ms;
    box-shadow: none;
  }
  .books-case-turn {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    transform: rotateZ(var(--book-lean, 0deg)) rotateY(var(--book-turn, 0deg));
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 255ms cubic-bezier(.23,1,.32,1);
  }
  .books-case-cover {
    position: absolute;
    inset: 0 auto 0 100%;
    aspect-ratio: var(--book-aspect);
    overflow: hidden;
    border-radius: 1px 2px 2px 1px;
    background: var(--cover-back);
    transform: rotateY(90deg);
    transform-origin: left center;
    backface-visibility: hidden;
    pointer-events: none;
  }
  .books-case-cover img { display: block; width: 100%; height: 100%; }
  .books-case-cover img:not([src]) { visibility: hidden; }

  .books-case-base {
    position: absolute;
    z-index: 3;
    inset: 85% 4% 2.5%;
    display: flex;
    align-items: center;
    padding-inline: 7.5%;
    border-radius: 2px 2px 4px 4px;
    background:
      linear-gradient(106deg, #fff4, transparent 38% 75%, #1b201916),
      linear-gradient(var(--aluminum-top), var(--aluminum-face) 65%, var(--aluminum-edge));
    box-shadow: inset 0 1px #fff8, inset 0 -1px #23282035, 0 4px 7px -3px #1d221e50, 0 10px 16px -10px #1d221e65;
  }

  .books-case-label {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: baseline;
    gap: 5px;
    color: var(--aluminum-ink);
    font-size: clamp(12px, 1.25vw, 15px);
    font-weight: 600;
    line-height: 1.1;
  }

  .books-case-label > :last-child {
    font: 500 clamp(9px, .9vw, 11px) / 1 ui-monospace, monospace;
  }

  :global(html[data-home-theme=dark]) .books-case {
    --aluminum-top: #c3c4c0;
    --aluminum-face: #a9aba6;
    --aluminum-edge: #7e817a;
    --aluminum-ink: #20231f;
  }

  .books-folder:focus-visible { outline: 2px solid var(--home-ink, #202221); outline-offset: 4px; border-radius: 8px; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :where(.books-folder:hover:not([data-books-hover-paused])) .books-case-feature {
      --book-rise: max(-27%, -27px);
      --book-lean: -4deg;
      --book-turn: -41deg;
      transition: transform 320ms cubic-bezier(.16,.85,.28,1.12);
    }
    :where(.books-folder:hover:not([data-books-hover-paused])) .books-case-turn {
      transition: transform 360ms cubic-bezier(.19,.82,.25,1.06) 55ms;
    }
  }
  @media (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    :where(.books-folder:active) .books-case-feature {
      --book-rise: -10%;
      --book-turn: -15deg;
    }
    :where(.books-folder:active) :is(.books-case-feature, .books-case-turn) { transition: transform 100ms var(--ease-out); }
  }
  :global(html[data-books-flight=take]) .books-case-feature {
    --book-rise: max(-31%, -30px);
    --book-lean: -4deg;
    --book-turn: -48deg;
  }
  :global(html[data-books-flight=land]) .books-case-feature {
    --book-rise: -6%;
    --book-turn: -14deg;
  }
  :global(html[data-books-flight]) :is(.books-case-feature, .books-case-turn) {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .books-case-feature, .books-case-turn { transition: none; }
  }
</style>
