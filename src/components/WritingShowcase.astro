---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import LocalTimeFooter from "./LocalTimeFooter.astro";

interface Props {
  mode: "overlay" | "standalone";
}

const { mode } = Astro.props;
const isOverlay = mode === "overlay";
const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const renderedPosts = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content })),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<main
  class:list={["writing-stage", isOverlay && "is-overlay", !isOverlay && "is-open"]}
  data-writing-stage={mode}
  data-writing-state={isOverlay ? "closed" : "open"}
  aria-hidden={isOverlay ? "true" : undefined}
  inert={isOverlay ? true : undefined}
>
  <div class="writing-index">
    <header class="writing-header">
      <div data-writing-reveal>
        <h1>Thoughts</h1>
        <p>{posts.length} {posts.length === 1 ? "thought" : "thoughts"}</p>
      </div>
      {
        isOverlay ? (
          <button class="writing-close" data-writing-close type="button" aria-label="Close">
            <Icon name="ph:x" />
          </button>
        ) : (
          <a class="writing-close" href="/" aria-label="Back to home">
            <Icon name="ph:x" />
          </a>
        )
      }
    </header>

    <div
      class="writing-workspace"
      data-writing-split
      data-dragging="false"
      data-snapped="true"
      data-writing-reveal
    >
      <section
        id={`writing-list-${mode}`}
        class="writing-pane writing-list-pane"
        aria-label="Thought list"
      >
        <div class="writing-timeline">
          {posts.map((post, index) => (
            <article
              class="writing-entry"
              data-writing-paper-target={index === 0 ? "" : undefined}
            >
              <time datetime={post.data.publishedAt.toISOString()}>
                <span>{formatDate(post.data.publishedAt)}</span>
                <span>{post.data.publishedAt.getUTCFullYear()}</span>
              </time>
              <a
                id={`writing-title-${mode}-${post.id}`}
                href={`/thoughts/${post.id}`}
                data-writing-select={post.id}
                aria-controls={`writing-detail-${mode}-${post.id}`}
                aria-current={index === 0 ? "true" : undefined}
              >
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
            </article>
          ))}
        </div>
      </section>

      <div
        class="writing-divider"
        data-writing-divider
        role="separator"
        tabindex="0"
        aria-label="Resize thought list and article"
        aria-orientation="vertical"
        aria-controls={`writing-list-${mode} writing-details-${mode}`}
        aria-valuemin="15"
        aria-valuemax="85"
        aria-valuenow="50"
        aria-valuetext="50% list, 50% article"
      >
        <span class="writing-grip" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </div>

      <section
        id={`writing-details-${mode}`}
        class="writing-pane writing-detail-pane"
        aria-label="Selected thought"
      >
        {
          renderedPosts.map(({ post, Content }, index) => (
            <article
              id={`writing-detail-${mode}-${post.id}`}
              class="writing-detail"
              data-writing-detail={post.id}
              aria-labelledby={`writing-title-${mode}-${post.id}`}
              hidden={index !== 0}
            >
              <header class="writing-detail-header">
                <div>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatDate(post.data.publishedAt)} {post.data.publishedAt.getUTCFullYear()}
                  </time>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </div>
                <a class="writing-detail-open" href={`/thoughts/${post.id}`} aria-label={`Open ${post.data.title} as a page`}>
                  <span>Open</span>
                  <Icon name="ph:arrow-up-right" />
                </a>
              </header>
              <div class="writing-prose">
                <Content />
              </div>
            </article>
          ))
        }
      </section>
    </div>

    <div class="writing-readout" aria-hidden="true" data-writing-reveal>
      <span data-writing-left-width>W 0</span>
      <span data-writing-right-width>W 0</span>
      <span class="writing-readout-ratio" data-writing-ratio>50%</span>
    </div>

    <LocalTimeFooter />
  </div>
</main>

<style>
  .writing-stage {
    min-height: 100vh;
    color: var(--color-neutral-800);
    background: var(--color-neutral-50);
  }

  .writing-stage.is-overlay {
    position: fixed;
    inset: 0;
    z-index: 45;
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease-out), visibility 0s linear 220ms;
  }

  .writing-stage.is-overlay.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .writing-index {
    --split-accent-start: #10bffa;
    --split-accent-end: #11acef;
    --split-accent-chip: #12aff3;
    width: min(100% - 3rem, clamp(68rem, 62vw, 82rem));
    min-height: 100vh;
    margin-inline: auto;
    padding-block: 6rem;
  }

  .writing-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .writing-header h1 {
    color: var(--color-neutral-800);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .writing-header p {
    margin-top: 0.125rem;
    color: var(--color-neutral-500);
    font-size: 0.75rem;
  }

  .writing-close {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 999px;
    color: var(--color-neutral-500);
    background: rgb(255 255 255 / 0.78);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.05);
    transition: color 160ms var(--ease-out), transform 160ms var(--ease-out);
  }

  .writing-close :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .writing-close:active {
    transform: scale(0.94);
  }

  .writing-workspace {
    display: flex;
    height: clamp(32rem, calc(100vh - 15rem), clamp(42rem, 35vw, 50rem));
    height: clamp(32rem, calc(100dvh - 15rem), clamp(42rem, 35vw, 50rem));
    align-items: stretch;
  }

  .writing-pane {
    min-width: 0;
    overflow: hidden;
    border-radius: 1.125rem;
    background: white;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.045),
      0 2px 4px rgb(0 0 0 / 0.035),
      0 10px 22px rgb(0 0 0 / 0.05);
  }

  .writing-list-pane {
    flex: 0 0 var(--split-left, calc(50% - 0.625rem));
    padding: 1.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: var(--color-neutral-300) transparent;
    scrollbar-width: thin;
    transition: flex-basis 250ms cubic-bezier(0.25, 0.3, 0.2, 1);
  }

  .writing-detail-pane {
    flex: 1 1 0;
    overflow: hidden;
  }

  .writing-timeline {
    position: relative;
  }

  .writing-timeline::before {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 4.75rem;
    width: 1px;
    content: "";
    background: var(--color-neutral-200);
  }

  .writing-entry {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.1rem 0.5rem;
  }

  .writing-entry::before {
    position: absolute;
    top: 1.52rem;
    left: 4.47rem;
    z-index: 1;
    width: 0.5625rem;
    height: 0.5625rem;
    border: 2px solid var(--color-neutral-50);
    border-radius: 999px;
    content: "";
    background: var(--color-neutral-300);
  }

  .writing-entry:first-child::before {
    background: #dc6a4b;
  }

  .writing-entry > time {
    display: grid;
    align-content: start;
    padding-top: 0.1rem;
    color: var(--color-neutral-400);
    font-size: 0.75rem;
    line-height: 1.45;
    text-align: right;
  }

  .writing-entry > time span:last-child {
    color: var(--color-neutral-300);
  }

  .writing-entry a {
    display: block;
    min-width: 0;
    margin: -0.55rem -0.65rem;
    padding: 0.55rem 0.65rem;
    border-radius: 0.75rem;
    outline: none;
    transition: background-color 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }

  .writing-entry a[aria-current="true"] {
    background: var(--color-neutral-100);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.045);
  }

  .writing-entry h2 {
    color: var(--color-neutral-800);
    font-size: 1rem;
    font-weight: 500;
  }

  .writing-entry p {
    max-width: 36rem;
    margin-top: 0.35rem;
    color: var(--color-neutral-500);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .writing-entry a:focus-visible {
    outline: 2px solid var(--color-neutral-800);
    outline-offset: 0.2rem;
  }

  .writing-divider {
    position: relative;
    display: grid;
    width: 1.25rem;
    flex: 0 0 1.25rem;
    place-items: center;
    cursor: grab;
    outline: none;
    touch-action: none;
    user-select: none;
  }

  .writing-grip {
    display: grid;
    width: 0.5rem;
    height: 6.5rem;
    place-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: linear-gradient(to bottom, var(--split-accent-start), var(--split-accent-end));
    box-shadow:
      0 0 0 0.25rem rgb(0 0 0 / 0.045),
      0 3px 10px rgb(0 0 0 / 0.12);
    transition: box-shadow 140ms var(--ease-out);
  }

  .writing-grip span {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: white;
  }

  .writing-divider:focus-visible .writing-grip {
    box-shadow:
      0 0 0 0.25rem var(--color-neutral-50),
      0 0 0 0.375rem var(--color-neutral-800),
      0 3px 10px rgb(0 0 0 / 0.12);
  }

  .writing-workspace[data-dragging="true"] .writing-list-pane {
    transition: none;
    will-change: flex-basis;
  }

  .writing-workspace[data-dragging="true"] .writing-grip {
    box-shadow:
      0 0 0 0.25rem rgb(77 163 255 / 0.14),
      0 5px 14px rgb(0 0 0 / 0.14);
  }

  .writing-workspace[data-dragging="true"] .writing-divider {
    cursor: grabbing;
  }

  .writing-detail {
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    overflow-wrap: anywhere;
    scrollbar-color: var(--color-neutral-300) transparent;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
  }

  .writing-detail[hidden] {
    display: none;
  }

  .writing-detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .writing-detail-header time {
    color: var(--color-neutral-400);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .writing-detail-header h2 {
    max-width: 22ch;
    margin-top: 0.45rem;
    color: var(--color-neutral-800);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .writing-detail-header p {
    max-width: 38rem;
    margin-top: 0.7rem;
    color: var(--color-neutral-500);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .writing-detail-open {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.25rem;
    padding-block: 0.2rem;
    color: var(--color-neutral-500);
    font-size: 0.75rem;
    font-weight: 500;
    outline: none;
  }

  .writing-detail-open :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .writing-detail-open:focus-visible {
    border-radius: 0.75rem;
    outline: 2px solid var(--color-neutral-800);
    outline-offset: 0.25rem;
  }

  .writing-prose {
    max-width: 70ch;
    color: var(--color-neutral-600);
    font-size: 1rem;
    line-height: 1.65;
  }

  .writing-prose :global(p) {
    margin-bottom: 1rem;
  }

  .writing-prose :global(h2) {
    scroll-margin-top: 2rem;
    margin-top: 3rem;
    margin-bottom: 0.55rem;
    color: var(--color-neutral-800);
    font-weight: 550;
  }

  .writing-prose :global(h3) {
    scroll-margin-top: 2rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-neutral-800);
    font-size: 1rem;
    font-weight: 600;
  }

  .writing-prose :global(a) {
    color: var(--color-neutral-800);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-neutral-300);
    text-underline-offset: 3px;
  }

  .writing-prose :global(strong) {
    color: var(--color-neutral-800);
    font-weight: 600;
  }

  .writing-prose :global(code) {
    padding: 0.12rem 0.3rem;
    border-radius: 0.3rem;
    color: var(--color-neutral-800);
    background: var(--color-neutral-100);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875em;
  }

  .writing-readout {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 0.25rem;
    margin: 2rem auto 0;
    padding: 0.25rem;
    border-radius: 999px;
    color: var(--color-neutral-500);
    background: var(--color-neutral-100);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.045), 0 3px 10px rgb(0 0 0 / 0.05);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .writing-readout > span {
    min-width: 5.25rem;
    padding: 0.85rem 0.75rem;
    border-radius: 999px;
    text-align: center;
    background: white;
  }

  .writing-readout .writing-readout-ratio {
    min-width: 3.5rem;
    color: white;
    background: var(--split-accent-chip, #12aff3);
    box-shadow: 0 2px 6px rgb(17 174 239 / 0.25);
    transition: background-color 180ms var(--ease-out), box-shadow 180ms var(--ease-out);
  }

  .writing-workspace[data-snapped="false"] + .writing-readout .writing-readout-ratio {
    background: var(--color-neutral-900);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.18);
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-close:hover {
      color: var(--color-neutral-800);
    }

    .writing-entry a:hover h2 {
      color: var(--color-neutral-950);
    }

    .writing-detail-open:hover {
      color: var(--color-neutral-800);
    }

    .writing-prose :global(a:hover) {
      text-decoration-color: var(--color-neutral-500);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-list-pane,
    .writing-grip,
    .writing-readout-ratio {
      transition-duration: 0ms;
    }
  }

  @media (max-width: 47.999rem) {
    .writing-index {
      width: min(100% - 2rem, 43.25rem);
      padding-block: 1.5rem 4rem;
    }

    .writing-header {
      margin-bottom: 3.5rem;
    }

    .writing-workspace {
      display: block;
      height: auto;
    }

    .writing-list-pane {
      padding: 0;
      overflow: visible;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .writing-divider,
    .writing-detail-pane,
    .writing-readout {
      display: none;
    }

    .writing-timeline::before {
      left: 0.25rem;
    }

    .writing-entry {
      display: block;
      padding: 1.1rem 0 1.1rem 1.5rem;
    }

    .writing-entry::before {
      top: 1.45rem;
      left: 0;
    }

    .writing-entry > time {
      display: flex;
      gap: 0.3rem;
      margin-bottom: 0.4rem;
      padding: 0;
      text-align: left;
    }

    .writing-entry a {
      margin: 0;
      padding: 0;
      background: transparent;
      box-shadow: none;
    }

    .writing-entry a[aria-current="true"] {
      background: transparent;
      box-shadow: none;
    }
  }
</style>

<script>
  const SNAP_POINTS = [0.25, 0.5, 0.75] as const;
  const MIN_RATIO = 0.15;
  const MAX_RATIO = 0.85;
  const desktopSplit = matchMedia("(min-width: 48rem)");

  const clampRatio = (value: number) => Math.min(MAX_RATIO, Math.max(MIN_RATIO, value));
  const nearestSnap = (value: number) =>
    SNAP_POINTS.reduce((nearest, point) =>
      Math.abs(point - value) < Math.abs(nearest - value) ? point : nearest,
    );

  document.querySelectorAll<HTMLElement>("[data-writing-split]").forEach((split) => {
    const listPane = split.querySelector<HTMLElement>(".writing-list-pane");
    const detailPane = split.querySelector<HTMLElement>(".writing-detail-pane");
    const divider = split.querySelector<HTMLElement>("[data-writing-divider]");
    const readout = split.nextElementSibling;
    const leftWidth = readout?.querySelector<HTMLElement>("[data-writing-left-width]");
    const rightWidth = readout?.querySelector<HTMLElement>("[data-writing-right-width]");
    const ratioValue = readout?.querySelector<HTMLElement>("[data-writing-ratio]");
    const selectors = [...split.querySelectorAll<HTMLAnchorElement>("[data-writing-select]")];
    const details = [...split.querySelectorAll<HTMLElement>("[data-writing-detail]")];

    if (!listPane || !detailPane || !divider || !leftWidth || !rightWidth || !ratioValue) return;

    let ratio = 0.5;
    let activePointer: number | null = null;
    let grabOffset = 0;

    const geometry = () => {
      const rect = split.getBoundingClientRect();
      const dividerWidth = divider.getBoundingClientRect().width;
      return { rect, dividerWidth, available: Math.max(1, rect.width - dividerWidth) };
    };

    const renderRatio = (nextRatio: number, snapped: boolean) => {
      ratio = clampRatio(nextRatio);
      const { available } = geometry();
      const listWidth = available * ratio;
      const articleWidth = available - listWidth;
      const percent = Math.round(ratio * 100);

      split.style.setProperty("--split-left", `${listWidth}px`);
      split.dataset.snapped = String(snapped);
      divider.setAttribute("aria-valuenow", String(percent));
      divider.setAttribute("aria-valuetext", `${percent}% list, ${100 - percent}% article`);
      leftWidth.textContent = `W ${Math.round(listWidth)}`;
      rightWidth.textContent = `W ${Math.round(articleWidth)}`;
      ratioValue.textContent = `${percent}%`;
    };

    const liveRatio = () => {
      const { available } = geometry();
      return clampRatio(listPane.getBoundingClientRect().width / available);
    };

    const finishDrag = (pointerId?: number) => {
      if (activePointer === null) return;
      if (pointerId !== undefined && divider.hasPointerCapture(pointerId)) {
        divider.releasePointerCapture(pointerId);
      }
      activePointer = null;
      split.dataset.dragging = "false";
      document.documentElement.classList.remove("is-writing-resizing");
      renderRatio(nearestSnap(ratio), true);
    };

    divider.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary || event.button !== 0) return;
      event.preventDefault();
      const { rect, dividerWidth, available } = geometry();

      // Freeze at the visible width so grabbing during a snap never jumps to its target.
      ratio = clampRatio(listPane.getBoundingClientRect().width / available);
      split.dataset.dragging = "true";
      split.dataset.snapped = "false";
      renderRatio(ratio, false);
      grabOffset = event.clientX - (rect.left + available * ratio + dividerWidth / 2);
      activePointer = event.pointerId;
      divider.setPointerCapture(event.pointerId);
      document.documentElement.classList.add("is-writing-resizing");
    });

    divider.addEventListener("pointermove", (event) => {
      if (event.pointerId !== activePointer) return;
      const { rect, dividerWidth, available } = geometry();
      const pointer = event.clientX - grabOffset - rect.left - dividerWidth / 2;
      renderRatio(pointer / available, false);
    });

    divider.addEventListener("pointerup", (event) => finishDrag(event.pointerId));
    divider.addEventListener("pointercancel", (event) => finishDrag(event.pointerId));
    divider.addEventListener("lostpointercapture", () => finishDrag());
    divider.addEventListener("dblclick", () => renderRatio(0.5, true));

    divider.addEventListener("keydown", (event) => {
      const current = ratio;
      let next: number | undefined;
      const step = event.shiftKey ? 0.01 : 0.05;

      if (event.key === "ArrowLeft") {
        next = Number((current - step).toFixed(2));
      } else if (event.key === "ArrowRight") {
        next = Number((current + step).toFixed(2));
      } else if (event.key === "Home") {
        next = MIN_RATIO;
      } else if (event.key === "End") {
        next = MAX_RATIO;
      } else if (event.key === "Enter" || event.key === " ") {
        next = 0.5;
      }

      if (next === undefined) return;
      event.preventDefault();
      split.dataset.dragging = "false";
      renderRatio(next, SNAP_POINTS.some((point) => Math.abs(point - next) < 0.001));
    });

    selectors.forEach((selector) => {
      selector.addEventListener("click", (event) => {
        if (
          !desktopSplit.matches ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) return;

        const id = selector.dataset.writingSelect;
        if (!id) return;
        event.preventDefault();
        selectors.forEach((item) => {
          if (item === selector) item.setAttribute("aria-current", "true");
          else item.removeAttribute("aria-current");
        });
        details.forEach((detail) => detail.toggleAttribute("hidden", detail.dataset.writingDetail !== id));
        detailPane.scrollTop = 0;
      });
    });

    new ResizeObserver(() => renderRatio(ratio, split.dataset.snapped === "true")).observe(split);
    renderRatio(0.5, true);
  });
</script>

<style is:global>
  html.is-writing-resizing,
  html.is-writing-resizing * {
    cursor: grabbing !important;
    user-select: none !important;
  }
</style>
