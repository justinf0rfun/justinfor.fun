---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
  mode: "overlay" | "standalone";
}

const { mode } = Astro.props;
const isOverlay = mode === "overlay";
const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<main
  class:list={["writing-stage", isOverlay && "is-overlay", !isOverlay && "is-open"]}
  data-writing-stage={mode}
  data-writing-state={isOverlay ? "closed" : "open"}
  aria-hidden={isOverlay ? "true" : undefined}
  inert={isOverlay ? true : undefined}
>
  <div class="writing-index">
    <header class="writing-header">
      <div data-writing-reveal>
        <h1>Writing</h1>
        <p>{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
      </div>
      {
        isOverlay ? (
          <button class="writing-close" data-writing-close type="button" aria-label="Close">
            <Icon name="ph:x" />
          </button>
        ) : (
          <a class="writing-close" href="/" aria-label="Back to home">
            <Icon name="ph:x" />
          </a>
        )
      }
    </header>

    <div class="writing-timeline">
      {posts.map((post, index) => (
        <article
          class="writing-entry"
          data-writing-reveal
          data-writing-paper-target={index === 0 ? "" : undefined}
        >
          <time datetime={post.data.publishedAt.toISOString()}>
            <span>{formatDate(post.data.publishedAt)}</span>
            <span>{post.data.publishedAt.getUTCFullYear()}</span>
          </time>
          <a href={`/writing/${post.id}`}>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</main>

<style>
  .writing-stage {
    min-height: 100vh;
    color: var(--color-neutral-800);
    background: var(--color-neutral-50);
  }

  .writing-stage.is-overlay {
    position: fixed;
    inset: 0;
    z-index: 45;
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease-out), visibility 0s linear 220ms;
  }

  .writing-stage.is-overlay.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .writing-index {
    width: min(100% - 3rem, 43.25rem);
    min-height: 100vh;
    margin-inline: auto;
    padding-block: 6rem;
  }

  .writing-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 4.5rem;
  }

  .writing-header h1 {
    color: var(--color-neutral-800);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .writing-header p {
    margin-top: 0.125rem;
    color: var(--color-neutral-500);
    font-size: 0.75rem;
  }

  .writing-close {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 999px;
    color: var(--color-neutral-500);
    background: rgb(255 255 255 / 0.78);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.05);
    transition: color 160ms var(--ease-out), transform 160ms var(--ease-out);
  }

  .writing-close :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .writing-close:active {
    transform: scale(0.94);
  }

  .writing-timeline {
    position: relative;
  }

  .writing-timeline::before {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 6.1rem;
    width: 1px;
    content: "";
    background: var(--color-neutral-200);
  }

  .writing-entry {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 2.25rem;
    padding-block: 1.4rem;
  }

  .writing-entry::before {
    position: absolute;
    top: 1.82rem;
    left: 5.84rem;
    z-index: 1;
    width: 0.5625rem;
    height: 0.5625rem;
    border: 2px solid var(--color-neutral-50);
    border-radius: 999px;
    content: "";
    background: var(--color-neutral-300);
  }

  .writing-entry:first-child::before {
    background: #dc6a4b;
  }

  .writing-entry > time {
    display: grid;
    align-content: start;
    padding-top: 0.1rem;
    color: var(--color-neutral-400);
    font-size: 0.75rem;
    line-height: 1.45;
    text-align: right;
  }

  .writing-entry > time span:last-child {
    color: var(--color-neutral-300);
  }

  .writing-entry a {
    display: block;
    min-width: 0;
    outline: none;
  }

  .writing-entry h2 {
    color: var(--color-neutral-800);
    font-size: 1rem;
    font-weight: 500;
  }

  .writing-entry p {
    max-width: 36rem;
    margin-top: 0.35rem;
    color: var(--color-neutral-500);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .writing-entry a:focus-visible {
    border-radius: 0.5rem;
    outline: 2px solid var(--color-neutral-800);
    outline-offset: 0.4rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-close:hover {
      color: var(--color-neutral-800);
    }

    .writing-entry a:hover h2 {
      color: var(--color-neutral-950);
    }
  }

  @media (max-width: 40rem) {
    .writing-index {
      width: min(100% - 2rem, 43.25rem);
      padding-block: 1.5rem 4rem;
    }

    .writing-header {
      margin-bottom: 3.5rem;
    }

    .writing-timeline::before {
      left: 0.25rem;
    }

    .writing-entry {
      display: block;
      padding: 1.1rem 0 1.1rem 1.5rem;
    }

    .writing-entry::before {
      top: 1.45rem;
      left: 0;
    }

    .writing-entry > time {
      display: flex;
      gap: 0.3rem;
      margin-bottom: 0.4rem;
      padding: 0;
      text-align: left;
    }
  }
</style>
