---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const entries = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  entries.length > 0 && (
    <nav class="article-toc" data-article-toc aria-label="On this page">
      <div>
        {entries.map((entry, index) => (
          <a
            class="article-toc-entry"
            data-active={index === 0 ? "true" : undefined}
            data-toc-entry
            href={`#${entry.slug}`}
            aria-current={index === 0 ? "location" : undefined}
          >
            <span class="article-toc-meter" aria-hidden="true">
              <span class:list={["article-toc-baton", entry.depth === 3 && "is-nested"]} />
            </span>
            <span class="article-toc-label">{entry.text}</span>
          </a>
        ))}
      </div>
    </nav>
  )
}

<style>
  .article-toc {
    position: fixed;
    top: 50%;
    left: 2rem;
    display: none;
    width: 15.25rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    transform: translateY(-50%);
    scrollbar-width: none;
  }

  .article-toc::-webkit-scrollbar {
    display: none;
  }

  .article-toc-entry {
    position: relative;
    display: flex;
    height: 1.5rem;
    align-items: center;
    padding-inline: 1rem;
    border-radius: 0.5rem;
    outline: none;
    transition: background-color 200ms ease-out;
  }

  .article-toc-meter {
    display: flex;
    width: 1.375rem;
    flex: none;
    align-items: center;
    opacity: 1;
    transition: opacity 200ms ease-out;
  }

  .article-toc-baton {
    width: 1.375rem;
    height: 1.5px;
    flex: none;
    border-radius: 999px;
    background: #d9d9d9;
    transition: background-color 200ms ease-out;
  }

  .article-toc-baton.is-nested {
    width: 0.75rem;
  }

  .article-toc-label {
    position: absolute;
    top: 50%;
    right: 1rem;
    left: 1rem;
    overflow: hidden;
    color: #747474;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 200ms ease-out, color 200ms ease-out;
  }

  .article-toc-entry[data-active="true"] .article-toc-baton {
    background: #202020;
  }

  .article-toc-entry[data-active="true"] .article-toc-label {
    color: #202020;
  }

  .article-toc:hover .article-toc-meter,
  .article-toc:focus-within .article-toc-meter {
    opacity: 0;
  }

  .article-toc:hover .article-toc-label,
  .article-toc:focus-within .article-toc-label {
    opacity: 1;
  }

  .article-toc-entry:focus-visible {
    background: #f6f6f6;
    outline: 2px solid #747474;
    outline-offset: -2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .article-toc-entry:hover {
      background: #f6f6f6;
    }

    .article-toc-entry:hover .article-toc-label {
      color: #202020;
    }
  }

  @media (min-width: 80rem) {
    .article-toc {
      display: block;
    }
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>("[data-article-toc]");

  if (toc) {
    const entries = [...toc.querySelectorAll<HTMLAnchorElement>("[data-toc-entry]")];
    let active = entries[0]?.hash.slice(1) ?? "";
    let frame = 0;

    const renderActive = (next: string) => {
      if (next === active) return;
      active = next;
      entries.forEach((entry) => {
        const isActive = entry.hash.slice(1) === active;
        if (isActive) {
          entry.dataset.active = "true";
          entry.setAttribute("aria-current", "location");
        } else {
          delete entry.dataset.active;
          entry.removeAttribute("aria-current");
        }
      });
    };

    const update = () => {
      let next = entries[0]?.hash.slice(1) ?? "";
      for (const entry of entries) {
        const id = entry.hash.slice(1);
        const heading = document.getElementById(id);
        if (heading && heading.getBoundingClientRect().top <= 81) next = id;
      }
      renderActive(next);
    };

    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };

    update();
    addEventListener("scroll", scheduleUpdate, { passive: true });
    addEventListener("resize", scheduleUpdate, { passive: true });
  }
</script>
