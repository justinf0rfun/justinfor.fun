---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const entries = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  entries.length > 0 && (
    <nav class="article-toc" data-article-toc aria-label="On this page">
      <div class="article-toc-list">
        {entries.map((entry, index) => (
          <a
            class="article-toc-entry"
            data-active={index === 0 ? "true" : undefined}
            data-toc-entry
            style={`--toc-delay: ${Math.min(index, 4) * 50}ms`}
            href={`#${entry.slug}`}
            aria-current={index === 0 ? "location" : undefined}
          >
            <span class="article-toc-meter" aria-hidden="true">
              <span class="article-toc-baton" />
            </span>
            <span class="article-toc-label">{entry.text}</span>
          </a>
        ))}
      </div>
    </nav>
  )
}

<style>
  .article-toc {
    --toc-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed;
    top: 10rem;
    left: 2rem;
    display: none;
    width: clamp(12.5rem, calc(50vw - 25.125rem), 15.25rem);
    max-height: calc(100svh - 18rem - var(--article-actions-height, 5rem));
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .article-toc-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: gap 450ms var(--toc-ease);
  }

  .article-toc-entry {
    position: relative;
    display: flex;
    height: 0.625rem;
    flex: none;
    align-items: center;
    overflow: hidden;
    padding-inline: 0.5rem;
    border-radius: 0.5rem;
    outline: none;
    transition: height 300ms var(--toc-ease), background-color 200ms ease-out;
  }

  .article-toc-meter {
    display: flex;
    width: 1.875rem;
    flex: none;
    align-items: center;
  }

  .article-toc-baton {
    width: 1.375rem;
    height: 2px;
    flex: none;
    border-radius: 999px;
    background: #d9d9d9;
    transform: scaleX(0.5455);
    transform-origin: left center;
    transition: opacity 250ms ease, transform 300ms var(--toc-ease), background-color 200ms ease-out;
  }

  .article-toc-label {
    position: absolute;
    top: 50%;
    inset-inline: 0.5rem;
    overflow: hidden;
    color: #747474;
    font-size: 0.8125rem;
    line-height: 1.5rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0;
    filter: blur(4px);
    pointer-events: none;
    translate: -4px -50%;
    transition:
      opacity 150ms ease,
      filter 300ms var(--toc-ease),
      translate 300ms var(--toc-ease),
      color 200ms ease-out;
  }

  .article-toc-entry[data-active="true"] .article-toc-baton {
    background: #202020;
    transform: scaleX(1);
  }

  .article-toc-entry[data-active="true"] .article-toc-label,
  .article-toc-entry:focus-visible .article-toc-label {
    color: #202020;
  }

  .article-toc-entry:focus-visible {
    background: #ededed;
    box-shadow: inset 0 0 0 1px #747474;
  }

  .article-toc:focus-within .article-toc-list {
    gap: 4px;
  }

  .article-toc:focus-within .article-toc-entry {
    height: 1.5rem;
    transition-delay: var(--toc-delay), 0s;
  }

  .article-toc:focus-within .article-toc-baton {
    opacity: 0;
    transform: scaleX(0.15);
  }

  .article-toc:focus-within .article-toc-label {
    opacity: 1;
    filter: blur(0);
    translate: 0 -50%;
    transition:
      opacity 400ms ease var(--toc-delay),
      filter 550ms var(--toc-ease) var(--toc-delay),
      translate 550ms var(--toc-ease) var(--toc-delay),
      color 200ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .article-toc:hover .article-toc-list {
      gap: 4px;
    }

    .article-toc:hover .article-toc-entry {
      height: 1.5rem;
      transition-delay: var(--toc-delay), 0s;
    }

    .article-toc:hover .article-toc-baton {
      opacity: 0;
      transform: scaleX(0.15);
    }

    .article-toc:hover .article-toc-label {
      opacity: 1;
      filter: blur(0);
      translate: 0 -50%;
      transition:
        opacity 400ms ease var(--toc-delay),
        filter 550ms var(--toc-ease) var(--toc-delay),
        translate 550ms var(--toc-ease) var(--toc-delay),
        color 200ms ease-out;
    }

    .article-toc-entry:hover {
      background: #f0f0f0;
    }

    .article-toc-entry:hover .article-toc-label {
      color: #202020;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-toc-list,
    .article-toc-entry,
    .article-toc-baton,
    .article-toc .article-toc-entry .article-toc-label {
      transition: none;
    }
  }

  @media (min-width: 80rem) {
    .article-toc {
      display: block;
    }
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>("[data-article-toc]");

  if (toc) {
    const entries = [...toc.querySelectorAll<HTMLAnchorElement>("[data-toc-entry]")];
    let active = entries[0]?.hash.slice(1) ?? "";
    let frame = 0;

    const renderActive = (next: string) => {
      if (next === active) return;
      active = next;
      entries.forEach((entry) => {
        const isActive = entry.hash.slice(1) === active;
        if (isActive) {
          entry.dataset.active = "true";
          entry.setAttribute("aria-current", "location");
        } else {
          delete entry.dataset.active;
          entry.removeAttribute("aria-current");
        }
      });
    };

    const update = () => {
      let next = entries[0]?.hash.slice(1) ?? "";
      for (const entry of entries) {
        const id = entry.hash.slice(1);
        const heading = document.getElementById(id);
        if (heading && heading.getBoundingClientRect().top <= 81) next = id;
      }
      renderActive(next);
    };

    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };

    update();
    addEventListener("scroll", scheduleUpdate, { passive: true });
    addEventListener("resize", scheduleUpdate, { passive: true });
  }
</script>
