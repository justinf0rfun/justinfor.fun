---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const entries = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  entries.length > 0 && (
    <nav class="article-toc" data-article-toc aria-label="On this page">
      <div>
        {entries.map((entry, index) => (
          <a
            class="article-toc-entry"
            data-active={index === 0 ? "true" : undefined}
            data-toc-entry
            href={`#${entry.slug}`}
            aria-current={index === 0 ? "location" : undefined}
          >
            <span class="article-toc-meter" aria-hidden="true">
              <span class="article-toc-baton" />
            </span>
            <span class="article-toc-label">
              <span class="article-toc-title">{entry.text}</span>
              <span class="article-toc-summary" data-toc-summary aria-hidden="true" />
            </span>
          </a>
        ))}
      </div>
    </nav>
  )
}

<style>
  .article-toc {
    --preview-width: clamp(12.5rem, calc(50vw - 27.375rem), 17.625rem);
    position: fixed;
    top: 50%;
    left: 2rem;
    display: none;
    width: calc(var(--preview-width) + 2.75rem);
    max-height: calc(100vh - 6rem);
    transform: translateY(-50%);
  }

  .article-toc-entry {
    position: relative;
    display: flex;
    height: 1.5rem;
    align-items: center;
    padding-inline: 0.5rem;
    outline: none;
  }

  .article-toc-meter {
    display: flex;
    width: 1.875rem;
    flex: none;
    align-items: center;
  }

  .article-toc-baton {
    --marker-progress: 0;
    width: 1.625rem;
    height: 2px;
    flex: none;
    border-radius: 999px;
    background: #d9d9d9;
    opacity: 0.55;
    transform: scaleX(calc(0.2308 + 0.7692 * var(--marker-progress)));
    transform-origin: left center;
    transition: transform 160ms
      linear(
        0,
        0.398 10%,
        0.682 20%,
        0.843 30%,
        0.925 40%,
        0.972 50%,
        1.004 60%,
        1.008 70%,
        1.003 80%,
        1
      );
  }

  .article-toc-label {
    position: absolute;
    top: 50%;
    left: 2.75rem;
    width: var(--preview-width);
    overflow: hidden;
    padding: 0.625rem 0.75rem 0.6875rem;
    border: 1px solid #dedede;
    border-radius: 0.75rem;
    color: #424242;
    background: rgb(250 250 250 / 96%);
    box-shadow: 0 10px 28px rgb(0 0 0 / 8%);
    font-size: 0.8125rem;
    opacity: 0;
    pointer-events: none;
    transform: translate(-0.25rem, -50%) scale(0.98);
    transform-origin: left center;
    transition:
      opacity 125ms var(--ease-out),
      transform 125ms var(--ease-out);
  }

  .article-toc-title {
    display: -webkit-box;
    overflow: hidden;
    color: #2c2c2c;
    font-weight: 600;
    line-height: 1.25rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .article-toc-summary {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 0.375rem;
    color: #8c8c8c;
    line-height: 1.1875rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .article-toc-summary:empty {
    display: none;
  }

  .article-toc-entry[data-active="true"] .article-toc-baton {
    background: #202020;
    opacity: 0.65;
  }

  .article-toc-entry:focus-visible {
    outline: none;
  }

  .article-toc-entry:focus-visible .article-toc-baton {
    --marker-progress: 1;
    background: #202020;
    opacity: 1;
  }

  .article-toc-entry:focus-visible .article-toc-label {
    opacity: 1;
    transform: translate(0, -50%) scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .article-toc:hover
      .article-toc-entry[data-active="true"]:not(:hover):not(:focus-visible)
      .article-toc-baton {
      background: #d9d9d9;
      opacity: 0.55;
    }

    :is(
        .article-toc-entry:has(+ .article-toc-entry:hover),
        .article-toc-entry:hover + .article-toc-entry
      )
      .article-toc-baton {
      --marker-progress: 0.7;
    }

    :is(
        .article-toc-entry:has(+ .article-toc-entry + .article-toc-entry:hover),
        .article-toc-entry:hover + .article-toc-entry + .article-toc-entry
      )
      .article-toc-baton {
      --marker-progress: 0.4;
    }

    :is(
        .article-toc-entry:has(
            + .article-toc-entry + .article-toc-entry + .article-toc-entry:hover
          ),
        .article-toc-entry:hover
          + .article-toc-entry
          + .article-toc-entry
          + .article-toc-entry
      )
      .article-toc-baton {
      --marker-progress: 0.2;
    }

    .article-toc-entry:hover .article-toc-baton {
      --marker-progress: 1;
      background: #202020;
      opacity: 1;
    }

    .article-toc-entry:hover .article-toc-label {
      opacity: 1;
      transform: translate(0, -50%) scale(1);
      transition-delay: 120ms;
    }

    .article-toc:hover .article-toc-entry:not(:hover) .article-toc-label {
      transition-duration: 80ms;
      transition-delay: 0ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-toc-baton,
    .article-toc-label {
      transition-duration: 0s;
    }
  }

  @media (min-width: 80rem) {
    .article-toc {
      display: block;
    }
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>("[data-article-toc]");

  if (toc) {
    const entries = [...toc.querySelectorAll<HTMLAnchorElement>("[data-toc-entry]")];
    let active = entries[0]?.hash.slice(1) ?? "";
    let frame = 0;

    entries.forEach((entry) => {
      const heading = document.getElementById(entry.hash.slice(1));
      const summary = entry.querySelector<HTMLElement>("[data-toc-summary]");
      let sibling = heading?.nextElementSibling ?? null;

      while (sibling && !sibling.matches("h2, h3")) {
        const paragraph = sibling.matches("p") ? sibling : sibling.querySelector("p");
        const text = paragraph?.textContent?.replace(/\s+/g, " ").trim();
        if (text) {
          if (summary) summary.textContent = text;
          break;
        }
        sibling = sibling.nextElementSibling;
      }
    });

    const renderActive = (next: string) => {
      if (next === active) return;
      active = next;
      entries.forEach((entry) => {
        const isActive = entry.hash.slice(1) === active;
        if (isActive) {
          entry.dataset.active = "true";
          entry.setAttribute("aria-current", "location");
        } else {
          delete entry.dataset.active;
          entry.removeAttribute("aria-current");
        }
      });
    };

    const update = () => {
      let next = entries[0]?.hash.slice(1) ?? "";
      for (const entry of entries) {
        const id = entry.hash.slice(1);
        const heading = document.getElementById(id);
        if (heading && heading.getBoundingClientRect().top <= 81) next = id;
      }
      renderActive(next);
    };

    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };

    update();
    addEventListener("scroll", scheduleUpdate, { passive: true });
    addEventListener("resize", scheduleUpdate, { passive: true });
  }
</script>
