---
import RecordRack from "./RecordRack.astro";
import { musicTracks } from "../data/music";
interface Props { class?: string; }
const { class: className = "" } = Astro.props;
---
<a class:list={["music-folder", className]} href="/music" draggable="false" data-folder="music" data-music-entry aria-label={`Open Music, ${musicTracks.length} tracks on repeat`}>
  <div class="music-crate">
    <div class="music-crate-well" aria-hidden="true"></div>
    <div class="music-crate-records"><RecordRack compact id="music-mini" /></div>
    <div class="music-crate-front">
      <span class="music-crate-grip" aria-hidden="true"></span>
      <span class="music-crate-label">
        <span class="music-crate-title">Music</span>
        <span class="music-crate-count">{musicTracks.length} tracks</span>
      </span>
    </div>
  </div>
</a>

<style>
  .music-folder {
    display: block;
    color: #f8ead7;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .music-crate {
    --crate-mouth: 62%;
    --wood-light: #7b5140;
    --wood-mid: #654031;
    --wood-dark: #472c23;
    --wood-edge: #b48464;
    position: relative;
    isolation: isolate;
    aspect-ratio: 20 / 17;
    transition: translate 180ms var(--ease-out, ease-out);
  }
  .music-crate-well {
    position: absolute;
    inset: 38% 0 calc(100% - var(--crate-mouth) - 3px);
    border-radius: 9% 9% 0 0 / 25% 25% 0 0;
    clip-path: polygon(10% 0, 90% 0, 100% 100%, 0 100%);
    background:
      linear-gradient(106deg, var(--wood-edge) 9.5%, var(--wood-light) 10%, #5d3929 13.5%, transparent 14%),
      linear-gradient(-106deg, var(--wood-light) 9.5%, var(--wood-edge) 10%, #603c2d 13.5%, transparent 14%),
      linear-gradient(var(--wood-edge) 0 1px, var(--wood-light) 1px 13%, #231913 15%, #3e2a21);
  }
  .music-crate-records {
    position: absolute;
    z-index: 1;
    inset: 1% 5% calc(100% - var(--crate-mouth));
    overflow: hidden;
    container-type: size;
  }
  .music-crate-front {
    position: absolute;
    z-index: 2;
    inset: var(--crate-mouth) 0 0;
    display: grid;
    grid-template-rows: 24% 1fr;
    gap: 6%;
    padding: 6% 11% 5%;
    border-radius: 3px 3px 6px 6px;
    background:
      repeating-linear-gradient(0deg, #170e0b0e 0 1px, transparent 1px 4px, #fae1ba08 4px 5px, transparent 5px 8px),
      repeating-linear-gradient(.6deg, transparent 0 6px, #f8c18c09 6px 7px, transparent 7px 13px),
      linear-gradient(89deg, #26171129, transparent 8%, #e9b3890b 55%, #28171129),
      linear-gradient(var(--wood-light), var(--wood-mid) 58%, var(--wood-dark));
    box-shadow:
      inset 0 1px #ffe0b976,
      inset 0 -2px #2e1c1582,
      inset 1px 0 #fddbb638,
      inset -1px 0 #27170d66,
      0 2px 3px #371e2020,
      0 12px 16px -8px #39251970;
  }
  .music-crate-front::before,
  .music-crate-front::after {
    content: "";
    position: absolute;
    inset-block: 2px;
    width: 2.4%;
    background: repeating-linear-gradient(0deg, #321b1996 0 2px, #e7ad8530 3px 7px, transparent 8px 11px);
    opacity: .45;
    pointer-events: none;
  }
  .music-crate-front::before { left: 2px; }
  .music-crate-front::after { right: 2px; }
  .music-crate-grip {
    justify-self: center;
    width: 28%;
    height: clamp(4px, 100%, 8px);
    border-radius: 999px;
    background: linear-gradient(#241611, #3a251d);
    box-shadow: inset 0 1px 2px #180e0ad9, 0 1px #d7a88379;
  }
  .music-crate-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    align-self: center;
    gap: 4px;
    line-height: 1;
    white-space: nowrap;
  }
  .music-crate-title { font-size: 15px; font-weight: 550; }
  .music-crate-count {
    color: #eed1b4;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .music-folder:focus-visible { outline: none; }
  .music-folder:focus-visible .music-crate-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  :global(html[data-home-theme=dark]) .music-crate {
    --wood-light: #795844;
    --wood-mid: #5f4233;
    --wood-dark: #4b3127;
    --wood-edge: #b18b6c;
  }
  @media (max-width: 400px) {
    .music-crate-title { font-size: 13px; }
    .music-crate-count { font-size: 10px; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .music-folder:hover .music-crate { translate: 0 -2px; }
    .music-folder:active .music-crate { translate: 0 1px; }
  }
</style>
