---
import RecordRack from "./RecordRack.astro";
import { musicTracks } from "../data/music";
interface Props { class?: string; }
const { class: className = "" } = Astro.props;
---
<a class:list={["music-folder",className]} href="/music" draggable="false" data-folder="music" data-music-entry aria-label={`Open Music, ${musicTracks.length} tracks on repeat`}>
  <div class="music-folder-body">
    <div class="music-folder-rack"><RecordRack compact id="music-mini" /></div>
    <div class="music-folder-lip" aria-hidden="true"></div>
    <div class="music-folder-caption"><div><p>Music</p><span>{musicTracks.length} tracks on repeat</span></div><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
  </div>
</a>
<style>
  .music-folder{display:block;outline:none;text-decoration:none;color:var(--home-ink,#202221);-webkit-tap-highlight-color:transparent}
  .music-folder-body{position:relative;aspect-ratio:20/17;width:100%;border-radius:24px;background:linear-gradient(145deg,#f4f4f4,#e9e9e9);box-shadow:inset 0 1px #fff,0 1px 2px #00000008,0 12px 18px -14px #0002;transition:box-shadow 180ms}
  .music-folder-rack{position:absolute;inset:0 4% 26%;overflow:hidden;border-radius:24px 24px 0 0}
  .music-folder-lip{position:absolute;inset:auto 0 24%;height:14px;background:linear-gradient(transparent,#00000008);pointer-events:none}
  .music-folder-caption{position:absolute;inset:auto 0 0;display:flex;align-items:flex-end;justify-content:space-between;padding:20px;gap:10px}
  .music-folder-caption p{font-size:14px;font-weight:500;line-height:1.4}
  .music-folder-caption span{display:block;margin-top:2px;font-size:12px;color:var(--home-muted,#858585);white-space:nowrap}
  .music-folder-caption svg{flex:none;color:var(--home-muted,#858585)}
  .music-folder:focus-visible{outline:none}
  .music-folder:focus-visible .music-folder-caption p{text-decoration:underline;text-underline-offset:3px}
  :global(html[data-home-theme=dark]) .music-folder-body{background:linear-gradient(145deg,#242424,#171717);box-shadow:inset 0 1px #ffffff14,0 1px 2px #0004,0 12px 18px -14px #0008}
  @media(hover:hover) and (pointer:fine){.music-folder:hover .music-folder-body{box-shadow:inset 0 1px #fff8,0 2px 4px #0001,0 16px 24px -14px #0003}}
  @media(max-width:400px){.music-folder-body{border-radius:20px}.music-folder-caption{padding:15px}.music-folder-caption span{font-size:11px}}
</style>
