---
import { bookNumber, type Book } from "../data/books";
interface Props { book: Book; eager?: boolean }
const { book, eager = false } = Astro.props;
const cover = book.cover;
---

<span class="book-jacket" aria-hidden="true" data-jacket-image={cover ?? undefined}
  style={{ "--jacket": book.color, "--jacket-ink": book.ink }}>
  <span class="jacket-series"><span>{book.stage}</span><span>{bookNumber(book)}</span></span>
  <span class="jacket-title">{book.spine}</span>
  <span class="jacket-authors">{book.short}</span>
  {cover && eager && <img data-book-image src={cover} alt="" width="420" height={Math.round(420 / book.aspect)}
    draggable="false" decoding="async" />}
</span>

<script>
  const reveal = (image: HTMLImageElement) => {
    if (image.naturalWidth < 40) return;
    image.dataset.ready = "";
    image.closest(".book-jacket")?.querySelectorAll(":scope > span").forEach((lettering) => lettering.remove());
  };

  document.addEventListener("load", ({ target }) => {
    if (target instanceof HTMLImageElement && target.hasAttribute("data-book-image")) reveal(target);
  }, true);
  document.addEventListener("error", ({ target }) => {
    if (target instanceof HTMLImageElement && target.hasAttribute("data-book-image")) target.remove();
  }, true);
  document.querySelectorAll<HTMLImageElement>("img[data-book-image]").forEach(reveal);
</script>

<style>
  .book-jacket {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 7.5% 9% 9%;
    overflow: hidden;
    container-type: inline-size;
    border-radius: inherit;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / .03) 0 1px, transparent 1px 3px),
      linear-gradient(155deg, rgb(255 255 255 / .095), rgb(18 14 12 / .12)),
      var(--jacket);
    color: var(--jacket-ink);
  }

  .book-jacket::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(0 0 0 / .23), transparent 3%, rgb(255 255 255 / .09) 4%, transparent 6%);
    box-shadow: inset 0 0 0 1px rgb(36 28 20 / .13);
  }

  .jacket-series, .jacket-authors {
    display: flex;
    justify-content: space-between;
    gap: 5%;
    border-block-start: 1px solid currentColor;
    padding-block-start: 4%;
    font-size: max(9px, 4.6cqw);
    line-height: 1.2;
  }
  .jacket-series { letter-spacing: .045em; }

  .jacket-title {
    align-self: center;
    font: 650 14cqw / 1.04 Georgia, serif;
    letter-spacing: -.055em;
    overflow-wrap: anywhere;
  }

  .book-jacket :global(img[data-book-image]) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
    visibility: hidden;
  }
  .book-jacket :global(img[data-book-image][data-ready]) { visibility: visible; }
  .book-jacket:has(:global(img[data-book-image][data-ready])) > span { visibility: hidden; }
</style>
