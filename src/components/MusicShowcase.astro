---
import ParentLink from "./ParentLink.astro";
import RecordRack from "./RecordRack.astro";
import { Icon } from "astro-icon/components";
import { musicTracks, type MusicService } from "../data/music";
import { INITIAL_RECORD } from "../lib/record-rack";
interface Props { mode?: "standalone" | "overlay"; }
const { mode = "standalone" } = Astro.props;
const isOverlay = mode === "overlay";
const services: Record<MusicService,{name:string;icon:string}> = {"apple-music":{name:"Apple Music",icon:"ph:apple-logo-fill"},spotify:{name:"Spotify",icon:"simple-icons:spotify"}};
---
{!isOverlay && <script is:inline>
  let musicMode="system";
  try { const saved=localStorage.getItem("home-theme"); if(["system","light","dark"].includes(saved))musicMode=saved; } catch {}
  document.documentElement.dataset.homeMode=musicMode;
  document.documentElement.dataset.homeTheme=musicMode==="system"?(matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light"):musicMode;
</script>}
<main class:list={["music-page",isOverlay&&"is-overlay"]} data-record-page data-music-preview data-music-stage={mode} data-music-view="browse" aria-hidden={isOverlay?"true":undefined} inert={isOverlay?true:undefined} role={isOverlay?"dialog":undefined} aria-modal={isOverlay?"true":undefined} aria-labelledby={`music-title-${mode}`}>
  <header class="music-header">
    <ParentLink label="Home" href={isOverlay?undefined:"/"} {...(isOverlay?{"data-music-close":""}:{})} />
    <div><h1 id={`music-title-${mode}`}>Music</h1><p>{musicTracks.length} tracks on repeat</p></div>
  </header>
  <div class="music-record-area"><RecordRack id={`music-${mode}`} /></div>
  <footer class="music-browse" data-record-browse>
    <p class="music-quote">也许有天没音乐，我只见见你也好</p>
    <div class="music-browse-row"><div><p class="music-current"><span data-record-current>{musicTracks[INITIAL_RECORD].title}</span><span class="music-count" data-record-count>{String(INITIAL_RECORD+1).padStart(2,"0")} / {musicTracks.length}</span></p><p class="music-artist" data-record-artist-label>{musicTracks[INITIAL_RECORD].artist}</p></div><button type="button" class="music-take" data-record-open>Take out <span aria-hidden="true">↑</span></button></div>
    <p class="music-hint">Scroll or drag to flip · Tap a sleeve to take it out</p>
  </footer>
  <div class="music-detail-deck" data-record-details>
    {musicTracks.map(track=><section class="music-detail-panel" data-record-panel={track.slug} data-music-track={track.slug} data-music-title={`${track.title} by ${track.artist}`} data-preview-url={track.previewUrl} data-music-state={track.previewUrl?"idle":undefined} hidden>
      <h2>{track.title}</h2><p class="music-detail-artist">{track.artist}</p><p class="music-detail-album">{track.album}</p>
      <div class="music-actions">
        {track.previewUrl&&<button type="button" data-music-action class="music-preview-button" aria-label={`Play ${track.title} by ${track.artist}`}><svg class="music-play-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5.4 3.4a.8.8 0 0 1 1.2-.68l5.2 4.6a.9.9 0 0 1 0 1.36l-5.2 4.6a.8.8 0 0 1-1.2-.68V3.4Z" fill="currentColor"/></svg><span class="music-eq" aria-hidden="true"><i></i><i></i><i></i></span><span>Preview</span></button>}
        <a href={track.externalUrl} target="_blank" rel="noreferrer" class="music-service" aria-label={`Open ${track.title} by ${track.artist} on ${services[track.service].name}`}><Icon name={services[track.service].icon}/><span>{services[track.service].name}</span><span aria-hidden="true">↗</span></a>
      </div>
      <p class="music-blocked">Tap Preview to enable sound.</p>
    </section>)}
  </div>
  <noscript><style>.music-record-area,.music-browse{display:none}.music-page{overflow:auto}.music-no-script{padding:120px 24px 40px;max-width:600px;margin:auto}.music-no-script li{margin-bottom:20px}</style><ol class="music-no-script">{musicTracks.map(track=><li><a href={track.externalUrl} target="_blank" rel="noreferrer">{track.title} — {track.artist}</a></li>)}</ol></noscript>
</main>
<style>
  .music-page{--music-paper:#f7f7f8;--music-ink:#202221;--music-muted:#777;--music-accent:#316ff0;position:relative;width:100%;height:100svh;height:100dvh;overflow:hidden;color:var(--music-ink);isolation:isolate}
  :global(html[data-home-theme=dark]) .music-page{--music-paper:#111419;--music-ink:#f3f3f5;--music-muted:#a1a5ad;--music-accent:#8ab4ff;color-scheme:dark}
  .music-page::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 50% 42%,color-mix(in srgb,var(--music-ink) 3%,var(--music-paper)),var(--music-paper) 72%);transition:opacity 180ms;pointer-events:none}
  .music-page.is-overlay{position:fixed;inset:0;z-index:45;visibility:hidden;pointer-events:none}
  .music-page.is-overlay::before{opacity:0}
  .music-page.is-overlay.is-open{visibility:visible;pointer-events:auto}
  .music-page.is-overlay:not(.is-open) :is(.music-header,.music-browse){opacity:0}
  .music-page.is-overlay.is-open:not(.is-closing)::before{opacity:1}
  .music-header{position:absolute;inset:0 0 auto;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:24px;text-align:right;transition:opacity 160ms}
  .music-header h1{font-size:14px;font-weight:500}.music-header p{font-size:12px;color:var(--music-muted);margin-top:2px}
  .music-header :global(.parent-link){color:var(--music-muted)}
  .music-header :global(.parent-link-arrow),.music-header :global(.parent-link:hover){color:var(--music-ink)}
  .music-record-area{position:absolute;inset:88px 0 0;min-height:0}
  .music-browse{position:absolute;left:50%;bottom:max(25px,env(safe-area-inset-bottom));z-index:3;transform:translateX(-50%);width:min(430px,calc(100% - 40px));transition:opacity 150ms,visibility 0s}
  .music-quote{text-align:center;color:var(--music-muted);font-size:13px;margin-bottom:18px;letter-spacing:.02em}
  .music-browse-row{display:flex;align-items:center;gap:20px;justify-content:space-between}.music-browse-row>div{min-width:0;flex:1}
  .music-current{display:flex;align-items:baseline;gap:12px;font-size:15px;font-weight:500}.music-current [data-record-current]{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .music-count{font:10px ui-monospace,SFMono-Regular,monospace;white-space:nowrap;color:var(--music-muted)}
  .music-artist{font-size:12px;color:var(--music-muted);margin-top:3px}.music-hint{margin-top:12px;text-align:center;font-size:11px;color:var(--music-muted)}
  .music-take{display:flex;align-items:center;gap:10px;flex:none;min-height:44px;padding:0 17px;border:0;border-radius:999px;background:var(--music-ink);color:var(--music-paper);font-size:13px;cursor:pointer}
  .music-take span{font-size:18px}.music-take:active{transform:scale(.96)}
  .music-detail-deck{position:absolute;left:50%;top:var(--record-detail-top,60%);z-index:4;width:min(390px,calc(100% - 40px));transform:translateX(-50%);text-align:center;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 120ms,visibility 0s 120ms}
  .music-page[data-music-view=detail] .music-detail-deck{opacity:1;visibility:visible;pointer-events:auto;transition:opacity 200ms 120ms,visibility 0s}
  .music-page[data-music-view=detail] .music-browse{opacity:0;visibility:hidden;pointer-events:none}
  .music-detail-panel[hidden]{display:none!important}.music-detail-panel h2{font-size:22px;font-weight:600;letter-spacing:-.025em;line-height:1.2;text-wrap:balance}
  .music-detail-artist{font-size:14px;margin-top:7px;color:var(--music-muted)}.music-detail-album{font-size:11px;line-height:1.5;margin-top:5px;color:var(--music-muted);text-wrap:balance}
  .music-actions{display:flex;justify-content:center;align-items:center;gap:20px;margin-top:20px}
  .music-preview-button{display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 18px;border:0;border-radius:999px;background:var(--music-ink);color:var(--music-paper);font-size:13px;cursor:pointer}
  .music-service{display:flex;align-items:center;gap:7px;min-height:44px;font-size:12px;color:var(--music-ink);text-decoration:none}.music-service :global(svg){width:16px;height:16px}
  .music-blocked{display:none;margin-top:10px;font-size:11px;color:var(--music-muted)}.music-detail-panel[data-music-state=blocked] .music-blocked{display:block}
  .music-eq{display:none;align-items:center;justify-content:center;gap:2px;width:16px;height:16px}.music-eq i{display:block;width:2px;height:12px;background:currentColor;transform-origin:50% 100%;animation:music-bars 650ms ease-in-out infinite alternate}.music-eq i:nth-child(2){animation-delay:-350ms}.music-eq i:nth-child(3){animation-delay:-180ms}
  .music-detail-panel[data-music-state=playing] .music-play-icon{display:none}.music-detail-panel[data-music-state=playing] .music-eq{display:flex}
  @keyframes music-bars{from{transform:scaleY(.25)}to{transform:scaleY(1)}}
  .music-page.is-closing :is(.music-header,.music-browse,.music-detail-deck){opacity:0;pointer-events:none}
  .music-page[data-detail-layout=side] .music-detail-deck{top:52%;left:62%;width:min(340px,34%);transform:translateY(-50%);text-align:left}
  .music-page[data-detail-layout=side] .music-actions{justify-content:flex-start}
  .music-page :is(button,a):focus-visible{outline:2px solid var(--music-accent);outline-offset:4px}
  @media(max-width:560px){.music-header{padding:20px 14px}.music-browse{bottom:max(23px,env(safe-area-inset-bottom))}.music-detail-panel h2{font-size:20px}.music-quote{font-size:12px}}
  @media(max-height:560px){.music-quote{display:none}.music-browse{bottom:15px}.music-hint{margin-top:5px}.music-header{padding-top:15px}.music-detail-panel h2{font-size:18px}.music-actions{margin-top:12px}}
  @media(prefers-reduced-motion:reduce){.music-page::before,.music-header,.music-browse,.music-detail-deck{transition:none}.music-eq i{animation:none}}
</style>
<script>
  import { mountMusicPage } from "../scripts/music-rack-page";
  document.querySelectorAll<HTMLElement>("[data-record-page]").forEach(mountMusicPage);
</script>
