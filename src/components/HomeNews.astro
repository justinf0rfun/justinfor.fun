---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const latest = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
)[0];
---

{latest && (
  <aside class="home-news" data-home-news data-open aria-label="Latest thought">
    <a class="home-news-link" href={`/thoughts/${latest.id}`} aria-label={`New thought: ${latest.data.title}`}>
      <span class="home-news-content home-news-badge">New</span>
      <span class="home-news-content home-news-title">{latest.data.title}</span>
      <span class="home-news-content home-news-arrow" aria-hidden="true"><Icon name="ph:arrow-right" /></span>
    </a>
  </aside>
)}

{latest && <script is:inline>
  (() => {
    const news = document.currentScript.previousElementSibling;
    news.style.width = "32px";
    news.style.opacity = "0";
    news.inert = true;
    news.removeAttribute("data-open");
    news.setAttribute("aria-hidden", "true");
  })();
</script>}

<style>
  .home-news {
    position: fixed;
    z-index: 20;
    top: calc(1rem + env(safe-area-inset-top, 0px));
    left: 50%;
    display: flex;
    height: 2rem;
    width: max-content;
    max-width: calc(100vw - 2rem);
    align-items: center;
    overflow: hidden;
    border-radius: 999px;
    color: #fcfcfc;
    background: #1c6eeb;
    transform: translateX(-50%);
    box-shadow: 0 1px 3px -1px rgb(0 0 0 / 4%), 0 8px 24px -6px rgb(0 0 0 / 7%);
  }

  .home-news-link {
    display: flex;
    height: 100%;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 0.375rem;
    white-space: nowrap;
  }

  .home-news-badge {
    display: flex;
    height: 1.25rem;
    flex: none;
    align-items: center;
    padding-inline: 0.5rem;
    border-radius: 999px;
    color: #1c6eeb;
    background: #fcfcfc;
    font-size: 0.75rem;
  }

  .home-news-title { min-width: 0; overflow: hidden; font-size: 0.8125rem; text-overflow: ellipsis; }
  .home-news-arrow { display: grid; width: 1.25rem; height: 1.25rem; flex: none; place-items: center; border-radius: 50%; }
  .home-news-arrow :global(svg) { width: 0.875rem; height: 0.875rem; }
  .home-news:has(:focus-visible) { outline: 2px solid #1c6eeb; outline-offset: 3px; }
  .home-news-link:focus-visible { outline: none; }

  .home-news-content {
    opacity: 0;
    filter: blur(4px);
    translate: -4px 0;
    transition: opacity 150ms ease, filter 300ms cubic-bezier(0.16, 1, 0.3, 1), translate 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .home-news[data-open] .home-news-content {
    opacity: 1;
    filter: blur(0);
    translate: 0 0;
    transition: opacity 400ms ease, filter 550ms cubic-bezier(0.16, 1, 0.3, 1), translate 550ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .home-news[data-open] .home-news-title { transition-delay: 50ms; }
  .home-news[data-open] .home-news-arrow { transition-delay: 100ms; }

  @media (hover: hover) and (pointer: fine) {
    .home-news-link:hover .home-news-arrow { background: rgb(252 252 252 / 18%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-news[data-home-news] .home-news-content { transition: none; }
  }
</style>

<script>
  import { mountHomeNews } from "../scripts/home-news";
  const news = document.querySelector<HTMLElement>("[data-home-news]");
  if (news) mountHomeNews(news);
</script>
